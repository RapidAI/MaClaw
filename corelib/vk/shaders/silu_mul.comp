#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

// Fused SiLU(gate) * up.
//
// The gate/up matmul writes them concatenated per row: [0,F) = gate,
// [F,2F) = up. This kernel collapses that to one [M,F] tensor.
//
// Dispatch: grid = (ceil(F/256), M rows), 256 threads. Using WorkGroupID.y for
// the row keeps each workgroup inside one row, so the dispatch covers M*F
// exactly (a flat GlobalInvocationID would restart at 0 per workgroup in x).

layout(local_size_x = 256) in;

struct SiluParams { int M; int F; int ld; };

layout(std430, binding = 0) readonly buffer BufA { float a[]; };
layout(std430, binding = 1) buffer BufB { float b[]; };
layout(std430, binding = 2) readonly buffer Wq { int8_t wq[]; };
layout(std430, binding = 3) readonly buffer Ws { float ws[]; };
layout(std430, binding = 4) readonly buffer Nrm { float nrm[]; };
layout(std430, binding = 5) readonly buffer Aux { float aux[]; };
layout(std430, binding = 6) readonly buffer Aux2 { float aux2[]; };
layout(std430, binding = 7) readonly buffer Pos { int positions[]; };

layout(push_constant) uniform PC { SiluParams p; } pc;

// Schraudolph exp, matching tensor.fastExp on the CPU path.
float fast_exp(float x) {
    if (x < -88.0) return 0.0;
    if (x > 88.0) return 3.4028235e38;
    return intBitsToFloat(int(12102203.0 * x + 1065292415.0));
}

void main() {
    int m = int(gl_WorkGroupID.y);
    int f = int(gl_WorkGroupID.x) * 256 + int(gl_LocalInvocationID.x);
    if (m >= pc.p.M || f >= pc.p.F) return;
    int base = m * pc.p.ld;
    float gv = a[base + f];
    float uv = a[base + pc.p.F + f];
    b[m * pc.p.F + f] = gv / (1.0 + fast_exp(-gv)) * uv;
}
