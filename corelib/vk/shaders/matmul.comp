#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

// Q8_0 tiled matmul: C[M,N] (=|+=) A[M,K] . W[N,K]^T.
//
// Weights are repacked at load into one int8 blob (row n of a matrix is K
// contiguous int8 values) plus one f32 scale blob (row n owns K/32 scales, one
// per 32-wide quantisation block).
//
// Tile: 32x32 outputs per workgroup, 256 threads (16x16), each thread owning
// 2 rows x 2 columns.
//
// Weight traffic is (M/32) x the weight size because each workgroup re-reads
// its weight slice per 32-row M-tile. Packing several M-tiles into one
// workgroup (reusing the dequantised W tile) was measured on RDNA3 and is
// SLOWER: the extra accumulators and the second barrier per K block cost more
// than the saved bandwidth (512 rows: 428 ms with one tile vs 780 ms with two).
// K advances one quantisation block (32 values) per step, so the dequant scale
// is a single scalar per weight row per step.
//
// Shared memory is padded by one float per row: without the pad the row stride
// is 128 bytes = every bank, so all lanes reading column k collide (32-way
// conflict, measured ~4.6x slower end to end on RDNA3).

layout(local_size_x = 16) in;
layout(local_size_y = 16) in;

struct MMParams {
    int M;      // offset 0
    int N;      // offset 4
    int K;      // offset 8
    int accum;  // offset 12
    int lda;    // offset 16
    int ldc;    // offset 20
    int wOff;   // offset 24: first int8 element of this matrix in the blob
    int sOff;   // offset 28: first f32 scale of this matrix in the blob
};

layout(std430, binding = 0) readonly buffer BufA { float a[]; };
layout(std430, binding = 1) buffer BufB { float b[]; };
layout(std430, binding = 2) readonly buffer Wq { uint wq4[]; };
layout(std430, binding = 3) readonly buffer Ws { float ws[]; };
layout(std430, binding = 4) readonly buffer Nrm { float nrm[]; };
layout(std430, binding = 5) readonly buffer Aux { float aux[]; };
layout(std430, binding = 6) readonly buffer Aux2 { float aux2[]; };
layout(std430, binding = 7) readonly buffer Pos { int positions[]; };

layout(push_constant) uniform PC { MMParams mm; } pc;

#define TM 32   // output rows per M-tile
#define TN 32   // output columns per workgroup
#define TK 32   // K values per step (one quantisation block)
#define MT 1    // M-tiles per workgroup (weight traffic / MT)

shared float As[TM][TK + 1];
shared float Wt[TN][TK + 1];

void main() {
    uint lx = gl_LocalInvocationID.x;   // 0..15
    uint ly = gl_LocalInvocationID.y;   // 0..15
    uint t = ly * 16u + lx;
    int row0 = int(gl_WorkGroupID.y) * TM;
    int col0 = int(gl_WorkGroupID.x) * TN;
    int nb = pc.mm.K / 32;

    // Tile staging indices: one float4 of A and one uint (4 int8) of W per thread.
    int aRow = int(t) / 8;
    int aK = (int(t) % 8) * 4;
    int wRow = int(t) / 8;
    int wK = (int(t) % 8) * 4;
    int wWord = pc.mm.wOff / 4;

    int outR = int(ly) * 2;
    int outC = int(lx) * 2;
    float acc[2][2];
    for (int r = 0; r < 2; r++)
        for (int c = 0; c < 2; c++) acc[r][c] = 0.0;

    int gn = col0 + wRow;

    for (int blk = 0; blk < nb; blk++) {
        // W tile: 32 columns x 32 K, dequantised once for every M-tile.
        if (gn < pc.mm.N) {
            int wi = wWord + (gn * pc.mm.K + blk * 32 + wK) / 4;
            uint p0 = wq4[wi];
            float d = ws[pc.mm.sOff + gn * nb + blk];
            Wt[wRow][wK + 0] = float(int8_t(p0 & 0xFFu)) * d;
            Wt[wRow][wK + 1] = float(int8_t((p0 >> 8) & 0xFFu)) * d;
            Wt[wRow][wK + 2] = float(int8_t((p0 >> 16) & 0xFFu)) * d;
            Wt[wRow][wK + 3] = float(int8_t((p0 >> 24) & 0xFFu)) * d;
        } else {
            Wt[wRow][wK + 0] = 0.0;
            Wt[wRow][wK + 1] = 0.0;
            Wt[wRow][wK + 2] = 0.0;
            Wt[wRow][wK + 3] = 0.0;
        }

        {
            int gm = row0 + aRow;
            int off = gm * pc.mm.lda + blk * 32 + aK;
            if (gm < pc.mm.M) {
                As[aRow][aK + 0] = a[off + 0];
                As[aRow][aK + 1] = a[off + 1];
                As[aRow][aK + 2] = a[off + 2];
                As[aRow][aK + 3] = a[off + 3];
            } else {
                As[aRow][aK + 0] = 0.0;
                As[aRow][aK + 1] = 0.0;
                As[aRow][aK + 2] = 0.0;
                As[aRow][aK + 3] = 0.0;
            }
            barrier();

            for (int k = 0; k < TK; k++) {
                float a0 = As[outR + 0][k];
                float a1 = As[outR + 1][k];
                float w0 = Wt[outC + 0][k];
                float w1 = Wt[outC + 1][k];
                acc[0][0] += a0 * w0;
                acc[0][1] += a0 * w1;
                acc[1][0] += a1 * w0;
                acc[1][1] += a1 * w1;
            }
            barrier();
        }
    }

    for (int r = 0; r < 2; r++) {
        int gm = row0 + outR + r;
        if (gm >= pc.mm.M) continue;
        for (int c = 0; c < 2; c++) {
            int gn2 = col0 + outC + c;
            if (gn2 >= pc.mm.N) continue;
            int idx = gm * pc.mm.ldc + gn2;
            if (pc.mm.accum == 1) b[idx] += acc[r][c]; else b[idx] = acc[r][c];
        }
    }
}
