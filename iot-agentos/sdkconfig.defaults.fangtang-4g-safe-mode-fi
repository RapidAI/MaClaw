# Dedicated non-release Fangtang-4G SAFE_MODE proof artifact.
# It verifies that the shared safe-mode bridge remains below all cellular and
# gateway startup, not that it retries or restarts a modem fault domain.
CONFIG_MACLAW_TEST_BUILD=y
CONFIG_MACLAW_SAFE_MODE_TEST_LOCAL_READY_FAILURE=y

# Keep this fault-injection image capacity-equivalent to the production
# Fangtang profile. ESP-IDF's bare defaults otherwise select Debug plus
# enabled assertions for a fresh test build, inflating the app until the
# 0x3a0000 factory partition has only an unsafe diagnostic margin.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# CONFIG_COMPILER_OPTIMIZATION_DEBUG is not set
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
# CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE is not set
