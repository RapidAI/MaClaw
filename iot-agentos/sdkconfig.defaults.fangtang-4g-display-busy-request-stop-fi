# Dedicated non-release test for STOP queued behind a Display Task request
# already in execution.  The rollback deadline is 6000 ms, so the request
# remains busy long enough to prove that STOP cannot pre-empt it.
CONFIG_MACLAW_TEST_BUILD=y
CONFIG_MACLAW_DISPLAY_SERVICE_FAIL_AFTER_INIT=y
CONFIG_MACLAW_DISPLAY_SERVICE_REQUEST_DELAY_ONCE_MS=7000
CONFIG_MACLAW_DISPLAY_SERVICE_SECONDARY_STOP_DELAY_MS=10
CONFIG_MACLAW_DISPLAY_SERVICE_SECONDARY_STOP_TIMEOUT_MS=9000
