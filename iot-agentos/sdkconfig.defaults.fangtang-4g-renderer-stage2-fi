# Dedicated non-release configuration for the compact renderer's audio
# acquisition boundary. It keeps the Fangtang profile-private driver closure
# and fails only after input and direct-I2S audio ownership have been obtained.
CONFIG_MACLAW_TEST_BUILD=y
CONFIG_MACLAW_COMPACT_RENDERER_FAILURE_INITIALIZATION=y
CONFIG_MACLAW_COMPACT_RENDERER_FAILURE_STAGE=2
