# Dedicated non-release configuration for Display Service STOP timeout HIL.
# The rollback deadline is 6000 ms. Delay terminal STOP long enough to prove
# that timeout retains the boot-lifetime STOP record until the task exits.
CONFIG_MACLAW_TEST_BUILD=y
CONFIG_MACLAW_DISPLAY_SERVICE_FAIL_AFTER_INIT=y
CONFIG_MACLAW_DISPLAY_SERVICE_STOP_DELAY_MS=7000
