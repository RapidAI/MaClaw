# MaClaw Plank theme (MaClaw-Light). Self-made, no third-party assets.
[PlankTheme]
TopRoundness=10
BottomRoundness=10
LineWidth=1
OuterStrokeColor=0;;0;;0;;40
FillStartColor=255;;255;;255;;175
FillEndColor=245;;246;;250;;160
InnerStrokeColor=255;;255;;255;;120

[PlankDockTheme]
HorizPadding=4
TopPadding=1
BottomPadding=2
ItemPadding=6
IndicatorSize=4
IconShadowSize=1
UrgentBounceHeight=0
LaunchBounceHeight=0
FadeOpacity=1
ClickTime=120
UrgentBounceTime=0
LaunchBounceTime=0
ActiveTime=150
SlideTime=150
FadeTime=150
HideTime=150
GlowSize=20
GlowTime=0
GlowPulseTime=2000
UrgentHueShift=150
ItemMoveTime=150
CascadeHide=true
