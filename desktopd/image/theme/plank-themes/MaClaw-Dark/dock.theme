# MaClaw Plank theme (MaClaw-Dark). Self-made, no third-party assets.
[PlankTheme]
TopRoundness=14
BottomRoundness=14
LineWidth=1
OuterStrokeColor=0;;0;;0;;120
FillStartColor=40;;46;;58;;200
FillEndColor=28;;32;;42;;200
InnerStrokeColor=255;;255;;255;;25

[PlankDockTheme]
HorizPadding=6
TopPadding=4
BottomPadding=6
ItemPadding=8
IndicatorSize=4
IconShadowSize=1
UrgentBounceHeight=0
LaunchBounceHeight=0
FadeOpacity=1
ClickTime=120
UrgentBounceTime=0
LaunchBounceTime=0
ActiveTime=150
SlideTime=150
FadeTime=150
HideTime=150
GlowSize=20
GlowTime=0
GlowPulseTime=2000
UrgentHueShift=150
ItemMoveTime=150
CascadeHide=true
