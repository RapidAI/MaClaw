# nginx vhost for the desktopd API domain (Hub's desktop service base_url).
# Production uses dockerd.mypapers.top; replace the server_name and certificate
# paths. Only the desktopd API on 127.0.0.1:18081 is proxied. The per-user
# browser (CDP) and screen (noVNC) gate ports are published by Docker and
# guarded by their own Bearer token; never proxy them through this domain.
server {
    listen 443 ssl http2;
    server_name dockerd.example.com;

    ssl_certificate /path/to/example.com.wildcard.cert;
    ssl_certificate_key /path/to/example.com.wildcard.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Screenshots (PNG) come back through this proxy.
    client_max_body_size 32m;

    location / {
        proxy_pass http://127.0.0.1:18081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
        # Opening a desktop can recreate a container and start XFCE.
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_connect_timeout 30s;
        proxy_buffering off;
        proxy_request_buffering off;
    }
}

server {
    listen 80;
    server_name dockerd.example.com;
    return 301 https://$host$request_uri;
}
