# desktopd environment (/data/soft/maclaw_desktopd/.env, mode 600).
# remote_deploy.sh creates the real file on the first deploy with a generated
# DESKTOPD_TOKEN; never commit the real file. Placeholders below.

# Listen on loopback only; the public name is an nginx proxy to this address
# (see nginx-dockerd.conf.example).
DESKTOPD_ADDR=127.0.0.1:18081
# Bearer key for /v1/*; Hub's desktop service access_token.
DESKTOPD_TOKEN=<generated-by-remote_deploy.sh>
# Public name of this API. When DESKTOPD_PUBLIC_URL is empty, CDP and noVNC
# URLs are https://<this host>/v1/desktops/tunnel/... nginx proxies that path
# to DESKTOPD_ADDR. This is not a raw Docker port.
DESKTOPD_ADVERTISE_HOST=dockerd.example.com
# Optional base for those tunnel URLs. Empty uses https://$DESKTOPD_ADVERTISE_HOST.
#DESKTOPD_PUBLIC_URL=https://dockerd.example.com
# Host address Docker binds the browser and screen ports to. Default
# 127.0.0.1. An IPv4 loopback or private address. 0.0.0.0 is rejected.
# Existing containers keep their previous publish until something else
# recreates them. Changing this value does not docker rm by itself.
#DESKTOPD_PUBLISH_BIND=127.0.0.1
# Admin panel state (extra API keys, panel admin). "off" disables the panel.
DESKTOPD_STATE_DIR=/data/soft/maclaw_desktopd/state
# Optional: stop desktops idle longer than this. The reaper confirms the
# container is actually down and falls back to `docker stop` when the
# in-container supervisor stop leaves it running.
#DESKTOPD_MAX_IDLE=24h

# Rotating log file, relative to the process working directory unless absolute.
# Empty means logs/desktopd.log. "off" keeps logging on stderr only (the journal
# under systemd). systemd 237 cannot persist this file via StandardOutput=append:.
#DESKTOPD_LOG_FILE=logs/desktopd.log
#DESKTOPD_LOG_MAX_BYTES=32MiB
#DESKTOPD_LOG_MAX_FILES=5
# Mirror each line to stderr as well, so journalctl still shows it. 0 disables.
#DESKTOPD_LOG_STDERR=1

# Domain suffixes the egress proxy dials directly instead of through
# DESKTOPD_UPSTREAM_PROXY. Empty uses the built-in default (xiaohongshu.com,
# xhscdn.com), which time out via the overseas relay. "off" sends everything
# upstream. An explicit list replaces the default.
#DESKTOPD_PROXY_DIRECT=xiaohongshu.com,xhscdn.com
# Optional: allow the one-time panel setup from a non-loopback address.
#DESKTOPD_ALLOW_REMOTE_SETUP=1

# Where a missing maclaw-gui:2 comes from. Default (unset or empty):
# ghcr.io/rapidai/maclaw-gui:2. desktopd pulls it in the background at startup
# and on demand, checks the image contract, and tags it maclaw-gui:2. A local
# maclaw-gui:2 that already exists is never pulled over or replaced.
#   off                                      never pull (build on the host)
#   ghcr.io/rapidai/maclaw-gui@sha256:<digest>   pin the content
#   maclaw-gui:2=<ref>,maclaw-gui:3=<ref>        several local names
#DESKTOPD_IMAGE_SOURCE=ghcr.io/rapidai/maclaw-gui:2
#DESKTOPD_IMAGE_PULL_TIMEOUT=30m
