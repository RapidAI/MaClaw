_ {2} q _ {m}, \\dots , p _ {n} q _ {1}, \\dots , p _ {n} q _ {m}) \\\\ & = H (p _ {1}, p _ {2}, \\dots , p _ {n}) + H (q _ {1}, q _ {2}, \\dots , q _ {m}) \\end{array}"}, {"type": "text", "index": 5, "bbox": [0.069, 0.293, 0.167, 0.31], "content": [{"type": "text", "content": "这是因为"}]}, {"type": "equation", "index": 6, "bbox": [0.178, 0.32, 0.824, 0.519], "content": "\\begin{array}{l} H _ {n m} (p _ {1} q _ {1}, p _ {1} q _ {2}, \\dots , p _ {1} q _ {m}, p _ {2} q _ {1}, \\dots , p _ {2} q _ {m}, \\dots , p _ {n} q _ {1}, \\dots , p _ {n} q _ {m}) \\\\ = - \\sum_ {i = 1} ^ {n} \\sum_ {j = 1} ^ {m} p _ {i} q _ {j} \\log p _ {i} q _ {j} = - \\sum_ {i = 1} ^ {n} \\sum_ {j = 1} ^ {m} p _ {i} q _ {j} \\log p _ {i} - \\sum_ {i = 1} ^ {n} \\sum_ {j = 1} ^ {m} p _ {i} q _ {j} \\log q _ {j} \\\\ = - \\sum_ {j = 1} ^ {m} q _ {j} \\left(\\sum_ {i = 1} ^ {n} p _ {i} \\log p _ {i}\\right) - \\sum_ {i = 1} ^ {n} p _ {i} \\left(\\sum_ {j = 1} ^ {m} q _ {j} \\log q _ {j}\\right) \\\\ = - \\sum_ {i = 1} ^ {n} p _ {i} \\log p _ {i} - \\sum_ {j = 1} ^ {m} q _ {j} \\log q _ {j} \\\\ = H (p _ {1}, p _ {2}, \\dots , p _ {n}) + H (q _ {1}, q _ {2}, \\dots , q _ {m}) \\end{array}"}, {"type": "text", "index": 7, "bbox": [0.116, 0.527, 0.233, 0.544], "content": [{"type": "text", "content": "(8)上凸性。"}]}, {"type": "text", "index": 8, "bbox": [0.113, 0.554, 0.597, 0.572], "content": [{"type": "text", "content": "熵函数 "}, {"type": "equation_inline", "content": "H(p)"}, {"type": "text", "content": " 是随机矢量 "}, {"type": "equation_inline", "content": "\\pmb{p}"}, {"type": "text", "content": " 的严格上凸函数。即"}]}, {"type": "equation", "index": 9, "bbox": [0.28, 0.581, 0.722, 0.599], "content": "\\lambda H (\\boldsymbol {p}) + (1 - \\lambda) H (\\boldsymbol {q}) \\leqslant H (\\lambda \\boldsymbol {p} + (1 - \\lambda) \\boldsymbol {q})"}, {"type": "text", "index": 10, "bbox": [0.07, 0.607, 0.458, 0.626], "content": [{"type": "text", "content": "要说明上式成立,需要分如下两步证明。"}]}, {"type": "text", "index": 11, "bbox": [0.114, 0.634, 0.657, 0.652], "content": [{"type": "text", "content": "① 设区域 "}, {"type": "equation_inline", "content": "D"}, {"type": "text", "content": " 是所有随机矢量组成的集合, 则 "}, {"type": "equation_inline", "content": "D"}, {"type": "text", "content": " 是凸域。"}]}, {"type": "text", "index": 12, "bbox": [0.072, 0.662, 0.935, 0.708], "content": [{"type": "text", "content": "假定  "}, {"type": "equation_inline", "content": "\\boldsymbol{p}=(p_{1},p_{2},\\cdots,p_{n}),\\boldsymbol{q}=(q_{1},q_{2},\\cdots,q_{n})"}, {"type": "text", "content": "  是 D 中的任意两个概率矢量。那么， "}, {"type": "equation_inline", "content": "\\forall0\\leqslant\\lambda\\leqslant1"}, {"type": "text", "content": " ，有  "}, {"type": "equation_inline", "content": "\\lambda\\boldsymbol{p}+(1-\\lambda)\\boldsymbol{q}\\in D"}, {"type": "text", "content": " 。这是因为  "}, {"type": "equation_inline", "content": "\\lambda\\boldsymbol{p}+(1-\\lambda)\\boldsymbol{q}"}, {"type": "text", "content": "  的各分量之和，即"}]}, {"type": "equation", "index": 13, "bbox": [0.182, 0.717, 0.827, 0.756], "content": "\\sum_ {i = 1} ^ {n} [ \\lambda p _ {i} + (1 - \\lambda) q _ {i} ] = \\lambda \\sum_ {i = 1} ^ {n} p _ {i} + (1 - \\lambda) \\sum_ {i = 1} ^ {n} q _ {i} = \\lambda + (1 - \\lambda) = 1"}, {"type": "text", "index": 14, "bbox": [0.071, 0.759, 0.234, 0.776], "content": [{"type": "text", "content": "所以， "}, {"type": "equation_inline", "content": "D"}, {"type": "text", "content": " 是凸域。"}]}, {"type": "text", "index": 15, "bbox": [0.115, 0.786, 0.381, 0.803], "content": [{"type": "text", "content": "② "}, {"type": "equation_inline", "content": "H(p)"}, {"type": "text", "content": " 是上凸函数，因为"}]}, {"type": "equation", "index": 16, "bbox": [0.279, 0.812, 0.731, 0.931], "content": "\\begin{array}{l} \\lambda H (\\boldsymbol {p}) + (1 - \\lambda) H (\\boldsymbol {q}) - H (\\lambda \\boldsymbol {p} + (1 - \\lambda) \\boldsymbol {q}) \\\\ = \\lambda \\sum_ {i = 1} ^ {n} p _ {i} \\log \\frac {1}{p _ {i}} + (1 - \\lambda) \\sum_ {i = 1} ^ {n} q _ {i} \\log \\frac {1}{q _ {i}} - \\\\ \\sum_ {i = 1} ^ {n} [ \\lambda p _ {i} + (1 - \\lambda) q _ {i} ] \\log \\frac {1}{\\lambda p _ {i} + (1 - \\lambda) q _ {i}} \\end{array}"}]}, {"page_idx": 161, "blocks": [{"type": "header", "index": 0, "bbox": [0.382, 0.065, 0.564, 0.081], "content": [{"type": "text", "content": "第 4 章 信息论基础"}]}, {"type": "page_number", "index": 1, "bbox": [0.836, 0.067, 0.873, 0.08], "content": [{"type": "text", "content": "149"}]}, {"type": "equation", "index": 2, "bbox": [0.166, 0.099, 0.778, 0.267], "content": "\\begin{array}{l} = \\lambda \\sum_ {i = 1} ^ {n} p _ {i} \\log \\frac {\\lambda p _ {i} + (1 - \\lambda) q _ {i}}{p _ {i}} + (1 - \\lambda) \\sum_ {i = 1} ^ {n} q _ {i} \\log \\frac {\\lambda p _ {i} + (1 - \\lambda) q _ {i}}{q _ {i}} \\\\ \\leqslant \\lambda \\log \\sum_ {i = 1} ^ {n} p _ {i} \\frac {\\lambda p _ {i} + (1 - \\lambda) q _ {i}}{p _ {i}} + (1 - \\lambda) \\log \\sum_ {i = 1} ^ {n} q _ {i} \\frac {\\lambda p _ {i} + (1 - \\lambda) q _ {i}}{q _ {i}} \\\\ = \\lambda \\log \\sum_ {i = 1} ^ {n} [ \\lambda p _ {i} + (1 - \\lambda) q _ {i} ] + (1 - \\lambda) \\log \\sum_ {i = 1} ^ {n} [ \\lambda p _ {i} + (1 - \\lambda) q _ {i} ] \\\\ = \\lambda \\log [ \\lambda + (1 - \\lambda) ] + (1 - \\lambda) \\log [ \\lambda + (1 - \\lambda) ] = 0 \\end{array}"}, {"type": "text", "index": 3, "bbox": [0.038, 0.276, 0.908, 0.349], "content": [{"type": "text", "content": "注意,上面证明过程中用到了对数函数的上凸性。由于对数函数是严格上凸的,所以熵函数也是严格上凸函数。由于熵函数是上凸函数,因此,如果存在极值,则必定是最大值。"}]}, {"type": "text", "index": 4, "bbox": [0.086, 0.358, 0.204, 0.375], "content": [{"type": "text", "content": "(9)极值性。"}]}, {"type": "equation", "index": 5, "bbox": [0.269, 0.385, 0.68, 0.404], "content": "H (p _ {1}, \\dots , p _ {n}) \\leqslant H (1 / n, \\dots , 1 / n) = \\log n"}, {"type": "text", "index": 6, "bbox": [0.04, 0.412, 0.908, 0.484], "content": [{"type": "text", "content": "上式等号成立当且仅当  "}, {"type": "equation_inline", "content": "p_{1}=p_{2}=\\cdots=p_{n}=1/n"}, {"type": "text", "content": " 。式中，n 是随机变量 X 的可能取值的个数。极值性表明离散信源中当各消息等概率分布时熵最大，这个性质也被称为最大离散熵定理。"}]}, {"type": "text", "index": 7, "bbox": [0.085, 0.493, 0.285, 0.511], "content": [{"type": "text", "content": "事实上，由定义可得"}]}, {"type": "equation", "index": 8, "bbox": [0.202, 0.519, 0.748, 0.557], "content": "H (p _ {1}, p _ {2}, \\dots , p _ {n}) = \\sum_ {i = 1} ^ {n} p _ {i} \\log \\frac {1}{p _ {i}} \\leqslant \\log \\sum_ {i = 1} ^ {n} p _ {i} \\frac {1}{p _ {i}} = \\log n"}, {"type": "text", "index": 9, "bbox": [0.041, 0.564, 0.907, 0.61], "content": [{"type": "text", "content": "由于熵函数是严格上凸的,所以当且仅当  "}, {"type": "equation_inline", "content": "p_{1}=p_{2}=\\cdots=p_{n}=1/n"}, {"type": "text", "content": "  时,上式等号成立。"}]}, {"type": "text", "index": 10, "bbox": [0.086, 0.618, 0.342, 0.636], "content": [{"type": "text", "content": "考虑如下分布的随机变量"}]}, {"type": "equation", "index": 11, "bbox": [0.364, 0.649, 0.585, 0.696], "content": "\\left[ \\begin{array}{c} X \\\\ p (x) \\end{array} \\right] = \\left[ \\begin{array}{c c} 0 & 1 \\\\ p & 1 - p \\end{array} \\right]"}, {"type": "text", "index": 12, "bbox": [0.042, 0.703, 0.286, 0.721], "content": [{"type": "text", "content": "它的熵简记为 "}, {"type": "equation_inline", "content": "H(p)"}, {"type": "text", "content": " ，则"}]}, {"type": "equation", "index": 13, "bbox": [0.285, 0.731, 0.664, 0.75], "content": "H (\\boldsymbol {p}) = - p \\log p - (1 - p) \\log (1 - p)"}, {"type": "text", "index": 14, "bbox": [0.042, 0.757, 0.306, 0.775], "content": [{"type": "text", "content": "其函数曲线如图 4.5 所示。"}]}, {"type": "text", "index": 15, "bbox": [0.042, 0.785, 0.911, 0.858], "content": [{"type": "text", "content": "从图 4.5 可以看出, 当等概分布时, 熵达到最大值 1 bit, 这时随机变量具有最大的不确定性。当 p = 0 或 1 时, 随机变量的不确定性完全消失, 这与对不确定性的直观认识是一致的。"}]}]}, {"page_idx": 162, "blocks": [{"type": "page_number", "index": 0, "bbox": [0.097, 0.055, 0.135, 0.068], "content": [{"type": "text", "content": "150"}]}, {"type": "header", "index": 1, "bbox": [0.417, 0.053, 0.579, 0.069], "content": [{"type": "text", "content": "信息安全数学基础"}]}, {"type": "chart", "index": 2, "bbox": [0.325, 0.093, 0.677, 0.342], "content": [{"type": "chart_body", "index": 2, "bbox": [0.325, 0.093, 0.677, 0.342], "content": ""}, {"type": "chart_caption", "index": 3, "bbox": [0.392, 0.353, 0.609, 0.37], "content": [{"type": "text", "content": "图4.5 二元熵函数曲线"}]}]}, {"type": "paragraph_title", "index": 4, "bbox": [0.066, 0.411, 0.36, 0.435], "content": [{"type": "text", "content": "4.3 联合熵与条件熵"}], "level": 2}, {"type": "text", "index": 5, "bbox": [0.065, 0.468, 0.934, 0.516], "content": [{"type": "text", "content": "上一节指出,单个随机事件发生的概率的对数的负值称为自信息,如果把单个事件推广为两个事件的联合事件,则联合事件的自信息又被称为联合自信息。"}]}, {"type": "text", "index": 6, "bbox": [0.066, 0.53, 0.934, 0.577], "content": [{"type": "text", "content": "定义 4.6 两个随机事件的联合自信息量定义为这两个事件同时发生的联合概率的对数的负值,简称联合自信息。"}]}, {"type": "text", "index": 7, "bbox": [0.111, 0.585, 0.751, 0.604], "content": [{"type": "text", "content": "设事件 "}, {"type": "equation_inline", "content": "x_{i}, y_{i}"}, {"type": "text", "content": " 的联合概率为 "}, {"type": "equation_inline", "content": "p(x_{i}y_{j})"}, {"type": "text", "content": "，则它们的联合自信息定义为"}]}, {"type": "equation", "index": 8, "bbox": [0.38, 0.612, 0.622, 0.632], "content": "I (x _ {i} y _ {j}) = - \\log p (x _ {i} y _ {j})"}, {"type": "text", "index": 9, "bbox": [0.068, 0.639, 0.934, 0.686], "content": [{"type": "text", "content": "实际上,如果把联合事件 "}, {"type": "equation_inline", "content": "xy"}, {"type": "text", "content": " 视为一个单一事件,那么联合自信息的含义与自信息的含义相同。"}]}, {"type": "text", "index": 10, "bbox": [0.11, 0.701, 0.859, 0.72], "content": [{"type": "text", "content": "例 4.6 已知箱中有 10 个红球, 5 个白球。现从箱中随机地取出一个球。求:"}]}, {"type": "text", "index": 11, "bbox": [0.113, 0.728, 0.611, 0.747], "content": [{"type": "text", "content": "(1) 事件“两个球中有红、白球各一个”的不确定性;"}]}, {"type": "text", "index": 12, "bbox": [0.113, 0.756, 0.555, 0.774], "content": [{"type": "text", "content": "(2) 事件“两个球都是白球”所提供的信息量；"}]}, {"type": "text", "index": 13, "bbox": [0.113, 0.783, 0.858, 0.802], "content": [{"type": "text", "content": "(3) 事件“两个球都是白球”与“两个球都是红球”的发生,哪个事件更难猜测?"}]}, {"type": "text", "index": 14, "bbox": [0.112, 0.817, 0.604, 0.836], "content": [{"type": "text", "content": "解 这三种情况都是计算两个事件的联合自信息。"}]}, {"type": "equation", "index": 15, "bbox": [0.141, 0.844, 0.805, 0.881], "content": "p (1, 1) = \\frac {\\mathrm{C} _ {1 0} ^ {1} \\mathrm{C} _ {5} ^ {1}}{\\mathrm{C} _ {1 5} ^ {2}} = \\frac {5 0}{1 0 5} = \\frac {1 0}{2 1} \\quad I (1, 1) = - \\log \\frac {1 0}{2 1} = 1. 0 7 \\text {bit}"}, {"type": "equation", "index": 16, "bbox": [0.114, 0.89, 0.782, 0.927], "content": "p (0, 2) = \\frac {\\mathrm{C} _ {5} ^ {2}}{\\mathrm{C} _ {1 5} ^ {2}} = \\frac {1 0}{1 0 5} = \\frac {2}{2 1} \\quad I (0, 2) = - \\log \\frac {2}{2 1} = 3. 3 9 \\mathrm{bit}"}]}, {"page_idx": 163, "blocks": [{"type": "header", "index": 0, "bbox": [0.398, 0.06, 0.58, 0.075], "content": [{"type": "text", "content": "第4章 信息论基础"}]}, {"type": "page_number", "index": 1, "bbox": [0.851, 0.061, 0.888, 0.075], "content": [{"type": "text", "content": "151"}]}, {"type": "equation", "index": 2, "bbox": [0.1, 0.094, 0.765, 0.129], "content": "p (2, 0) = \\frac {\\mathrm{C} _ {1 0} ^ {2}}{\\mathrm{C} _ {1 5} ^ {2}} = \\frac {4 5}{1 0 5} = \\frac {9}{2 1} \\quad I (2, 0) = - \\log \\frac {9}{2 1} = 1. 2 2 \\mathrm{bit}"}, {"type": "text", "index": 3, "bbox": [0.1, 0.139, 0.501, 0.158], "content": [{"type": "text", "content": "所以两个球都是白球这个事件更难猜测。"}]}, {"type": "text", "index": 4, "bbox": [0.056, 0.167, 0.923, 0.214], "content": [{"type": "text", "content": "既然两个随机事件的联合概率确定了它们的联合自信息,那么两个随机事件的条件概率给出的信息称为条件自信息。"}]}, {"type": "text", "index": 5, "bbox": [0.054, 0.228, 0.924, 0.304], "content": [{"type": "text", "content": "定义 4.7 两个随机事件的条件自信息定义为在一个事件发生的条件下, 另一个事件发生的概率对数的负值, 简称条件自信息。设事件 "}, {"type": "equation_inline", "content": "y = {b}_{j}"}, {"type": "text", "content": " 发生后, 事件 "}, {"type": "equation_inline", "content": "x = {a}_{i}"}, {"type": "text", "content": " 发生的概率为 "}, {"type": "equation_inline", "content": "p\\left( {{a}_{i} \\mid  {b}_{j}}\\right)"}, {"type": "text", "content": " ,相应的条件自信息定义为"}]}, {"type": "equation", "index": 6, "bbox": [0.35, 0.311, 0.627, 0.331], "content": "I (a _ {i} \\mid b _ {j}) = - \\log p (a _ {i} \\mid b _ {j})"}, {"type": "text", "index": 7, "bbox": [0.055, 0.339, 0.922, 0.386], "content": [{"type": "text", "content": "条件自信息含义与自信息类似,只不过是概率空间有变化。条件自信息的含义包含如下两个方面:"}]}, {"type": "text", "index": 8, "bbox": [0.101, 0.395, 0.692, 0.413], "content": [{"type": "text", "content": "(1) 在事件 "}, {"type": "equation_inline", "content": "y = {b}_{j}"}, {"type": "text", "content": " 给定的条件下,在 "}, {"type": "equation_inline", "content": "x = {a}_{i}"}, {"type": "text", "content": " 发生前的不确定性；"}]}, {"type": "text", "index": 9, "bbox": [0.101, 0.422, 0.781, 0.441], "content": [{"type": "text", "content": "(2) 在事件 "}, {"type": "equation_inline", "content": "y = {b}_{j}"}, {"type": "text", "content": " 给定的条件下,在事件 "}, {"type": "equation_inline", "content": "x = {a}_{i}"}, {"type": "text", "content": " 发生后所得到的信息量。"}]}, {"type": "text", "index": 10, "bbox": [0.1, 0.449, 0.781, 0.468], "content": [{"type": "text", "content": "利用定义容易证明,自信息、条件自信息和联合自信息之间有如下关系"}]}, {"type": "equation", "index": 11, "bbox": [0.346, 0.477, 0.628, 0.497], "content": "I (a _ {i} b _ {j}) = I (a _ {i}) + I (b _ {j} \\mid a _ {i})"}, {"type": "text", "index": 12, "bbox": [0.1, 0.512, 0.874, 0.531], "content": [{"type": "text", "content": "例 4.7 在例 4.6 中,箱里面的球不变,现在从箱中先拿出一球,再拿出一球,求:"}]}, {"type": "text", "index": 13, "bbox": [0.102, 0.54, 0.755, 0.559], "content": [{"type": "text", "content": "(1) 事件“在第一球是红球的条件下,第二个球是白球”的不确定性;"}]}, {"type": "text", "index": 14, "bbox": [0.102, 0.567, 0.799, 0.586], "content": [{"type": "text", "content": "(2) 事件“在第一球是红球的条件下,第二个球是红球”所提供的信息量。"}]}, {"type": "text", "index": 15, "bbox": [0.101, 0.595, 0.591, 0.613], "content": [{"type": "text", "content": "解 这两种情况都是计算随机事件的条件自信息。"}]}, {"type": "equation", "index": 16, "bbox": [0.102, 0.624, 0.919, 0.654], "content": "I (y = \\text {white} \\mid x = \\text {red}) = - \\log p (y = \\text {white} \\mid x = \\text {red}) = - \\log \\frac {5}{1 9} = 1. 9 2 \\text {bit}"}, {"type": "equation", "index": 17, "bbox": [0.102, 0.668, 0.882, 0.699], "content": "I (y = \\text {red} \\mid x = \\text {red}) = - \\log p (y = \\text {red} \\mid x = \\text {red}) = - \\log \\frac {9}{1 9} = 1. 0 8 \\text {bit}"}, {"type": "text", "index": 18, "bbox": [0.057, 0.745, 0.926, 0.819], "content": [{"type": "text", "content": "例 4.8 某地区的居民中有 25% 是 A 型血, A 型血的居民中有 60% 是单眼皮, 而所有居民中单眼皮占总数的一半。假如得知“某单眼皮居民是 A 型血”的消息, 问获得多少信息量?"}]}, {"type": "text", "index": 19, "bbox": [0.1, 0.827, 0.629, 0.846], "content": [{"type": "text", "content": "解 设随机变量 "}, {"type": "equation_inline", "content": "X"}, {"type": "text", "content": " 代表是否 A 型血, 则其概率分布为"}]}, {"type": "equation", "index": 20, "bbox": [0.307, 0.858, 0.675, 0.906], "content": "\\left[ \\begin{array}{l} {X} \\\\ {P (x)} \\end{array} \\right] = \\left[ \\begin{array}{l l} {x _ {1} (\\mathrm{A型})} & {x _ {2} (\\mathrm{非A型})} \\\\ {0. 2 5} & {0. 7 5} \\end{array} \\right]"}, {"type": "text", "index": 21, "bbox": [0.102, 0.914, 0.575, 0.933], "content": [{"type": "text", "content": "设随机变量 "}, {"type": "equation_inline", "content": "Y"}, {"type": "text", "content": " 代表是否单眼皮, 则其概率分布为"}]}]}, {"page_idx": 164, "blocks": [{"type": "page_number", "index": 0, "bbox": [0.096, 0.056, 0.133, 0.069], "content": [{"type": "text", "content": "152"}]}, {"type": "header", "index": 1, "bbox": [0.416, 0.054, 0.578, 0.07], "content": [{"type": "text", "content": "信息安全数学基础"}]}, {"type": "equation", "index": 2, "bbox": [0.294, 0.092, 0.698, 0.141], "content": "\\left[ \\begin{array}{c} {{Y}} \\\\ {{P (y)}} \\end{array} \\right] = \\left[ \\begin{array}{c c} {{y _ {1} (\\mathrm{单眼皮})}} & {{x _ {2} (\\mathrm{非单眼皮})}} \\\\ {{0. 5}} & {{0. 5}} \\end{array} \\right]"}, {"type": "text", "index": 3, "bbox": [0.064, 0.148, 0.932, 0.194], "content": [{"type": "text", "content": "A型血的居民中是单眼皮的概率即  "}, {"type": "equation_inline", "content": "p(y_{1}/x_{1}) = 0.60"}, {"type": "text", "content": " ，所以得知某单眼皮居民是 A 型血的信息量为"}]}, {"type": "equation", "index": 4, "bbox": [0.091, 0.191, 0.904, 0.227], "content": "I (x _ {1} / y _ {1}) = - \\log p (x _ {1} / y _ {1}) = - \\log \\frac {p (x _ {1}) p (y _ {1} / x _ {1})}{p (y _ {1})} = - \\log \\frac {0 . 2 5 \\times 0 . 6}{0 . 5} = 1. 7 3 \\text {bit}"}, {"type": "text", "index": 5, "bbox": [0.063, 0.249, 0.932, 0.324], "content": [{"type": "text", "content": "单个随机事件集合用一维随机变量来表示,一维随机变量的平均不确定性可以用信息熵来确定;同理,两个随机事件集合可以用二维随机变量来表示,二维随机变量的平均不确定性可以推广为联合熵。"}]}, {"type": "text", "index": 6, "bbox": [0.108, 0.339, 0.583, 0.357], "content": [{"type": "text", "content": "定义4.8 设二维随机变量 "}, {"type": "equation_inline", "content": "(X,Y)"}, {"type": "text", "content": " 的概率空间为"}]}, {"type": "equation", "index": 7, "bbox": [0.14, 0.367, 0.854, 0.387], "content": "p (x _ {i} y _ {j}) = p \\{X = x _ {i}, Y = y _ {j} \\}, \\quad x = x _ {1}, x _ {2}, \\dots , x _ {n}, \\quad y = y _ {1}, y _ {2}, \\dots , y _ {m}"}, {"type": "text", "index": 8, "bbox": [0.064, 0.399, 0.932, 0.485], "content": [{"type": "text", "content": "其中， "}, {"type": "equation_inline", "content": "p(x_{i}y_{j})"}, {"type": "text", "content": "  满足概率空间的非负性和完备性条件: "}, {"type": "equation_inline", "content": "0 \\leqslant p(x_{i}y_{j}) \\leqslant 1, \\sum_{i=1}^{m} \\sum_{j=1}^{n} p(x_{i}y_{j}) = 1"}, {"type": "text", "content": " 。则二维随机变量(X,Y)的联合熵 H(XY)定义为联合自信息 I(XY)在二维随机变量(X,Y)的联合概率空间上的数学期望，它是二维随机变量(X,Y)的平均不确定性的度量，即"}]}, {"type": "equation", "index": 9, "bbox": [0.234, 0.495, 0.757, 0.535], "content": "H (X Y) = E [ I (X Y) ] = - \\sum_ {j = 1} ^ {m} \\sum_ {i = 1} ^ {n} p (x _ {i} y _ {j}) \\log p (x _ {i} y _ {j})"}, {"type": "text", "index": 10, "bbox": [0.109, 0.544, 0.482, 0.563], "content": [{"type": "text", "content": "例 4.9 计算下列事件的联合自信息:"}]}, {"type": "text", "index": 11, "bbox": [0.066, 0.572, 0.932, 0.618], "content": [{"type": "text", "content": "(1) 英文字母中 e 出现的概率为 0.123, z 出现的概率为 0.0008, 分别计算它们的自信息量。假定前后字母出现是互相独立的, 计算“ez”的联合自信息。"}]}, {"type": "text", "index": 12, "bbox": [0.068, 0.626, 0.932, 0.672], "content": [{"type": "text", "content": "(2) 4 个人抓阄, 设 "}, {"type": "equation_inline", "content": "x_{1}"}, {"type": "text", "content": " 表示第 1 个人没抓到, "}, {"type": "equation_inline", "content": "y_{1}"}, {"type": "text", "content": " 表示第 2 个人没抓到, 计算 "}, {"type": "equation_inline", "content": "x_{1} y_{1}"}, {"type": "text", "content": " 的联合自信息。"}]}, {"type": "text", "index": 13, "bbox": [0.066, 0.681, 0.934, 0.728], "content": [{"type": "text", "content": "(3) 在上一问基础上, 设 "}, {"type": "equation_inline", "content": "x_0"}, {"type": "text", "content": " 表示第 1 个人抓到, "}, {"type": "equation_inline", "content": "y_0"}, {"type": "text", "content": " 表示第 2 个人抓到, "}, {"type": "equation_inline", "content": "X"}, {"type": "text", "content": " 表示第一个人的抓阄情况, "}, {"type": "equation_inline", "content": "Y"}, {"type": "text", "content": " 表示第二个人的抓阄情况, 计算 "}, {"type": "equation_inline", "content": "XY"}, {"type": "text", "content": " 的联合熵。"}]}, {"type": "text", "index": 14, "bbox": [0.111, 0.743, 0.145, 0.761], "content": [{"type": "text", "content": "解"}]}, {"type": "text", "index": 15, "bbox": [0.104, 0.77, 0.897, 0.789], "content": [{"type": "text", "content": "(1) 由于前后字母出现是互相独立的, 故“ez”出现的概率为 "}, {"type": "equation_inline", "content": "0.123 \\times 0.0008"}, {"type": "text", "content": ", 所以"}]}, {"type": "equation", "index": 16, "bbox": [0.182, 0.797, 0.821, 0.816], "content": "I (\\mathrm{ez}) = - \\log (0. 1 2 3 \\times 0. 0 0 0 8) = - \\log (0. 0 0 0 0 9 8) = 1 3. 3 1 \\text {bit}"}, {"type": "text", "index": 17, "bbox": [0.067, 0.825, 0.669, 0.843], "content": [{"type": "text", "content": "即两个独立事件的联合自信息等于两个事件各自自信息之和。"}]}, {"type": "text", "index": 18, "bbox": [0.112, 0.852, 0.927, 0.871], "content": [{"type": "text", "content": "(2) 这两个人都没有抓到的概率为 "}, {"type": "equation_inline", "content": "p\\left( {{x}_{1}{y}_{1}}\\right)  = 3/4 \\times  2/3 = 1/2"}, {"type": "text", "content": " ,所以联合自信息为"}]}, {"type": "equation", "index": 19, "bbox": [0.358, 0.88, 0.646, 0.898], "content": "I (x _ {1} y _ {1}) = - \\log 1 / 2 = 1 \\text {bit}"}, {"type": "text", "index": 20, "bbox": [0.066, 0.907, 0.759, 0.926], "content": [{"type": "text", "content": "再计算 "}, {"type": "equation_inline", "content": "x_{1}, y_{1}"}, {"type": "text", "content": " 各自的自信息 "}, {"type": "equation_inline", "content": "I(x_{1}) = I(y_{1}) = -\\log 3 / 4 = 0.415"}, {"type": "text", "content": " bit，可见"}]}]}, {"page_idx": 165, "blocks": [{"type": "header", "index": 0, "bbox": [0.402, 0.057, 0.584, 0.072], "content": [{"type": "text", "content": "第4章 信息论基础"}]}, {"type": "page_number", "index": 1, "bbox": [0.856, 0.059, 0.894, 0.072], "content": [{"type": "text", "content": "153"}]}, {"type": "equation", "index": 2, "bbox": [0.365, 0.092, 0.622, 0.11], "content": "I (x _ {1} y _ {1}) \\neq I (x _ {1}) + I (y _ {1})"}, {"type": "text", "index": 3, "bbox": [0.061, 0.119, 0.662, 0.137], "content": [{"type": "text", "content": "即非独立事件的联合自信息不等于两个事件各自自信息之和。"}]}, {"type": "text", "index": 4, "bbox": [0.06, 0.146, 0.928, 0.192], "content": [{"type": "text", "content": "(3) XY 共有 3 种可能, "}, {"type": "equation_inline", "content": "x_{1} y_{1}, x_{0} y_{1}, x_{1} y_{0}"}, {"type": "text", "content": ", 而 "}, {"type": "equation_inline", "content": "x_{0} y_{0}"}, {"type": "text", "content": " 是不可能的, 因为两个人不可能都抓到, 先计算 XY 各种事件的概率"}]}, {"type": "equation", "index": 5, "bbox": [0.133, 0.2, 0.854, 0.233], "content": "p (x _ {1} y _ {1}) = 1 / 2 \\quad p (x _ {1} y _ {0}) = \\frac {3}{4} \\times \\frac {1}{3} = \\frac {1}{4} \\quad p (x _ {0} y _ {1}) = \\frac {1}{4} \\times 1 = \\frac {1}{4}"}, {"type": "text", "index": 6, "bbox": [0.061, 0.243, 0.462, 0.261], "content": [{"type": "text", "content": "在 XY 的概率空间上取平均, 得到联合熵"}]}, {"type": "equation", "index": 7, "bbox": [0.203, 0.271, 0.786, 0.304], "content": "H (X Y) = E [ I (X Y) ] = \\frac {1}{2} \\times 1 + \\frac {1}{4} \\times 2 + \\frac {1}{4} \\times 2 = \\frac {3}{2} \\mathrm{bit}"}, {"type": "text", "index": 8, "bbox": [0.062, 0.314, 0.93, 0.388], "content": [{"type": "text", "content": "下面给出条件熵的概念。与联合熵的定义相似,两个随机变量的条件熵定义为条件自信息在二维随机变量联合概率空间上的数学期望。它表示已知一个随机变量时,另一个随机变量仍存在的平均不确定性。"}]}, {"type": "text", "index": 9, "bbox": [0.106, 0.403, 0.623, 0.421], "content": [{"type": "text", "content": "定义 4.9 给定 Y 时, X 的条件熵  "}, {"type": "equation_inline", "content": "H(X|Y)"}, {"type": "text", "content": "  被定义为"}]}, {"type": "equation", "index": 10, "bbox": [0.2, 0.431, 0.926, 0.47], "content": "H (X \\mid Y) = E [ I (X \\mid Y) ] = - \\sum_ {i = 1} ^ {m} \\sum_ {j = 1} ^ {n} p (x _ {i} y _ {j}) \\log p (x _ {i} \\mid y _ {j})\\tag{4.1}"}, {"type": "text", "index": 11, "bbox": [0.107, 0.474, 0.662, 0.492], "content": [{"type": "text", "content": "条件熵 "}, {"type": "equation_inline", "content": "H(Y \\mid X)"}, {"type": "text", "content": " 也可以通过如下取两次统计平均得到:"}]}, {"type": "text", "index": 12, "bbox": [0.063, 0.501, 0.931, 0.547], "content": [{"type": "text", "content": "(1) 在给定 "}, {"type": "equation_inline", "content": "X = x_{i}"}, {"type": "text", "content": " 的条件下, 随机变量 "}, {"type": "equation_inline", "content": "Y"}, {"type": "text", "content": " 的不确定性可定义为 "}, {"type": "equation_inline", "content": "I(Y|X)"}, {"type": "text", "content": " 在 "}, {"type": "equation_inline", "content": "Y|X"}, {"type": "text", "content": " 条件概率空间上的统计平均, 即"}]}, {"type": "equation", "index": 13, "bbox": [0.285, 0.555, 0.708, 0.588], "content": "H (Y \\mid x _ {i}) = - \\sum_ {j} p (y _ {j} \\mid x _ {i}) \\log p (y _ {j} \\mid x _ {i})"}, {"type": "text", "index": 14, "bbox": [0.063, 0.592, 0.931, 0.637], "content": [{"type": "text", "content": "(2)对不同的 "}, {"type": "equation_inline", "content": "x_{i}"}, {"type": "text", "content": ", "}, {"type": "equation_inline", "content": "H(Y|x_{i})"}, {"type": "text", "content": " 是变化的, 将 "}, {"type": "equation_inline", "content": "H(Y|x_{i})"}, {"type": "text", "content": " 在 "}, {"type": "equation_inline", "content": "X"}, {"type": "text", "content": " 的概率空间上取统计平均可得到 "}, {"type": "equation_inline", "content": "H(Y|X)"}, {"type": "text", "content": " 。"}]}, {"type": "equation", "index": 15, "bbox": [0.245, 0.646, 0.749, 0.762], "content": "\\begin{array}{r l} H (Y \\mid X) & = - \\sum_ {i} p (x _ {i}) H (Y \\mid x _ {i}) \\\\ & = - \\sum_ {i} \\sum_ {j} p (x _ {i}) p (y _ {j} \\mid x _ {i}) \\log p (y _ {j} \\mid x _ {i}) \\\\ & = - \\sum_ {i} \\sum_ {j} p (x _ {i} y _ {j}) \\log p (y _ {j} \\mid x _ {i}) \\end{array}"}, {"type": "text", "index": 16, "bbox": [0.109, 0.767, 0.932, 0.785], "content": [{"type": "text", "content": "熵、联合熵和条件熵三者之间具有较为紧密的关系,下面的定理刻画了三者之间的关系。"}]}, {"type": "text", "index": 17, "bbox": [0.109, 0.794, 0.561, 0.811], "content": [{"type": "text", "content": "定理 4.1 熵、联合熵和条件熵满足如下等式:"}]}, {"type": "text", "index": 18, "bbox": [0.111, 0.82, 0.464, 0.838], "content": [{"type": "text", "content": "(1) "}, {"type": "equation_inline", "content": "H(XY) = H(X) + H(Y \\mid X)"}, {"type": "text", "content": ";"}]}, {"type": "text", "index": 19, "bbox": [0.112, 0.848, 0.463, 0.866], "content": [{"type": "text", "content": "(2) "}, {"type": "equation_inline", "content": "H(XY) = H(Y) + H(X \\mid Y)"}, {"type": "text", "content": "。"}]}, {"type": "text", "index": 20, "bbox": [0.111, 0.883, 0.166, 0.9], "content": [{"type": "text", "content": "证明"}]}, {"type": "text", "index": 21, "bbox": [0.111, 0.91, 0.221, 0.928], "content": [{"type": "text", "content": "先证明(1)"}]}]}, {"page_idx": 166, "blocks": [{"type": "page_number", "index": 0, "bbox": [0.088, 0.055, 0.124, 0.067], "content": [{"type": "text", "content": "154"}]}, {"type": "header", "index": 1, "bbox": [0.407, 0.053, 0.569, 0.068], "content": [{"type": "text", "content": "信息安全数学基础"}]}, {"type": "equation", "index": 2, "bbox": [0.095, 0.089, 0.878, 0.216], "content": "\\begin{array}{r l} H (X Y) & = \\sum_ {x} \\sum_ {y} p (x, y) \\log \\frac {1}{p (x , y)} = \\sum_ {x} \\sum_ {y} p (x, y) \\log \\frac {1}{p (x) p (y \\mid x)} \\\\ & = \\sum_ {x} \\sum_ {y} p (x, y) \\log \\frac {1}{p (x)} + \\sum_ {x} \\sum_ {y} p (x, y) \\log \\frac {1}{p (y \\mid x)} \\\\ & = \\sum_ {x} p (x) \\log \\frac {1}{p (x)} + \\sum_ {x} \\sum_ {y} p (x, y) \\log \\frac {1}{p (y \\mid x)} = H (X) + H (Y \\mid X) \\end{array}"}, {"type": "text", "index": 3, "bbox": [0.098, 0.225, 0.263, 0.243], "content": [{"type": "text", "content": "同理可证明(2)。"}]}, {"type": "text", "index": 4, "bbox": [0.053, 0.253, 0.924, 0.329], "content": [{"type": "text", "content": "上述性质表明,两个随机变量(X,Y)的联合不确定性由两部分组成,第一部分是随机变量X的不确定性,第二部分是在X已知的情况下Y的不确定性。事实上,这是熵可加性的另一种表现形式。"}]}, {"type": "text", "index": 5, "bbox": [0.098, 0.346, 0.564, 0.364], "content": [{"type": "text", "content": "定理 4.2 熵、联合熵和条件熵满足如下不等式"}]}, {"type": "equation", "index": 6, "bbox": [0.241, 0.374, 0.733, 0.448], "content": "\\begin{array}{r l} \\max (H (X), H (Y)) & \\leqslant H (X Y) \\leqslant H (X) + H (Y) \\\\ 0 & \\leqslant H (X \\mid Y) \\leqslant H (X) \\\\ 0 & \\leqslant H (Y \\mid X) \\leqslant H (Y) \\end{array}"}, {"type": "text", "index": 7, "bbox": [0.098, 0.458, 0.884, 0.477], "content": [{"type": "text", "content": "证明 根据条件熵的定义,因为  "}, {"type": "equation_inline", "content": "p(x \\mid y) \\leqslant 1"}, {"type": "text", "content": " , 式(4.1)中的每一项都非负, 所以"}]}, {"type": "equation", "index": 8, "bbox": [0.412, 0.486, 0.568, 0.505], "content": "H (X \\mid Y) \\geqslant 0"}, {"type": "text", "index": 9, "bbox": [0.056, 0.515, 0.111, 0.532], "content": [{"type": "text", "content": "同理"}]}, {"type": "equation", "index": 10, "bbox": [0.413, 0.542, 0.568, 0.561], "content": "H (Y \\mid X) \\geqslant 0"}, {"type": "text", "index": 11, "bbox": [0.057, 0.571, 0.289, 0.589], "content": [{"type": "text", "content": "由熵的表达式可以得知"}]}, {"type": "equation", "index": 12, "bbox": [0.399, 0.598, 0.579, 0.646], "content": "\\begin{array}{l} H (X Y) \\geqslant H (X) \\\\ H (X Y) \\geqslant H (Y) \\end{array}"}, {"type": "text", "index": 13, "bbox": [0.056, 0.655, 0.536, 0.673], "content": [{"type": "text", "content": "即联合熵必不小于各随机变量的独立熵。所以有"}]}, {"type": "equation", "index": 14, "bbox": [0.333, 0.683, 0.645, 0.702], "content": "H (X Y) \\geqslant \\max (H (X), H (Y))"}, {"type": "text", "index": 15, "bbox": [0.057, 0.712, 0.155, 0.729], "content": [{"type": "text", "content": "再注意到"}]}, {"type": "equation", "index": 16, "bbox": [0.098, 0.738, 0.884, 0.926], "content": "\\begin{array}{l} H (X Y) - H (X) - H (Y) \\\\ = \\sum_ {x} \\sum_ {y} p (x, y) \\log \\frac {1}{p (x , y)} - \\sum_ {x} p (x) \\log \\frac {1}{p (x)} - \\sum_ {y} p (y) \\log \\frac {1}{p (y)} \\\\ = \\sum_ {x} \\sum_ {y} p (x, y) \\log \\frac {p (x) p (y)}{p (x , y)} \\leqslant \\log \\sum_ {x} \\sum_ {y} p (x) p (y) = 0 \\\\ H (X \\mid Y) - H (X) \\\\ = \\sum_ {x} \\sum_ {y} p (x, y) \\log \\frac {1}{p (x \\mid y)} - \\sum_ {x} p (x) \\log \\frac {1}{p (x)} = \\sum_ {x} \\sum_ {y} p (x, y) \\log \\frac {p (x)}{p (x \\mid y)} \\end{array}"}]}, {"page_idx": 167, "blocks": [{"type": "header", "index": 0, "bbox": [0.398, 0.055, 0.58, 0.071], "content": [{"type": "text", "content": "第4章 信息论基础"}]}, {"type": "page_number", "index": 1, "bbox": [0.852, 0.057, 0.89, 0.07], "content": [{"type": "text", "content": "155"}]}, {"type": "equation", "index": 2, "bbox": [0.179, 0.091, 0.796, 0.127], "content": "\\leqslant \\log \\left[ \\sum_ {x} \\sum_ {y} p (x, y) \\frac {p (x)}{p (x \\mid y)} \\right] = \\log \\left[ \\sum_ {x} \\sum_ {y} p (x) p (y) \\right] = 0"}, {"type": "text", "index": 3, "bbox": [0.055, 0.133, 0.708, 0.152], "content": [{"type": "text", "content": "同理可以证明 "}, {"type": "equation_inline", "content": "H(Y\\mid X) - H(X)\\leqslant 0"}, {"type": "text", "content": " ，故条件熵不大于无条件熵。"}]}, {"type": "text", "index": 4, "bbox": [0.099, 0.161, 0.343, 0.179], "content": [{"type": "text", "content": "下面讨论两种极端情况。"}]}, {"type": "text", "index": 5, "bbox": [0.099, 0.188, 0.462, 0.206], "content": [{"type": "text", "content": "(1) 当 X 与 Y 相互独立时, 容易证明"}]}, {"type": "equation", "index": 6, "bbox": [0.32, 0.215, 0.62, 0.289], "content": "\\begin{array}{r l} H (X \\mid Y) & = H (X) \\\\ H (Y \\mid X) & = H (Y) \\\\ H (X Y) & = H (X) + H (Y) \\end{array}"}, {"type": "text", "index": 7, "bbox": [0.099, 0.298, 0.568, 0.317], "content": [{"type": "text", "content": "(2) 当 X 与 Y 之间有一一对应关系时, 容易证明"}]}, {"type": "equation", "index": 8, "bbox": [0.342, 0.326, 0.63, 0.372], "content": "\\begin{array}{l} H (X Y) = H (X) = H (Y) \\\\ H (Y \\mid X) = H (X \\mid Y) = 0 \\end{array}"}, {"type": "text", "index": 9, "bbox": [0.054, 0.39, 0.924, 0.439], "content": [{"type": "text", "content": "例 4.10 两个随机实验 X 和 Y, "}, {"type": "equation_inline", "content": "X = \\{x_{1}, x_{2}, x_{3}\\}"}, {"type": "text", "content": ", "}, {"type": "equation_inline", "content": "Y = \\{y_{1}, y_{2}, y_{3}\\}"}, {"type": "text", "content": ", 联合概率 "}, {"type": "equation_inline", "content": "r(x_{i}, y_{j}) = r_{ij}"}, {"type": "text", "content": " 为"}]}, {"type": "equation", "index": 10, "bbox": [0.298, 0.453, 0.681, 0.529], "content": "\\left[ \\begin{array}{c c c} r _ {1 1} & r _ {1 2} & r _ {1 3} \\\\ r _ {2 1} & r _ {2 2} & r _ {2 3} \\\\ r _ {3 1} & r _ {3 2} & r _ {3 3} \\end{array} \\right] = \\left[ \\begin{array}{c c c} 7 / 2 4 & 1 / 2 4 & 0 \\\\ 1 / 2 4 & 1 / 4 & 1 / 2 4 \\\\ 0 & 1 / 2 4 & 7 / 2 4 \\end{array} \\right]"}, {"type": "text", "index": 11, "bbox": [0.1, 0.536, 0.715, 0.555], "content": [{"type": "text", "content": "(1)如果知道 X 和 Y 的实验结果,求得到的平均信息量是多少?"}]}, {"type": "text", "index": 12, "bbox": [0.1, 0.564, 0.671, 0.583], "content": [{"type": "text", "content": "(2) 如果知道 "}, {"type": "equation_inline", "content": "Y"}, {"type": "text", "content": " 的实验结果, 求得到的平均信息量是多少?"}]}, {"type": "text", "index": 13, "bbox": [0.101, 0.591, 0.911, 0.61], "content": [{"type": "text", "content": "(3) 在已知 "}, {"type": "equation_inline", "content": "Y"}, {"type": "text", "content": " 实验结果的情况下, 知道 "}, {"type": "equation_inline", "content": "X"}, {"type": "text", "content": " 的实验结果, 求得到的平均信息量是多少?"}]}, {"type": "text", "index": 14, "bbox": [0.099, 0.627, 0.487, 0.646], "content": [{"type": "text", "content": "解 联合概率 "}, {"type": "equation_inline", "content": "p(x_{i},y_{j})"}, {"type": "text", "content": " 可以表示如下:"}]}, {"type": "table", "index": 15, "bbox": [0.146, 0.663, 0.833, 0.793], "content": [{"type": "table_body", "index": 15, "bbox": [0.146, 0.663, 0.833, 0.793], "content": "<table><tr><td>X\\Y</td><td><eq>y_1</eq></td><td><eq>y_2</eq></td><td><eq>y_3</eq></td></tr><tr><td><eq>x_1</eq></td><td>7/24</td><td>1/24</td><td>0</td></tr><tr><td><eq>x_2</eq></td><td>1/24</td><td>1/4</td><td>1/24</td></tr><tr><td><eq>x_3</eq></td><td>0</td><td>1/24</td><td>7/24</td></tr></table>"}]}, {"type": "text", "index": 16, "bbox": [0.103, 0.819, 0.178, 0.836], "content": [{"type": "text", "content": "于是有"}]}, {"type": "equation", "index": 17, "bbox": [0.192, 0.847, 0.791, 0.926], "content": "\\begin{array}{r l} H (X Y) & = \\sum_ {i j} p (x _ {i}, y _ {j}) \\log_ {2} \\frac {1}{p (x _ {i} , y _ {j})} \\\\ & = 2 \\times \\frac {7}{2 4} \\log_ {2} \\frac {2 4}{7} + 4 \\times \\frac {1}{2 4} \\log_ {2} 2 4 + \\frac {1}{4} \\log_ {2} 4 = 2. 3 \\text {bit} \\end{array}"}]}, {"page_idx": 168, "blocks": [{"type": "page_number", "index": 0, "bbox": [0.091, 0.054, 0.128, 0.067], "content": [{"type": "text", "content": "156"}]}, {"type": "header", "index": 1, "bbox": [0.411, 0.051, 0.573, 0.067], "content": [{"type": "text", "content": "信息安全数学基础"}]}, {"type": "text", "index": 2, "bbox": [0.102, 0.086, 0.637, 0.104], "content": [{"type": "text", "content": "根据联合概率分布可以得到 "}, {"type": "equation_inline", "content": "X"}, {"type": "text", "content": " 和 "}, {"type": "equation_inline", "content": "Y"}, {"type": "text", "content": " 的概率分布分别为"}]}, {"type": "equation", "index": 3, "bbox": [0.337, 0.116, 0.649, 0.164], "content": "\\left[ \\begin{array}{l} X \\\\ P (x) \\end{array} \\right] = \\left[ \\begin{array}{c c c} x _ {1} & x _ {2} & x _ {3} \\\\ 8 / 2 4 & 8 / 2 4 & 8 / 2 4 \\end{array} \\right]"}, {"type": "equation", "index": 4, "bbox": [0.337, 0.174, 0.649, 0.221], "content": "\\left[ \\begin{array}{l} Y \\\\ P (y) \\end{array} \\right] = \\left[ \\begin{array}{c c c} y _ {1} & y _ {2} & y _ {3} \\\\ 8 / 2 4 & 8 / 2 4 & 8 / 2 4 \\end{array} \\right]"}, {"type": "text", "index": 5, "bbox": [0.059, 0.229, 0.484, 0.259], "content": [{"type": "text", "content": "所以， "}, {"type": "equation_inline", "content": "H(Y) = 3\\times \\frac{1}{3}\\log_23 = 1.58"}, {"type": "text", "content": " bit，即"}]}, {"type": "equation", "index": 6, "bbox": [0.216, 0.271, 0.772, 0.289], "content": "H (X \\mid Y) = H (X Y) - H (Y) = 2. 3 - 1. 5 8 = 0. 7 2 \\text { bit }"}, {"type": "paragraph_title", "index": 7, "bbox": [0.06, 0.324, 0.411, 0.346], "content": [{"type": "text", "content": "4.4 互信息与平均互信息"}], "level": 2}, {"type": "text", "index": 8, "bbox": [0.06, 0.38, 0.93, 0.453], "content": [{"type": "text", "content": "在实际工作和生活中,在不能够直接得到某事件的信息时,往往需要通过其他事件获取该事件的信息,这实质上是互信息概念的应用。互信息概念的提出对于信息传输相关问题研究作用很大,可以说是信息论发展的一个重要里程碑。下面给出互信息的定义。"}]}, {"type": "text", "index": 9, "bbox": [0.062, 0.468, 0.929, 0.514], "content": [{"type": "text", "content": "定义 4.10 一个事件 "}, {"type": "equation_inline", "content": "y_{j}"}, {"type": "text", "content": " 给出关于另一个事件 "}, {"type": "equation_inline", "content": "x_{i}"}, {"type": "text", "content": " 的信息称为互信息, 用 "}, {"type": "equation_inline", "content": "I(x_{i}; y_{j})"}, {"type": "text", "content": " 表示, 即"}]}, {"type": "equation", "index": 10, "bbox": [0.262, 0.522, 0.926, 0.557], "content": "I (x _ {i}; y _ {j}) = I (x _ {i}) - I (x _ {i} \\mid y _ {j}) = \\log \\frac {p (x _ {i} \\mid y _ {j})}{p (x _ {i})}\\tag{4.2}"}, {"type": "text", "index": 11, "bbox": [0.063, 0.566, 0.932, 0.693], "content": [{"type": "text", "content": "互信息 "}, {"type": "equation_inline", "content": "I(x_{i};y_{j})"}, {"type": "text", "content": " 是已知事件 "}, {"type": "equation_inline", "content": "y_{j}"}, {"type": "text", "content": " 后所消除的关于事件 "}, {"type": "equation_inline", "content": "x_{i}"}, {"type": "text", "content": " 的不确定性, 它等于事件 "}, {"type": "equation_inline", "content": "x_{i}"}, {"type": "text", "content": " 本身的不确定性 "}, {"type": "equation_inline", "content": "I(x_{i})"}, {"type": "text", "content": " 减去已知事件 "}, {"type": "equation_inline", "content": "y_{j}"}, {"type": "text", "content": " 后对 "}, {"type": "equation_inline", "content": "x_{i}"}, {"type": "text", "content": " 仍然存在的不确定性 "}, {"type": "equation_inline", "content": "I(x_{i} \\mid y_{i})"}, {"type": "text", "content": " 。互信息反映了两个随机事件 "}, {"type": "equation_inline", "content": "x"}, {"type": "text", "content": " 与 "}, {"type": "equation_inline", "content": "y"}, {"type": "text", "content": " 之间的统计关联程度。在通信系统中, 互信息的物理意义是, 信道输出端接收到某消息 (或消息序列) "}, {"type": "equation_inline", "content": "y_{j}"}, {"type": "text", "content": " 后, 获得的关于输入端某消息 (或消息序列) "}, {"type": "equation_inline", "content": "x_{i}"}, {"type": "text", "content": " 的信息量。"}]}, {"type": "text", "index": 12, "bbox": [0.065, 0.707, 0.932, 0.78], "content": [{"type": "text", "content": "例 4.11 一个有 80 个彩球的箱子里分别有黄球 40 个, 红球 20 个, 蓝球 10 个, 绿球 10 个。如果有人告诉你某次摸出的球不是黄球, 把这句话作为消息 "}, {"type": "equation_inline", "content": "y_{1}"}, {"type": "text", "content": ", 求收到 "}, {"type": "equation_inline", "content": "y_{1}"}, {"type": "text", "content": " 后, "}, {"type": "equation_inline", "content": "y_{1}"}, {"type": "text", "content": " 与摸到各种颜色球的互信息量。"}]}, {"type": "text", "index": 13, "bbox": [0.065, 0.788, 0.932, 0.834], "content": [{"type": "text", "content": "解 把各种颜色分别记做 "}, {"type": "equation_inline", "content": "x_{1}"}, {"type": "text", "content": " (黄), "}, {"type": "equation_inline", "content": "x_{2}"}, {"type": "text", "content": " (红), "}, {"type": "equation_inline", "content": "x_{3}"}, {"type": "text", "content": " (蓝), "}, {"type": "equation_inline", "content": "x_{4}"}, {"type": "text", "content": " (绿)。收到消息 "}, {"type": "equation_inline", "content": "y_{1}"}, {"type": "text", "content": " 后, 摸到各种颜色球的概率变成了后验概率"}]}, {"type": "equation", "index": 14, "bbox": [0.26, 0.842, 0.742, 0.878], "content": "p (x _ {2} \\mid y _ {1}) = \\frac {p (x _ {2} y _ {1})}{p (y _ {1})} = \\frac {1 / 4}{1 / 4 + 1 / 8 + 1 / 8} = \\frac {1}{2}"}, {"type": "equation", "index": 15, "bbox": [0.261, 0.887, 0.738, 0.923], "content": "p (x _ {3} \\mid y _ {1}) = \\frac {p (x _ {3} y _ {1})}{p (y _ {1})} = \\frac {1 / 8}{1 / 4 + 1 / 8 + 1 / 8} = \\frac {1}{4}"}]}, {"page_idx": 169, "blocks": [{"type": "header", "index": 0, "bbox": [0.394, 0.063, 0.576, 0.079], "content": [{"type": "text", "content": "第4章 信息论基础"}]}, {"type": "page_number", "index": 1, "bbox": [0.848, 0.064, 0.886, 0.078], "content": [{"type": "text", "content": "157"}]}, {"type": "equation", "index": 2, "bbox": [0.244, 0.098, 0.724, 0.134], "content": "p (x _ {4} \\mid y _ {1}) = \\frac {p (x _ {4} y _ {1})}{p (y _ {1})} = \\frac {1 / 8}{1 / 4 + 1 / 8 + 1 / 8} = \\frac {1}{4}"}, {"type": "text", "index": 3, "bbox": [0.095, 0.142, 0.754, 0.161], "content": [{"type": "text", "content": "根据互信息量的定义,可计算出 "}, {"type": "equation_inline", "content": "{y}_{1}"}, {"type": "text", "content": " 与摸到各种颜色球的互信息量为"}]}, {"type": "equation", "index": 4, "bbox": [0.323, 0.168, 0.651, 0.204], "content": "I (x _ {1}; y _ {1}) = \\log \\frac {p (x _ {1} \\mid y _ {1})}{p (x _ {1})} = \\infty"}, {"type": "equation", "index": 5, "bbox": [0.261, 0.211, 0.712, 0.25], "content": "I (x _ {2}; y _ {1}) = \\log \\frac {p (x _ {2} \\mid y _ {1})}{p (x _ {2})} = \\log \\frac {1 / 2}{1 / 4} = 1 \\mathrm{bit}"}, {"type": "equation", "index": 6, "bbox": [0.262, 0.255, 0.712, 0.293], "content": "I (x _ {3}; y _ {1}) = \\log \\frac {p (x _ {3} \\mid y _ {1})}{p (x _ {3})} = \\log \\frac {1 / 4}{1 / 8} = 1 \\mathrm{bit}"}, {"type": "equation", "index": 7, "bbox": [0.26, 0.299, 0.71, 0.336], "content": "I (x _ {4}; y _ {1}) = \\log \\frac {p (x _ {4} \\mid y _ {1})}{p (x _ {4})} = \\log \\frac {1 / 4}{1 / 8} = 1 \\text {bit}"}, {"type": "text", "index": 8, "bbox": [0.097, 0.351, 0.469, 0.369], "content": [{"type": "text", "content": "定理 4.3 互信息具有以下几点性质。"}]}, {"type": "text", "index": 9, "bbox": [0.098, 0.377, 0.416, 0.395], "content": [{"type": "text", "content": "(1) 互易性: "}, {"type": "equation_inline", "content": "I(x;y)=I(y;x)"}, {"type": "text", "content": " ;"}]}, {"type": "text", "index": 10, "bbox": [0.097, 0.404, 0.661, 0.423], "content": [{"type": "text", "content": "(2) 当事件 x, y 统计独立时, 互信息为零, 即  "}, {"type": "equation_inline", "content": "I(x; y) = 0"}, {"type": "text", "content": " ;"}]}, {"type": "text", "index": 11, "bbox": [0.098, 0.431, 0.518, 0.449], "content": [{"type": "text", "content": "(3) 互信息取值可能是正数也可能是负数；"}]}, {"type": "text", "index": 12, "bbox": [0.097, 0.457, 0.74, 0.477], "content": [{"type": "text", "content": "(4) 任何两事件之间的互信息不可能大于其中任一事件的自信息。"}]}, {"type": "text", "index": 13, "bbox": [0.097, 0.492, 0.601, 0.511], "content": [{"type": "text", "content": "证明 由互信息的定义容易验证性质(1)成立,而且"}]}, {"type": "equation", "index": 14, "bbox": [0.21, 0.519, 0.765, 0.556], "content": "I (x; y) = \\log \\frac {p (x \\mid y)}{p (x)} = \\log \\frac {p (y \\mid x)}{p (x)} = \\log \\frac {p (x y)}{p (x) p (y)}"}, {"type": "text", "index": 15, "bbox": [0.052, 0.563, 0.924, 0.663], "content": [{"type": "text", "content": "因为当事件 x, y 统计独立时，有  "}, {"type": "equation_inline", "content": "p(x \\mid y) = p(x)"}, {"type": "text", "content": " ，所以性质(2)成立；又因为当  "}, {"type": "equation_inline", "content": "p(x \\mid y) > p(x)"}, {"type": "text", "content": "  时， "}, {"type": "equation_inline", "content": "I(x; y) > 0"}, {"type": "text", "content": " ；当  "}, {"type": "equation_inline", "content": "p(x \\mid y) < p(x)"}, {"type": "text", "content": "  时， "}, {"type": "equation_inline", "content": "I(x; y) < 0"}, {"type": "text", "content": " ，所以性质(3)成立；根据式(4.2)，并考虑自信息和条件自信息的非负性，可得性质(4)，即一个事件的自信息是任何其他事件所能提供的关于该事件的最大信息量。"}]}, {"type": "text", "index": 16, "bbox": [0.054, 0.67, 0.924, 0.743], "content": [{"type": "text", "content": "为了从整体上表示从一个随机变量 Y 所给出关于另外一个随机变量 X 的信息量, 定义互信息  "}, {"type": "equation_inline", "content": "I(x_{i}; y_{i})"}, {"type": "text", "content": "  在二维随机变量  "}, {"type": "equation_inline", "content": "(X, Y)"}, {"type": "text", "content": "  的概率空间上的数学期望为随机变量 X 和 Y 之间的平均互信息。"}]}, {"type": "text", "index": 17, "bbox": [0.099, 0.758, 0.664, 0.776], "content": [{"type": "text", "content": "定义 4.11 随机变量 X 与 Y 之间的平均互信息被定义为"}]}, {"type": "equation", "index": 18, "bbox": [0.241, 0.784, 0.731, 0.817], "content": "I (X; Y) = E [ I (x; y) ] = \\sum_ {i} \\sum_ {j} p (x _ {i} y _ {j}) I (x _ {i}; y _ {j})"}, {"type": "text", "index": 19, "bbox": [0.099, 0.827, 0.918, 0.845], "content": [{"type": "text", "content": "定理 4.4 随机变量 X 与 Y 之间的平均互信息满足  "}, {"type": "equation_inline", "content": "I(X;Y)=H(X)-H(X \\mid Y)"}, {"type": "text", "content": " 。"}]}, {"type": "equation", "index": 20, "bbox": [0.127, 0.86, 0.711, 0.936], "content": "\\begin{array}{r l} \\text {明} & I (X; Y) = E [ I (x; y) ] = \\sum_ {i} \\sum_ {j} p (x _ {i} y _ {j}) I (x _ {i}; y _ {j}) \\\\ & \\qquad = \\sum_ {i} \\sum_ {j} p (x _ {i} y _ {j}) \\log \\frac {p (x _ {i} \\mid y _ {j})}{p (x _ {i})} \\end{array}"}]}, {"page_idx": 170, "blocks": [{"type": "page_number", "index": 0, "bbox": [0.096, 0.061, 0.133, 0.074], "content": [{"type": "text", "content": "158"}]}, {"type": "header", "index": 1, "bbox": [0.416, 0.059, 0.579, 0.075], "content": [{"type": "text", "content": "信息安全数学基础"}]}, {"type": "equation", "index": 2, "bbox": [0.399, 0.095, 0.709, 0.199], "content": "\\begin{array}{l} = \\sum_ {i} \\sum_ {j} p (x _ {i} y _ {j}) \\log \\frac {1}{p (x _ {i})} - \\\\ \\sum_ {i} \\sum_ {j} p (x _ {i} y _ {j}) \\log \\frac {1}{p (x _ {i} \\mid y _ {j})} \\\\ = H (X) - H (X \\mid Y) \\end{array}"}, {"type": "text", "index": 3, "bbox": [0.062, 0.207, 0.933, 0.28], "content": [{"type": "text", "content": "这里条件熵 "}, {"type": "equation_inline", "content": "H(X \\mid Y)"}, {"type": "text", "content": " 表示给定随机变量 "}, {"type": "equation_inline", "content": "Y"}, {"type": "text", "content": " 后, 随机变量 "}, {"type": "equation_inline", "content": "X"}, {"type": "text", "content": " 仍然存在的不确定性。所以 "}, {"type": "equation_inline", "content": "Y"}, {"type": "text", "content": " 关于 "}, {"type": "equation_inline", "content": "X"}, {"type": "text", "content": " 的平均互信息是收到 "}, {"type": "equation_inline", "content": "Y"}, {"type": "text", "content": " 后关于 "}, {"type": "equation_inline", "content": "X"}, {"type": "text", "content": " 的不确定性减少的量, 也就是从 "}, {"type": "equation_inline", "content": "Y"}, {"type": "text", "content": " 所获得的关于 "}, {"type": "equation_inline", "content": "X"}, {"type": "text", "content": " 的平均信息量。 "}, {"type": "equation_inline", "content": "\\square"}]}, {"type": "text", "index": 4, "bbox": [0.062, 0.287, 0.934, 0.416], "content": [{"type": "text", "content": "由定理 4.4 可以进一步理解平均互信息的物理意义。在通信系统中, 已知 "}, {"type": "equation_inline", "content": "H(X)"}, {"type": "text", "content": " 代表接收到输出符号以前关于输入变量 "}, {"type": "equation_inline", "content": "X"}, {"type": "text", "content": " 的平均不确定性, 而 "}, {"type": "equation_inline", "content": "H(X \\mid Y)"}, {"type": "text", "content": " 代表接收到输出符号后关于输入变量 "}, {"type": "equation_inline", "content": "X"}, {"type": "text", "content": " 的平均不确定性, 两者之差表示接收端所获得的信息量, 即平均互信息。可见, 通过信道传输消除了一些不确定性, 获得了一定的信息, 而平均互信息就代表接收到输出符号后平均每个符号所获得的关于输入端 "}, {"type": "equation_inline", "content": "X"}, {"type": "text", "content": " 的信息量。"}]}, {"type": "text", "index": 5, "bbox": [0.108, 0.43, 0.593, 0.448], "content": [{"type": "text", "content": "定理 4.5 平均互信息具有以下两个基本的性质。"}]}, {"type": "text", "index": 6, "bbox": [0.108, 0.457, 0.704, 0.475], "content": [{"type": "text", "content": "(1) 非负性: "}, {"type": "equation_inline", "content": "I(X; Y) \\geqslant 0"}, {"type": "text", "content": ", 当且仅当 "}, {"type": "equation_inline", "content": "X, Y"}, {"type": "text", "content": " 独立时, 等式成立。"}]}, {"type": "text", "index": 7, "bbox": [0.11, 0.484, 0.43, 0.501], "content": [{"type": "text", "content": "(2) 对称性: "}, {"type": "equation_inline", "content": "I(X;Y)=I(Y;X)"}]}, {"type": "text", "index": 8, "bbox": [0.108, 0.518, 0.318, 0.536], "content": [{"type": "text", "content": "证明 (1) 考虑下式"}]}, {"type": "equation", "index": 9, "bbox": [0.134, 0.547, 0.861, 0.583], "content": "- I (X, Y) = \\sum_ {i} \\sum_ {j} p (x _ {i} y _ {j}) \\log \\frac {p (x _ {i}) p (y _ {j})}{p (x _ {i} y _ {j})} \\leqslant \\log \\sum_ {i} \\sum_ {j} p (x _ {i}) p (y _ {j}) = 0"}, {"type": "text", "index": 10, "bbox": [0.064, 0.589, 0.723, 0.608], "content": [{"type": "text", "content": "所以 "}, {"type": "equation_inline", "content": "I(X,Y)\\geqslant 0"}, {"type": "text", "content": " 。由严格上凸函数的性质，上式等号成立当且仅当"}]}, {"type": "equation", "index": 11, "bbox": [0.186, 0.616, 0.814, 0.635], "content": "p (x _ {i} y _ {j}) = p (x _ {i}) p (y _ {j}) \\quad i = 1, 2, \\dots n \\quad j = 1, 2, \\dots , m"}, {"type": "text", "index": 12, "bbox": [0.065, 0.643, 0.69, 0.661], "content": [{"type": "text", "content": "即两个随机变量之间的互信息为零当且仅当它们相互统计独立。"}]}, {"type": "text", "index": 13, "bbox": [0.11, 0.67, 0.363, 0.687], "content": [{"type": "text", "content": "(2) 根据定义很容易得到"}]}, {"type": "equation", "index": 14, "bbox": [0.3, 0.695, 0.719, 0.849], "content": "\\begin{array}{r l} I (Y, X) & = H (Y) - H (Y \\mid X) \\\\ & = H (Y) - [ H (X, Y) - H (X) ] \\\\ & = H (X) + H (Y) - H (X, Y) \\\\ & = H (X) - [ H (X, Y) - H (Y) ] \\\\ & = H (X) - H (X \\mid Y) \\\\ & = I (X, Y) \\end{array}"}, {"type": "text", "index": 15, "bbox": [0.065, 0.859, 0.935, 0.933], "content": [{"type": "text", "content": "平均互信息性质中的非负性说明: 在通信系统中, 从整体和平均的意义上来说, 信道每通过一条消息, 总能传递一定的信息量, 或者说接收端每收到一条消息, 总能提取到信源 X 的信息量, 即总能使信源的不确定性有所降低。"}]}]}, {"page_idx": 171, "blocks": [{"type": "header", "index": 0, "bbox": [0.398, 0.061, 0.579, 0.077], "content": [{"type": "text", "content": "第4章 信息论基础"}]}, {"type": "page_number", "index": 1, "bbox": [0.852, 0.063, 0.889, 0.077], "content": [{"type": "text", "content": "159"}]}, {"type": "text", "index": 2, "bbox": [0.054, 0.096, 0.923, 0.198], "content": [{"type": "text", "content": "平均互信息性质中的对称性说明:对于通信系统信道两端的随机变量 X 和 Y,由 Y 提取到的关于 X 的信息量与从 X 中提取到的关于 Y 的信息量是一样的。 "}, {"type": "equation_inline", "content": "I(X;Y)"}, {"type": "text", "content": "  和  "}, {"type": "equation_inline", "content": "I(Y;X)"}, {"type": "text", "content": "  只是观察者的立足点不同,对信道两端的随机变量 X 和 Y 之间的信息传输的总体测度的两种不同的表达形式而已。"}]}, {"type": "text", "index": 3, "bbox": [0.055, 0.213, 0.924, 0.287], "content": [{"type": "text", "content": "例 4.12 某地一段时间内出现晴、阴、雨的概率都为 "}, {"type": "equation_inline", "content": "1 / 3"}, {"type": "text", "content": " ，如果某天不是雨天，则抛一次硬币；如果是雨天，则抛两次硬币，试计算从抛硬币出现正面的次数可以得到多少关于天气的信息量。"}]}, {"type": "text", "index": 4, "bbox": [0.055, 0.295, 0.924, 0.369], "content": [{"type": "text", "content": "解 本题的题意是根据抛硬币出现正面的次数 "}, {"type": "equation_inline", "content": "Y"}, {"type": "text", "content": " 来获得关于天气 "}, {"type": "equation_inline", "content": "X"}, {"type": "text", "content": " 的信息(两种结果)。设不是雨天的事件为 "}, {"type": "equation_inline", "content": "X = 0"}, {"type": "text", "content": ", 结果是雨天的事件为 "}, {"type": "equation_inline", "content": "X = 1"}, {"type": "text", "content": ", 随机变量 "}, {"type": "equation_inline", "content": "Y = 0"}, {"type": "text", "content": " 表示抛硬币出现正面 0 次, "}, {"type": "equation_inline", "content": "Y = 1"}, {"type": "text", "content": " 表示出现正面 1 次, "}, {"type": "equation_inline", "content": "Y = 2"}, {"type": "text", "content": " 表示出现正面 2 次。"}]}, {"type": "text", "index": 5, "bbox": [0.1, 0.382, 0.567, 0.441], "content": [{"type": "text", "content": "随机变量 X 的概率分布为  "}, {"type": "equation_inline", "content": "\\begin{bmatrix} X \\\\ p(X) \\end{bmatrix} = \\begin{bmatrix} 0 & 1 \\\\ \\frac{2}{3} & \\frac{1}{3} \\end{bmatrix}"}]}, {"type": "text", "index": 6, "bbox": [0.102, 0.453, 0.464, 0.531], "content": [{"type": "text", "content": "条件概率矩阵  "}, {"type": "equation_inline", "content": "P_{Y|X}=\\begin{bmatrix}\\frac{1}{2}&\\frac{1}{2}&0\\\\ \\frac{1}{4}&\\frac{1}{2}&\\frac{1}{4}\\end{bmatrix}"}]}, {"type": "text", "index": 7, "bbox": [0.101, 0.54, 0.422, 0.558], "content": [{"type": "equation_inline", "content": "Y"}, {"type": "text", "content": " 的概率分布可以通过下式求得"}]}, {"type": "equation", "index": 8, "bbox": [0.209, 0.568, 0.773, 0.649], "content": "\\boldsymbol {P} _ {Y} = \\boldsymbol {P} _ {Y \\mid X} ^ {\\mathrm{T}} \\boldsymbol {P} _ {X} = \\left[ \\begin{array}{l l l} \\frac {1}{2} & \\frac {1}{2} & 0 \\\\ \\frac {1}{4} & \\frac {1}{2} & \\frac {1}{4} \\end{array} \\right] ^ {\\mathrm{T}} \\left[ \\begin{array}{l} \\frac {2}{3} \\\\ \\frac {1}{3} \\end{array} \\right] = \\left(\\frac {5}{1 2} \\quad \\frac {1}{2} \\quad \\frac {1}{1 2}\\right) ^ {\\mathrm{T}}"}, {"type": "text", "index": 9, "bbox": [0.103, 0.658, 0.293, 0.676], "content": [{"type": "text", "content": "所以 "}, {"type": "equation_inline", "content": "Y"}, {"type": "text", "content": " 的信息熵为"}]}, {"type": "equation", "index": 10, "bbox": [0.187, 0.685, 0.795, 0.75], "content": "\\begin{array}{r l} H (Y) & = - p _ {Y} (0) \\log p _ {Y} (0) - p _ {Y} (1) \\log p _ {Y} (1) - p _ {Y} (2) \\log p _ {Y} (2) \\\\ & = \\frac {5}{1 2} \\log \\frac {1 2}{5} + \\frac {1}{2} \\log 2 + \\frac {1}{1 2} \\log 1 2 = 1. 3 2 5 \\text {bit} \\end{array}"}, {"type": "text", "index": 11, "bbox": [0.06, 0.761, 0.6, 0.781], "content": [{"type": "text", "content": "由条件概率分布 "}, {"type": "equation_inline", "content": "P_{Y|X}"}, {"type": "text", "content": " 可求出已知 "}, {"type": "equation_inline", "content": "X"}, {"type": "text", "content": " 时 "}, {"type": "equation_inline", "content": "Y"}, {"type": "text", "content": " 的条件熵如下"}]}, {"type": "equation", "index": 12, "bbox": [0.101, 0.789, 0.887, 0.823], "content": "H (Y \\mid X) = \\frac {2}{3} \\left(\\frac {1}{2} \\log 2 + \\frac {1}{2} \\log 2\\right) + \\frac {1}{3} \\left(\\frac {1}{4} \\log 4 + \\frac {1}{2} \\log 2 + \\frac {1}{4} \\log 4\\right) = 1. 1 6 6 \\text {bit}"}, {"type": "text", "index": 13, "bbox": [0.061, 0.834, 0.092, 0.852], "content": [{"type": "text", "content": "故"}]}, {"type": "equation", "index": 14, "bbox": [0.194, 0.86, 0.796, 0.878], "content": "I (X; Y) = H (Y) - H (Y \\mid X) = 1. 3 2 5 - 1. 1 6 6 = 0. 1 5 9 \\text { bit }"}, {"type": "text", "index": 15, "bbox": [0.061, 0.888, 0.713, 0.907], "content": [{"type": "text", "content": "即从抛硬币出现正面次数平均得到关于天气的信息量为 0.159 bit。"}]}, {"type": "text", "index": 16, "bbox": [0.103, 0.915, 0.93, 0.935], "content": [{"type": "text", "content": "除了定理 4.5 给出平均互信息具有以下两个基本的性质外, 平均互信息还具有其他"}]}]}, {"page_idx": 172, "blocks": [{"type": "page_number", "index": 0, "bbox": [0.097, 0.058, 0.133, 0.07], "content": [{"type": "text", "content": "160"}]}, {"type": "header", "index": 1, "bbox": [0.417, 0.057, 0.579, 0.072], "content": [{"type": "text", "content": "信息安全数学基础"}]}, {"type": "text", "index": 2, "bbox": [0.064, 0.091, 0.172, 0.109], "content": [{"type": "text", "content": "几个性质。"}]}, {"type": "text", "index": 3, "bbox": [0.109, 0.118, 0.235, 0.136], "content": [{"type": "text", "content": "(1) 极值性。"}]}, {"type": "equation", "index": 4, "bbox": [0.343, 0.146, 0.652, 0.164], "content": "I (X, Y) \\leqslant \\min (H (X), H (Y))"}, {"type": "text", "index": 5, "bbox": [0.107, 0.174, 0.621, 0.192], "content": [{"type": "text", "content": "极值性可以由互信息的定义和条件熵的非负性得到。"}]}, {"type": "text", "index": 6, "bbox": [0.109, 0.201, 0.236, 0.218], "content": [{"type": "text", "content": "(2) 上凸性。"}]}, {"type": "text", "index": 7, "bbox": [0.109, 0.228, 0.736, 0.246], "content": [{"type": "text", "content": "当 "}, {"type": "equation_inline", "content": "p(y|x)"}, {"type": "text", "content": " 固定时，"}, {"type": "equation_inline", "content": "I(X,Y)"}, {"type": "text", "content": " 为信源概率分布 "}, {"type": "equation_inline", "content": "p(x)"}, {"type": "text", "content": " 的上凸函数。"}]}, {"type": "text", "index": 8, "bbox": [0.065, 0.256, 0.931, 0.303], "content": [{"type": "text", "content": "事实上,设信源两种输入分布分别为  "}, {"type": "equation_inline", "content": "p_{1}(x)"}, {"type": "text", "content": " ,  "}, {"type": "equation_inline", "content": "p_{2}(x)"}, {"type": "text", "content": " ，对应的平均互信息分别记为  "}, {"type": "equation_inline", "content": "I[p_{1}(x)]"}, {"type": "text", "content": "  和  "}, {"type": "equation_inline", "content": "I[p_{2}(x)]"}, {"type": "text", "content": " 。"}]}, {"type": "text", "index": 9, "bbox": [0.108, 0.311, 0.33, 0.329], "content": [{"type": "text", "content": "取 "}, {"type": "equation_inline", "content": "0 < \\lambda < 1"}, {"type": "text", "content": " ，注意到"}]}, {"type": "equation", "index": 10, "bbox": [0.096, 0.336, 0.901, 0.635], "content": "\\begin{array}{r l} & {\\lambda I [ p _ {1} (x) ] + (1 - \\lambda) I [ p _ {2} (x) ] - I [ \\lambda p _ {1} (x) + (1 - \\lambda) p _ {2} (x) ]} \\\\ & {= \\lambda \\sum_ {x} \\sum_ {y} p _ {1} (x) p (y \\mid x) \\log \\frac {p (y \\mid x)}{p _ {1} (y)} + (1 - \\lambda) \\sum_ {x} \\sum_ {y} p _ {2} (x) p (y \\mid x) \\log \\frac {p (y \\mid x)}{p _ {2} (y)} -} \\\\ & {\\quad \\sum_ {x} \\sum_ {y} [ \\lambda p _ {1} (x) + (1 - \\lambda) p _ {2} (x) ] p (y \\mid x) \\log \\frac {p (y \\mid x)}{p (y)}} \\\\ & {= \\lambda \\sum_ {x} \\sum_ {y} p _ {1} (x) p (y \\mid x) \\log \\frac {p (y)}{p _ {1} (y)} + (1 - \\lambda) \\sum_ {x} \\sum_ {y} p _ {2} (x) p (y \\mid x) \\log \\frac {p (y)}{p _ {2} (y)}} \\\\ & {\\leqslant \\lambda \\log \\sum_ {y} \\frac {p (y)}{p _ {1} (y)} \\sum_ {x} p _ {1} (x) p (y \\mid x) + (1 - \\lambda) \\log \\sum_ {y} \\frac {p (y)}{p _ {2} (y)} \\sum_ {x} p _ {2} (x) p (y \\mid x)} \\\\ & {= \\lambda \\log \\sum_ {y} \\frac {p (y)}{p _ {1} (y)} p _ {1} (y) + (1 - \\lambda) \\log \\sum_ {y} \\frac {p (y)}{p _ {2} (y)} p _ {2} (y)} \\\\ & {= \\lambda \\log \\sum_ {y} p (y) + (1 - \\lambda) \\log \\sum_ {y} p (y) = 0} \\end{array}"}, {"type": "text", "index": 11, "bbox": [0.066, 0.637, 0.097, 0.653], "content": [{"type": "text", "content": "故"}]}, {"type": "equation", "index": 12, "bbox": [0.2, 0.662, 0.798, 0.684], "content": "\\lambda I [ p _ {1} (x) ] + (1 - \\lambda) I [ p _ {2} (x) ] \\leqslant I [ \\lambda p _ {1} (x) + (1 - \\lambda) p _ {2} (x) ]"}, {"type": "text", "index": 13, "bbox": [0.112, 0.692, 0.231, 0.709], "content": [{"type": "text", "content": "(3)下凸性。"}]}, {"type": "text", "index": 14, "bbox": [0.11, 0.719, 0.738, 0.737], "content": [{"type": "text", "content": "当输入 "}, {"type": "equation_inline", "content": "p(x)"}, {"type": "text", "content": " 固定时，"}, {"type": "equation_inline", "content": "I(X,Y)"}, {"type": "text", "content": " 是概率分布 "}, {"type": "equation_inline", "content": "p(y|x)"}, {"type": "text", "content": " 的上凸函数。"}]}, {"type": "text", "index": 15, "bbox": [0.067, 0.746, 0.933, 0.794], "content": [{"type": "text", "content": "设信源两种输入分布分别为 "}, {"type": "equation_inline", "content": "p_1(y|x)"}, {"type": "text", "content": " 和 "}, {"type": "equation_inline", "content": "p_2(y|x)"}, {"type": "text", "content": "，对应的平均互信息分别记为 "}, {"type": "equation_inline", "content": "I[p_1(y|x)]"}, {"type": "text", "content": " 和 "}, {"type": "equation_inline", "content": "I[p_2(y|x)]"}, {"type": "text", "content": "。取 "}, {"type": "equation_inline", "content": "0 < \\lambda < 1"}, {"type": "text", "content": "，下面分两步证明上凸性。"}]}, {"type": "text", "index": 16, "bbox": [0.109, 0.802, 0.917, 0.821], "content": [{"type": "text", "content": "① 设 "}, {"type": "equation_inline", "content": "D"}, {"type": "text", "content": " 是所有条件概率矩阵组成的集合, 如果 "}, {"type": "equation_inline", "content": "Q_{1}"}, {"type": "text", "content": " 和 "}, {"type": "equation_inline", "content": "Q_{2}"}, {"type": "text", "content": " 是两个条件概率矩阵, 满足"}]}, {"type": "equation", "index": 17, "bbox": [0.106, 0.83, 0.894, 0.861], "content": "Q _ {1} = [ p _ {1} (y \\mid x) ] _ {n \\times m}, \\sum_ {y} p _ {1} (y \\mid x) = 1; Q _ {2} = [ p _ {2} (y \\mid x) ] _ {n \\times m}, \\sum_ {y} p _ {2} (y \\mid x) = 1"}, {"type": "text", "index": 18, "bbox": [0.065, 0.866, 0.635, 0.885], "content": [{"type": "text", "content": "那么 "}, {"type": "equation_inline", "content": "Q = \\lambda Q_{1} + (1 - \\lambda)Q_{2}\\in D"}, {"type": "text", "content": " 也是条件概率矩阵。因为"}]}, {"type": "equation", "index": 19, "bbox": [0.294, 0.894, 0.705, 0.928], "content": "\\lambda \\sum_ {y} p _ {1} (y \\mid x) + (1 - \\lambda) \\sum_ {y} p _ {2} (y \\mid x) = 1"}]}, {"page_idx": 173, "blocks": [{"type": "header", "index": 0, "bbox": [0.391, 0.061, 0.572, 0.076], "content": [{"type": "text", "content": "第4章 信息论基础"}]}, {"type": "page_number", "index": 1, "bbox": [0.844, 0.063, 0.88, 0.077], "content": [{"type": "text", "content": "161"}]}, {"type": "text", "index": 2, "bbox": [0.049, 0.095, 0.217, 0.113], "content": [{"type": "text", "content": "所以， "}, {"type": "equation_inline", "content": "D"}, {"type": "text", "content": " 是凸域。"}]}, {"type": "text", "index": 3, "bbox": [0.093, 0.122, 0.287, 0.14], "content": [{"type": "text", "content": "② 下面只需要证明"}]}, {"type": "text", "index": 4, "bbox": [0.049, 0.187, 0.124, 0.205], "content": [{"type": "text", "content": "事实上"}]}, {"type": "equation", "index": 5, "bbox": [0.106, 0.147, 0.853, 0.686], "content": "\\begin{array}{l} \\lambda \\sum_ {y} p _ {1} (y \\mid x) + (1 - \\lambda) \\sum_ {y} p _ {2} (y \\mid x) \\leqslant I (\\lambda p _ {1} (y \\mid x) + (1 - \\lambda) p _ {2} (y \\mid x)) \\\\ \\text {上} \\\\ \\lambda \\sum_ {y} p _ {1} (y \\mid x) + (1 - \\lambda) \\sum_ {y} p _ {2} (y \\mid x) - I [ \\lambda p _ {1} (y \\mid x) + (1 - \\lambda) p _ {2} (y \\mid x) ] \\\\ = \\sum_ {x} \\sum_ {y} p (x) p (y \\mid x) \\log \\frac {p (y \\mid x)}{p (y)} - \\lambda \\sum_ {x} \\sum_ {y} p (x) p _ {1} (y \\mid x) \\log \\frac {p _ {1} (y \\mid x)}{p _ {1} (y)} - \\\\ (1 - \\lambda) \\sum_ {x} \\sum_ {y} p (x) p _ {2} (y \\mid x) \\log \\frac {p _ {2} (y \\mid x)}{p _ {2} (y)} \\\\ = \\lambda \\sum_ {x} \\sum_ {y} p (x) p _ {1} (y \\mid x) \\log \\frac {p (y \\mid x)}{p (y)} \\frac {p _ {1} (y)}{p _ {1} (y \\mid x)} + \\\\ (1 - \\lambda) \\sum_ {x} \\sum_ {y} p (x) p _ {2} (y \\mid x) \\log \\frac {p (y \\mid x)}{p (y)} \\frac {p _ {2} (y)}{p _ {2} (y \\mid x)} \\\\ \\leqslant \\lambda \\log \\sum_ {x} \\sum_ {y} p (x) p _ {1} (y \\mid x) \\frac {p (y \\mid x)}{p (y)} \\frac {p _ {1} (y)}{p _ {1} (y \\mid x)} + \\\\ (1 - \\lambda) \\log \\sum_ {x} \\sum_ {y} p (x) p _ {2} (y \\mid x) \\frac {p (y \\mid x)}{p (y)} \\frac {p _ {2} (y)}{p _ {2} (y \\mid x)} \\\\ = \\lambda \\log \\sum_ {x} \\sum_ {y} \\frac {p (x , y) p _ {1} (y)}{p (y)} + (1 - \\lambda) \\log \\sum_ {x} \\sum_ {y} \\frac {p (x , y) p _ {2} (y)}{p (x) p (y)} \\\\ = \\lambda \\log \\sum_ {y} \\frac {p _ {1} (y)}{p (y)} \\sum_ {x} p (x, y) + (1 - \\lambda) \\log \\sum_ {y} \\frac {p _ {2} (y)}{p (y)} \\sum_ {x} p (x, y) \\\\ = \\lambda \\log \\sum_ {y} p _ {1} (y) + (1 - \\lambda) \\log \\sum_ {y} p _ {2} (y) = 0 \\end{array}"}, {"type": "paragraph_title", "index": 6, "bbox": [0.049, 0.711, 0.251, 0.734], "content": [{"type": "text", "content": "4.5 离散信源"}], "level": 2}, {"type": "text", "index": 7, "bbox": [0.092, 0.768, 0.827, 0.787], "content": [{"type": "text", "content": "信源即信息的来源,根据消息所具有的随机性质不同,可以对信源进行分类。"}]}, {"type": "text", "index": 8, "bbox": [0.092, 0.796, 0.728, 0.815], "content": [{"type": "text", "content": "根据信源输出消息的不同的随机性质,可以将信源分为如下两类。"}]}, {"type": "text", "index": 9, "bbox": [0.048, 0.831, 0.918, 0.935], "content": [{"type": "text", "content": "离散信源:信源输出的消息数是有限的或可数的,每次只输出一个消息。如果信源符号集为有限集,则称为有限离散信源。如果信源符号集为无限集,则称为无限离散信源。英文、汉语或其他语言文字,用二进制代码传送的数据等,以及符号集都是有限的属于有限离散信源。离散信源的概率空间一般用如下的数学模型表示,即"}]}]}, {"page_idx": 174, "blocks": [{"type": "page_number", "index": 0, "bbox": [0.099, 0.056, 0.136, 0.069], "content": [{"type": "text", "content": "162"}]}, {"type": "header", "index": 1, "bbox": [0.419, 0.055, 0.581, 0.07], "content": [{"type": "text", "content": "信息安全数学基础"}]}, {"type": "equation", "index": 2, "bbox": [0.19, 0.093, 0.806, 0.141], "content": "\\left[ \\begin{array}{l} X \\\\ p (x) \\end{array} \\right] = \\left[ \\begin{array}{c c c c} a _ {1} & a _ {2} & \\dots & a _ {q} \\\\ p (a _ {1}) & p (a _ {2}) & \\dots & p (a _ {q}) \\end{array} \\right] \\quad (\\sum_ {i = 1} ^ {q} p (a _ {i}) = 1)"}, {"type": "text", "index": 3, "bbox": [0.065, 0.156, 0.936, 0.367], "content": [{"type": "text", "content": "连续信源:信源输出的消息数是无限的或不可数的,每次只输出一个消息。如果一个信源的输出仅发生在离散时间间隔而取值是连续的,就称为离散时间连续信源,简称连续信源。如果一个信源的输出是时间和取值都连续的波形,就称这一类信源为连续时间信源,简称波形信源或模拟信源。日常常见的语音信号、视频信号、广播信号及电视信号等都是波形信源。把波形信源在时间上离散化就可以得到离散时间连续信源。因此,波形信源的熵可通过研究连续信源来计算;而对于连续信源熵的研究,又可以通过在信源取值上的离散化(变成离散信源)来实现。连续信源的概率空间一般用如下的数学模型表示,即"}]}, {"type": "equation", "index": 4, "bbox": [0.292, 0.379, 0.714, 0.425], "content": "\\left[ \\begin{array}{l} X \\\\ p (x) \\end{array} \\right] = \\left[ \\begin{array}{l} (a, b) \\\\ p (x) \\end{array} \\right] \\quad (\\int_ {a} ^ {b} p (x) \\mathrm{d} x = 1)"}, {"type": "text", "index": 5, "bbox": [0.067, 0.433, 0.935, 0.508], "content": [{"type": "text", "content": "根据信源 X 的平稳性与否,可以将信源分为平稳信源与非平稳信源。非平稳信源输出的随机序列的统计特征比较复杂,分析起来也很困难,所以下面只考虑平稳信源分类,主要包括连续平稳信源、离散平稳信源。"}]}, {"type": "text", "index": 6, "bbox": [0.067, 0.523, 0.935, 0.598], "content": [{"type": "text", "content": "连续平稳信源:信源输出的随机序列  "}, {"type": "equation_inline", "content": "X=(X_{1},X_{2},\\cdots,X_{N})"}, {"type": "text", "content": "  中  "}, {"type": "equation_inline", "content": "X_{i}(i=1,2,\\cdots,N)"}, {"type": "text", "content": "  为取值连续的随机变量，X 的各维概率密度函数都与时间起点无关(任意两个不同时刻 X 的各维概率密度函数都相同)。"}]}, {"type": "text", "index": 7, "bbox": [0.068, 0.614, 0.935, 0.661], "content": [{"type": "text", "content": "离散无记忆平稳信源:信源输出的随机序列  "}, {"type": "equation_inline", "content": "X=(X_{1},X_{2},\\cdots,X_{N})"}, {"type": "text", "content": "  中离散随机变量  "}, {"type": "equation_inline", "content": "X_{i}(i=1,2,\\cdots,N)"}, {"type": "text", "content": "  是统计独立的,并且各  "}, {"type": "equation_inline", "content": "X_{i}"}, {"type": "text", "content": "  取值于同一概率空间 X。"}]}, {"type": "text", "index": 8, "bbox": [0.065, 0.677, 0.936, 0.751], "content": [{"type": "text", "content": "离散无记忆的扩展信源:设信源 X 是一个离散无记忆的信源,其信源 X 的符号集为  "}, {"type": "equation_inline", "content": "A=\\{a_{1},a_{2},\\cdots,a_{q}\\}"}, {"type": "text", "content": " , 信源每次发出一个符号,且符号发生的概率相互独立,信源概率空间为"}]}, {"type": "equation", "index": 9, "bbox": [0.212, 0.763, 0.796, 0.81], "content": "\\left[ \\begin{array}{c} X \\\\ P (x) \\end{array} \\right] = \\left[ \\begin{array}{c c c c} a _ {1} & a _ {2} & \\dots & a _ {q} \\\\ p (a _ {1}) & p (a _ {2}) & \\dots & p (a _ {q}) \\end{array} \\right] \\quad (\\sum_ {i = 1} ^ {q} p _ {i} = 1)"}, {"type": "text", "index": 10, "bbox": [0.068, 0.818, 0.859, 0.837], "content": [{"type": "text", "content": "则信源 "}, {"type": "equation_inline", "content": "X"}, {"type": "text", "content": " 的 "}, {"type": "equation_inline", "content": "N"}, {"type": "text", "content": " 次扩展信源 "}, {"type": "equation_inline", "content": "X^{N}"}, {"type": "text", "content": " 是具有 "}, {"type": "equation_inline", "content": "q^{N}"}, {"type": "text", "content": " 个符号的离散信源, 其 "}, {"type": "equation_inline", "content": "N"}, {"type": "text", "content": " 重概率空间为"}]}, {"type": "equation", "index": 11, "bbox": [0.294, 0.849, 0.711, 0.897], "content": "\\left[ \\begin{array}{c} X ^ {N} \\\\ P (X ^ {N}) \\end{array} \\right] = \\left[ \\begin{array}{c c c c} \\alpha_ {1} & \\alpha_ {2} & \\dots & \\alpha_ {q ^ {N}} \\\\ p (\\alpha_ {1}) & p (\\alpha_ {2}) & \\dots & p (\\alpha_ {q ^ {N}}) \\end{array} \\right]"}, {"type": "text", "index": 12, "bbox": [0.068, 0.906, 0.936, 0.925], "content": [{"type": "text", "content": "式中符号 "}, {"type": "equation_inline", "content": "\\alpha_{i}"}, {"type": "text", "content": " 对应由 "}, {"type": "equation_inline", "content": "N"}, {"type": "text", "content": " 个 "}, {"type": "equation_inline", "content": "a_{i}"}, {"type": "text", "content": " 组成的序列，此时符号 "}, {"type": "equation_inline", "content": "\\alpha_{i}"}, {"type": "text", "content": " 的概率 "}, {"type": "equation_inline", "content": "p(\\alpha_{i})"}, {"type": "text", "content": " 是 "}, {"type": "equation_inline", "content": "N"}, {"type": "text", "content": " 个 "}, {"type": "equation_inline", "content": "a_{i_k}"}, {"type": "text", "content": " 组成的序列"}]}]}, {"page_idx": 175, "blocks": [{"type": "header", "index": 0, "bbox": [0.388, 0.063, 0.569, 0.079], "content": [{"type": "text", "content": "第4章 信息论基础"}]}, {"type": "page_number", "index": 1, "bbox": [0.841, 0.065, 0.878, 0.078], "content": [{"type": "text", "content": "163"}]}, {"type": "text", "index": 2, "bbox": [0.046, 0.097, 0.912, 0.164], "content": [{"type": "text", "content": "的概率, 满足  "}, {"type": "equation_inline", "content": "p(\\alpha_{i}) = p(a_{i_{1}})p(a_{i_{2}})\\cdots p(a_{i_{N}})"}, {"type": "text", "content": " ，且  "}, {"type": "equation_inline", "content": "\\sum_{i=1}^{q^{N}} p(\\alpha_{i}) = 1"}, {"type": "text", "content": " 。利用熵的定义, 可得 N 次扩展信源的熵为"}], "continues_prev": true}, {"type": "equation", "index": 3, "bbox": [0.196, 0.172, 0.754, 0.218], "content": "H (X ^ {N}) = - \\sum_ {X ^ {N}} P (X ^ {N}) \\log P (X ^ {N}) = - \\sum_ {i = 1} ^ {q ^ {N}} p (\\alpha_ {i}) \\log p (\\alpha_ {i})"}, {"type": "text", "index": 4, "bbox": [0.089, 0.234, 0.909, 0.294], "content": [{"type": "text", "content": "例 4.13 设信源 X 的概率空间为  "}, {"type": "equation_inline", "content": "\\begin{bmatrix} X \\\\ p(x) \\end{bmatrix} = \\begin{bmatrix} a_{1} & a_{2} & a_{3} \\\\ \\frac{1}{2} & \\frac{1}{4} & \\frac{1}{4} \\end{bmatrix}"}, {"type": "text", "content": " ，试求  "}, {"type": "equation_inline", "content": "H(X)"}, {"type": "text", "content": "  和  "}, {"type": "equation_inline", "content": "H(X^{2})"}, {"type": "text", "content": " 。"}]}, {"type": "text", "index": 5, "bbox": [0.091, 0.334, 0.766, 0.373], "content": [{"type": "text", "content": "解 "}, {"type": "equation_inline", "content": "H(X) = -\\sum_{i=1}^{3} p(a_i) \\log p(a_i) = \\frac{1}{2} \\log 2 + 2 \\times \\frac{1}{4} \\log 4 = 1.5 \\mathrm{~bit}"}]}, {"type": "text", "index": 6, "bbox": [0.091, 0.382, 0.4, 0.4], "content": [{"type": "text", "content": "通过计算可知 "}, {"type": "equation_inline", "content": "X^{2}"}, {"type": "text", "content": " 的概率空间为"}]}, {"type": "equation", "index": 7, "bbox": [0.134, 0.412, 0.825, 0.471], "content": "\\left[ \\begin{array}{l} X ^ {2} \\\\ p (x ^ {2}) \\end{array} \\right] = \\left[ \\begin{array}{c c c c c c c c c} a _ {1} a _ {1} & a _ {1} a _ {2} & a _ {1} a _ {3} & a _ {2} a _ {1} & a _ {2} a _ {2} & a _ {2} a _ {3} & a _ {3} a _ {1} & a _ {3} a _ {2} & a _ {3} a _ {3} \\\\ \\frac {1}{4} & \\frac {1}{8} & \\frac {1}{8} & \\frac {1}{8} & \\frac {1}{1 6} & \\frac {1}{1 6} & \\frac {1}{8} & \\frac {1}{1 6} & \\frac {1}{1 6} \\end{array} \\right]"}, {"type": "text", "index": 8, "bbox": [0.048, 0.481, 0.079, 0.499], "content": [{"type": "text", "content": "则"}]}, {"type": "equation", "index": 9, "bbox": [0.137, 0.509, 0.823, 0.598], "content": "\\begin{array}{r l} H (X ^ {2}) & = - \\sum_ {i = 1} ^ {q ^ {N}} p (\\alpha_ {i}) \\log p (\\alpha_ {i}) = - \\sum_ {i _ {1} = 1} ^ {3} \\sum_ {i _ {2} = 1} ^ {3} p (a _ {i _ {1}}) p (a _ {i _ {2}}) \\log p (a _ {i _ {1}}) p (a _ {i _ {2}}) \\\\ & = \\frac {1}{4} \\log 4 + 4 \\times \\frac {1}{8} \\log 8 + 4 \\times \\frac {1}{1 6} \\log 1 6 = 3 \\text {bit} \\end{array}"}, {"type": "text", "index": 10, "bbox": [0.049, 0.609, 0.289, 0.626], "content": [{"type": "text", "content": "所以 "}, {"type": "equation_inline", "content": "H(X^{2}) = 2H(X)"}, {"type": "text", "content": "。"}]}, {"type": "text", "index": 11, "bbox": [0.092, 0.636, 0.897, 0.655], "content": [{"type": "text", "content": "定理 4.6 离散无记忆信源 X 的 N 次扩展信源  "}, {"type": "equation_inline", "content": "X^{N}"}, {"type": "text", "content": "  的熵满足: "}, {"type": "equation_inline", "content": "H(X^{N}) = NH(X)"}, {"type": "text", "content": " 。"}]}, {"type": "text", "index": 12, "bbox": [0.092, 0.672, 0.811, 0.692], "content": [{"type": "text", "content": "证明 记  "}, {"type": "equation_inline", "content": "p_{i_{1}} = p(a_{i_{1}})"}, {"type": "text", "content": " ，设  "}, {"type": "equation_inline", "content": "\\alpha_{i} = (a_{i_{1}}, a_{i_{2}}, \\cdots, a_{i_{N}})"}, {"type": "text", "content": " ，根据信源的无记忆性有"}]}, {"type": "equation", "index": 13, "bbox": [0.229, 0.699, 0.735, 0.722], "content": "P (\\alpha_ {i}) = p _ {i _ {1}} p _ {i _ {2}} \\dots p _ {i _ {N}} \\quad i _ {1}, i _ {2}, \\dots , i _ {N} = 1, 2, \\dots , q"}, {"type": "text", "index": 14, "bbox": [0.05, 0.727, 0.441, 0.771], "content": [{"type": "text", "content": "由于 "}, {"type": "equation_inline", "content": "H(X^{N}) = -\\sum_{i = 1}^{q^{N}}p(\\alpha_{i})\\log p(\\alpha_{i})"}, {"type": "text", "content": " ，则"}]}, {"type": "equation", "index": 15, "bbox": [0.092, 0.776, 0.869, 0.935], "content": "\\begin{array}{l} H (X ^ {N}) = \\sum_ {i = 1} ^ {q ^ {N}} p (\\alpha_ {i}) \\log \\frac {1}{p _ {i _ {1}} p _ {i _ {2}} \\cdots p _ {i _ {N}}} \\\\ = \\sum_ {i = 1} ^ {q ^ {N}} P (\\alpha_ {i}) \\log \\frac {1}{p _ {i _ {1}}} + \\sum_ {i = 1} ^ {q ^ {N}} P (\\alpha_ {i}) \\log \\frac {1}{p _ {i _ {2}}} + \\dots + \\sum_ {i = 1} ^ {q ^ {N}} P (\\alpha_ {i}) \\log \\frac {1}{p _ {i _ {N}}} \\\\ \\sum_ {i = 1} ^ {q ^ {N}} p (\\alpha_ {i}) \\log \\frac {1}{p _ {i _ {1}}} = \\sum_ {i = 1} ^ {q ^ {N}} p _ {i _ {1}} p _ {i _ {2}} \\dots p _ {i _ {N}} \\log \\frac {1}{p _ {i _ {1}}} = \\sum_ {i _ {1} = 1} ^ {q} p _ {i _ {1}} \\log \\frac {1}{p _ {i _ {1}}} \\sum_ {i _ {2} = 1} ^ {q} p _ {i _ {2}} \\dots \\sum_ {i _ {N} = 1} ^ {q} p _ {i _ {N}} \\end{array}"}]}, {"page_idx": 176, "blocks": [{"type": "page_number", "index": 0, "bbox": [0.102, 0.059, 0.138, 0.072], "content": [{"type": "text", "content": "164"}]}, {"type": "header", "index": 1, "bbox": [0.421, 0.058, 0.583, 0.073], "content": [{"type": "text", "content": "信息安全数学基础"}]}, {"type": "equation", "index": 2, "bbox": [0.068, 0.093, 0.74, 0.155], "content": "\\begin{array}{r l} & = \\sum_ {i _ {1} = 1} ^ {q} p _ {i _ {1}} \\log \\frac {1}{p _ {i _ {1}}} = H (X) \\\\ \\text {所以} H (X) = H (X ^ {N}) = H (X) + H (X) + \\dots + H (X) = N H (X). \\end{array}"}, {"type": "text", "index": 3, "bbox": [0.066, 0.164, 0.934, 0.21], "content": [{"type": "text", "content": "离散平稳有记忆信源:若具有有限符号集 "}, {"type": "equation_inline", "content": "A = \\{a_{1}, a_{2}, \\cdots, a_{n}\\}"}, {"type": "text", "content": " 的信源 "}, {"type": "equation_inline", "content": "X"}, {"type": "text", "content": " 产生随机序列 "}, {"type": "equation_inline", "content": "\\{x\\}"}, {"type": "text", "content": " 满足:对所有 "}, {"type": "equation_inline", "content": "\\{i_{1}, i_{2}, \\cdots, i_{N}\\}"}, {"type": "text", "content": "，以及 "}, {"type": "equation_inline", "content": "\\{j_{1}, j_{2}, \\cdots, j_{N}\\}"}, {"type": "text", "content": "，有"}]}, {"type": "equation", "index": 4, "bbox": [0.094, 0.219, 0.905, 0.239], "content": "p (x _ {i _ {1}} = a _ {j _ {1}}, x _ {i _ {2}} = a _ {j _ {2}}, \\dots , x _ {i _ {N}} = a _ {j _ {N}}) = p (x _ {i _ {1} + h} = a _ {j _ {1}}, x _ {i _ {2} + h} = a _ {j _ {2}}, \\dots , x _ {i _ {N + h}} = a _ {j _ {N}})"}, {"type": "text", "index": 5, "bbox": [0.067, 0.244, 0.592, 0.263], "content": [{"type": "text", "content": "则称信源为离散平稳信源,所产生的序列为平稳序列。"}]}, {"type": "text", "index": 6, "bbox": [0.069, 0.271, 0.935, 0.317], "content": [{"type": "text", "content": "可见,平稳序列的统计特性与时间的推移无关,即序列中符号的任意维联合概率分布与时间起点无关。这种平稳性通常简记为"}]}, {"type": "equation", "index": 7, "bbox": [0.279, 0.326, 0.722, 0.347], "content": "p (x _ {i _ {1}}, x _ {i _ {2}}, \\dots , x _ {i _ {N}}) = p (x _ {i _ {1} + h}, x _ {i _ {2} + h}, \\dots , x _ {i _ {N + h}})"}, {"type": "text", "index": 8, "bbox": [0.068, 0.353, 0.101, 0.371], "content": [{"type": "text", "content": "或"}]}, {"type": "equation", "index": 9, "bbox": [0.292, 0.381, 0.711, 0.399], "content": "p (x _ {i}, x _ {i + 1}, \\dots , x _ {i + N}) = p (x _ {j}, x _ {j + 1}, \\dots , x _ {j + N})"}, {"type": "text", "index": 10, "bbox": [0.069, 