 - 1} S) & = \\sum_ {j = 1} ^ {J} P (s _ {1} = E _ {j}) H (X _ {L} \\mid X _ {1} X _ {2} \\dots X _ {L - 1} s _ {1} = E _ {j}) \\\\ & = \\sum_ {j = 1} ^ {J} \\sum_ {i = 1} ^ {J} P (s _ {1} = E _ {j}) P (s _ {L} = E _ {i} \\mid s _ {1} = E _ {j}) H (X \\mid s = E _ {i}) \\\\ & = \\sum_ {i = 1} ^ {J} P (s _ {L} = E _ {i}) H (X \\mid s = E _ {i}) \\end{array} \\tag {4}\\tag{4.8}"}]}, {"page_idx": 184, "blocks": [{"type": "page_number", "index": 0, "bbox": [0.092, 0.054, 0.128, 0.068], "content": [{"type": "text", "content": "172"}]}, {"type": "header", "index": 1, "bbox": [0.412, 0.052, 0.574, 0.068], "content": [{"type": "text", "content": "信息安全数学基础"}]}, {"type": "text", "index": 2, "bbox": [0.057, 0.087, 0.926, 0.134], "content": [{"type": "text", "content": "式中， "}, {"type": "equation_inline", "content": "P(s_{L}=E_{i})"}, {"type": "text", "content": " 是信源的状态马尔可夫链的绝对概率。它表示L时刻信源处于状态 "}, {"type": "equation_inline", "content": "E_{i}"}, {"type": "text", "content": " 的概率。一般情况，它与马氏链的初始概率分布和状态一步转移概率有关。"}]}, {"type": "text", "index": 3, "bbox": [0.102, 0.142, 0.382, 0.16], "content": [{"type": "text", "content": "将式(4.8)代入式(4.4)得到"}]}, {"type": "equation", "index": 4, "bbox": [0.195, 0.166, 0.924, 0.255], "content": "\\begin{array}{r l} \\frac {1}{N} H (X _ {1} X _ {2} \\dots X _ {N} \\mid S) & = \\frac {1}{N} \\sum_ {L = 1} ^ {N} \\sum_ {i = 1} ^ {J} P (s _ {L} = E _ {i}) H (X \\mid s = E _ {i}) \\\\ & = \\sum_ {i = 1} ^ {J} q _ {N} (E _ {i}) H (X \\mid s = E _ {i}) \\end{array}\\tag{4.9}"}, {"type": "text", "index": 5, "bbox": [0.058, 0.261, 0.927, 0.327], "content": [{"type": "text", "content": "这里  "}, {"type": "equation_inline", "content": "q_{N}(E_{i})=\\frac{1}{N}\\sum_{L=1}^{N}P(s_{L}=E_{i})"}, {"type": "text", "content": " ，表示在 L=1 到 L=N 时间内，状态  "}, {"type": "equation_inline", "content": "E_{i}"}, {"type": "text", "content": "  出现概率的平均值。将式(4.9)代入式(4.3)得到"}]}, {"type": "equation", "index": 6, "bbox": [0.196, 0.335, 0.925, 0.419], "content": "\\begin{array}{l} H _ {\\infty} = H _ {\\infty} (X) = \\lim _ {N \\to \\infty} \\frac {1}{N} H (X _ {1} \\dots X _ {N} \\mid S) \\\\ = \\lim _ {N \\to \\infty} \\sum_ {i = 1} ^ {J} q _ {N} (E _ {i}) H (X \\mid s = E _ {i}) = \\sum_ {i = 1} ^ {J} q _ {\\infty} (E _ {i}) H (X \\mid E _ {i}) \\end{array}\\tag{4.10}"}, {"type": "text", "index": 7, "bbox": [0.06, 0.425, 0.929, 0.485], "content": [{"type": "text", "content": "这里  "}, {"type": "equation_inline", "content": "q_{\\infty}(E_{i})=\\lim_{N\\to\\infty}\\sum_{L=1}^{N}P(s_{L}=E_{i})"}, {"type": "text", "content": "  与初始状态概率分布有关，对于时齐的、遍历的马尔可夫链，其极限概率  "}, {"type": "equation_inline", "content": "Q(E_{i})"}, {"type": "text", "content": "  存在，即"}]}, {"type": "equation", "index": 8, "bbox": [0.203, 0.493, 0.926, 0.52], "content": "\\lim _ {N \\to \\infty} P (s _ {N} = E _ {i} \\mid s _ {1} = E _ {j}) = \\lim _ {N \\to \\infty} P _ {j _ {i}} ^ {(N)} = Q (E _ {i}) \\quad E _ {i} \\in E\\tag{4.11}"}, {"type": "text", "index": 9, "bbox": [0.062, 0.524, 0.116, 0.542], "content": [{"type": "text", "content": "并有"}]}, {"type": "equation", "index": 10, "bbox": [0.241, 0.551, 0.75, 0.619], "content": "\\begin{array}{r l} P (s _ {L} = E _ {i}) & = \\sum_ {j = 1} ^ {J} P (s _ {1} = E _ {j}) P (s _ {L} = E _ {i} \\mid s _ {1} = E _ {j}) \\\\ \\lim _ {L \\to \\infty} P (s _ {N} = E _ {i}) & = Q (E _ {i}) \\quad E _ {i} \\in E \\end{array}"}, {"type": "text", "index": 11, "bbox": [0.063, 0.624, 0.376, 0.641], "content": [{"type": "text", "content": "因此时齐、遍历的马尔可夫信源"}]}, {"type": "equation", "index": 12, "bbox": [0.212, 0.646, 0.927, 0.687], "content": "q _ {\\infty} (E _ {i}) = \\lim _ {N \\to \\infty} \\frac {1}{N} \\sum_ {L = 1} ^ {N} P (s _ {L} = E _ {i}) = Q (E _ {i}) \\quad i = 1, \\dots , J\\tag{4.12}"}, {"type": "text", "index": 13, "bbox": [0.063, 0.695, 0.895, 0.713], "content": [{"type": "text", "content": "可见 L 值足够大, 时间足够长后, 状态绝对概率与初始概率分布无关, 而且  "}, {"type": "equation_inline", "content": "Q(E_{i})"}, {"type": "text", "content": "  满足"}]}, {"type": "equation", "index": 14, "bbox": [0.344, 0.723, 0.927, 0.757], "content": "\\sum_ {E _ {j} \\in E} Q (E _ {j}) P (E _ {i} \\mid E _ {j}) = Q (E _ {i})\\tag{4.13}"}, {"type": "equation", "index": 15, "bbox": [0.423, 0.762, 0.928, 0.796], "content": "\\sum_ {E _ {i} \\in E} Q (E _ {i}) = 1\\tag{4.14}"}, {"type": "text", "index": 16, "bbox": [0.063, 0.801, 0.932, 0.874], "content": [{"type": "text", "content": "由上面讨论可知,马尔可夫信源经过足够长的时间后,状态可以到达一种稳定的分布,具体分布是由式(4.13)和式(4.14)决定的,从而可得时齐、遍历的马尔可夫信源的熵为"}]}, {"type": "equation", "index": 17, "bbox": [0.151, 0.882, 0.929, 0.924], "content": "H _ {\\infty} = \\sum_ {i = 1} ^ {J} Q (E _ {i}) H (X \\mid E _ {i}) = - \\sum_ {i = 1} ^ {J} \\sum_ {k = 1} ^ {q} Q (E _ {i}) P (a _ {k} \\mid E _ {i}) \\log P (a _ {k} \\mid E _ {i})\\tag{4.15}"}]}, {"page_idx": 185, "blocks": [{"type": "header", "index": 0, "bbox": [0.395, 0.063, 0.576, 0.079], "content": [{"type": "text", "content": "第4章 信息论基础"}]}, {"type": "page_number", "index": 1, "bbox": [0.849, 0.064, 0.887, 0.078], "content": [{"type": "text", "content": "173"}]}, {"type": "text", "index": 2, "bbox": [0.053, 0.097, 0.921, 0.173], "content": [{"type": "text", "content": "对于一阶马尔可夫信源,信源发出的符号只与前一个符号有关,所以给定的条件概率为  "}, {"type": "equation_inline", "content": "P(a_{k} \\mid a_{k-1})"}, {"type": "text", "content": "  。因此,状态集就是符号集,状态极限概率  "}, {"type": "equation_inline", "content": "Q(E_{i})"}, {"type": "text", "content": "  等于信源达到平稳以后信源符号的概率分布  "}, {"type": "equation_inline", "content": "P(a_{k})"}, {"type": "text", "content": "  。"}]}, {"type": "text", "index": 3, "bbox": [0.097, 0.182, 0.309, 0.199], "content": [{"type": "text", "content": "设此时的概率空间为"}]}, {"type": "equation", "index": 4, "bbox": [0.246, 0.212, 0.722, 0.259], "content": "X: \\left[ \\begin{array}{c c c c} a _ {1} & a _ {2} & \\dots & a _ {q} \\\\ p (a _ {2} \\mid a _ {1}) & p (a _ {3} \\mid a _ {2}) & \\dots & p (a _ {q + 1} \\mid a _ {q}) \\end{array} \\right]"}, {"type": "text", "index": 5, "bbox": [0.054, 0.269, 0.921, 0.306], "content": [{"type": "text", "content": "又因为  "}, {"type": "equation_inline", "content": "\\sum_{k=1}^{q}P(a_{k} \\mid a_{k-1}) = 1 \\quad (k-1 = 1,2,\\cdots,q)"}, {"type": "text", "content": " ，其马氏链空间为  "}, {"type": "equation_inline", "content": "E = [a_{1}, a_{2}, \\cdots, a_{q}]"}, {"type": "text", "content": " ，得"}]}, {"type": "equation", "index": 6, "bbox": [0.136, 0.311, 0.84, 0.33], "content": "P (a _ {k} \\mid E _ {i}) = P (a _ {k} \\mid a _ {k - 1}) \\quad k = 1, 2, \\dots , q \\quad i = k - 1 = 1, 2, \\dots , q"}, {"type": "text", "index": 7, "bbox": [0.054, 0.339, 0.92, 0.387], "content": [{"type": "text", "content": "而状态极限概率满足  "}, {"type": "equation_inline", "content": "Q(E_{i}) = P(a_{k-1})(i = k - 1 = 1, 2, \\cdots, q)"}, {"type": "text", "content": " ，所以一阶马尔可夫信源的信息熵为"}]}, {"type": "equation", "index": 8, "bbox": [0.082, 0.396, 0.892, 0.435], "content": "H _ {\\infty} = H _ {2} = \\sum_ {i = 1} ^ {J} Q (E _ {i}) H (X \\mid E _ {i}) = - \\sum_ {k = 1} ^ {q} \\sum_ {k - 1 = 1} ^ {q} P (a _ {k - 1}) P (a _ {k} \\mid a _ {k - 1}) \\log P (a _ {k} \\mid a _ {k - 1})"}, {"type": "text", "index": 9, "bbox": [0.055, 0.439, 0.431, 0.458], "content": [{"type": "text", "content": "即一阶马尔可夫信源的熵等于条件熵。"}]}, {"type": "text", "index": 10, "bbox": [0.098, 0.475, 0.763, 0.493], "content": [{"type": "text", "content": "例 4.15 给定由符号集 "}, {"type": "equation_inline", "content": "\\{0,1\\}"}, {"type": "text", "content": " 组成的二阶马尔可夫链,其转移概率为"}]}, {"type": "equation", "index": 11, "bbox": [0.113, 0.502, 0.863, 0.521], "content": "p (0 \\mid 0 0) = 0. 8, \\quad p (0 \\mid 1 1) = 0. 2, \\quad p (1 \\mid 0 0) = 0. 2, \\quad p (1 \\mid 1 1) = 0. 8"}, {"type": "equation", "index": 12, "bbox": [0.114, 0.529, 0.863, 0.549], "content": "p (0 \\mid 0 1) = 0. 5, \\quad p (0 \\mid 1 0) = 0. 5, \\quad p (1 \\mid 0 1) = 0. 5, \\quad p (1 \\mid 1 0) = 0. 5"}, {"type": "text", "index": 13, "bbox": [0.055, 0.557, 0.298, 0.575], "content": [{"type": "text", "content": "计算各状态的稳态概率。"}]}, {"type": "text", "index": 14, "bbox": [0.098, 0.585, 0.552, 0.603], "content": [{"type": "text", "content": "解 根据已知条件,可以列出转移概率矩阵为"}]}, {"type": "equation", "index": 15, "bbox": [0.345, 0.615, 0.626, 0.717], "content": "\\boldsymbol {P} = \\left[ \\begin{array}{c c c c} 0. 8 & 0. 2 & 0 & 0 \\\\ 0 & 0 & 0. 5 & 0. 5 \\\\ 0. 5 & 0. 5 & 0 & 0 \\\\ 0 & 0 & 0. 2 & 0. 8 \\end{array} \\right]"}, {"type": "text", "index": 16, "bbox": [0.057, 0.726, 0.388, 0.743], "content": [{"type": "text", "content": "马尔可夫链状态图如图 4.6 所示。"}]}, {"type": "image", "index": 17, "bbox": [0.278, 0.749, 0.705, 0.916], "content": [{"type": "image_body", "index": 17, "bbox": [0.278, 0.749, 0.705, 0.916], "content": ""}, {"type": "image_caption", "index": 18, "bbox": [0.338, 0.927, 0.643, 0.944], "content": [{"type": "text", "content": "图 4.6 例 4.15 马尔可夫链状态图"}]}]}]}, {"page_idx": 186, "blocks": [{"type": "page_number", "index": 0, "bbox": [0.097, 0.058, 0.133, 0.071], "content": [{"type": "text", "content": "174"}]}, {"type": "header", "index": 1, "bbox": [0.416, 0.057, 0.579, 0.072], "content": [{"type": "text", "content": "信息安全数学基础"}]}, {"type": "text", "index": 2, "bbox": [0.107, 0.092, 0.898, 0.158], "content": [{"type": "text", "content": "设各状态 00,01,10,11 的稳态分布概率为 "}, {"type": "equation_inline", "content": "W_{1}, W_{2}, W_{3}, W_{4}"}, {"type": "text", "content": ", 有 "}, {"type": "equation_inline", "content": "\\left\\{ \\begin{array}{l} WP = W \\\\ \\sum_{i=1}^{4} W_{i} = 1 \\end{array} \\right."}, {"type": "text", "content": ", 即得"}]}, {"type": "equation", "index": 3, "bbox": [0.363, 0.162, 0.633, 0.294], "content": "\\left\\{ \\begin{array}{l} 0. 8 W _ {1} + 0. 5 W _ {3} = W _ {1} \\\\ 0. 2 W _ {1} + 0. 5 W _ {3} = W _ {2} \\\\ 0. 5 W _ {2} + 0. 2 W _ {4} = W _ {3} \\\\ 0. 5 W _ {2} + 0. 8 W _ {4} = W _ {4} \\\\ W _ {1} + W _ {2} + W _ {3} + W _ {4} = 1 \\end{array} \\right."}, {"type": "text", "index": 4, "bbox": [0.063, 0.302, 0.689, 0.321], "content": [{"type": "text", "content": "求解方程组得到 "}, {"type": "equation_inline", "content": "W_{1} = 5 / 14, W_{2} = 1 / 7, W_{3} = 1 / 7, W_{4} = 5 / 14"}, {"type": "text", "content": "。"}]}, {"type": "text", "index": 5, "bbox": [0.062, 0.33, 0.932, 0.46], "content": [{"type": "text", "content": "前面已经讨论了离散平稳信源,但是在实际应用中离散信源可能是非平稳的,对于这样的信源, "}, {"type": "equation_inline", "content": "H_{\\infty}"}, {"type": "text", "content": " 不一定存在。为了方便,这里假设它是平稳的,用 "}, {"type": "equation_inline", "content": "H_{\\infty}"}, {"type": "text", "content": " 来近似。但是即使是平稳的信源,计算 "}, {"type": "equation_inline", "content": "H_{\\infty}"}, {"type": "text", "content": " 也是极其困难。所以进一步假设它是 "}, {"type": "equation_inline", "content": "m"}, {"type": "text", "content": " 阶马尔可夫信源,用 "}, {"type": "equation_inline", "content": "m"}, {"type": "text", "content": " 阶马尔可夫信源的条件熵 "}, {"type": "equation_inline", "content": "H_{m+1}"}, {"type": "text", "content": " 来近似,即对于一般的离散信源都可以近似用不同记忆长度的马尔可夫信源来逼近。"}]}, {"type": "text", "index": 6, "bbox": [0.063, 0.468, 0.932, 0.543], "content": [{"type": "text", "content": "由于信源符号间的依赖关系,使信源的熵减小。所以若前后依赖关系的长度越长,则信源的熵越小。信源符号之间依赖关系越强,每个符号提供的平均信息量越少。每个符号提供的平均自信息量随着符号间的依赖关系长度的增加而减少。"}]}, {"type": "text", "index": 7, "bbox": [0.063, 0.557, 0.932, 0.678], "content": [{"type": "text", "content": "定义 4.16 一个信源实际的信息熵与具有同样符号集的最大熵的比值称为相对率，其表达式为  "}, {"type": "equation_inline", "content": "\\eta = \\frac{H_{\\infty}}{H_{0}}"}, {"type": "text", "content": " 。其中  "}, {"type": "equation_inline", "content": "H_{\\infty}"}, {"type": "text", "content": "  是信源的实际熵， "}, {"type": "equation_inline", "content": "H_{0} = \\log q"}, {"type": "text", "content": "  为符号独立等概率时信源的熵，其值是有 q 个符号信源的最大熵，即信源每个符号能携带的最大信息量为  "}, {"type": "equation_inline", "content": "H_{0}"}, {"type": "text", "content": " ，而实际上携带  "}, {"type": "equation_inline", "content": "H_{\\infty}"}, {"type": "text", "content": "  的信息。"}]}, {"type": "text", "index": 8, "bbox": [0.109, 0.695, 0.819, 0.728], "content": [{"type": "text", "content": "定义4.17 减去熵的相对率称为信源剩余度，记为 "}, {"type": "equation_inline", "content": "\\gamma = 1 - \\eta = 1 - \\frac{H_{\\infty}}{H_0}"}, {"type": "text", "content": "。"}]}, {"type": "text", "index": 9, "bbox": [0.064, 0.738, 0.933, 0.895], "content": [{"type": "text", "content": "信源剩余度的大小反映了离散信源输出的符号序列中符号之间依赖关系的强弱。剩余度  "}, {"type": "equation_inline", "content": "\\gamma"}, {"type": "text", "content": "  越大，表示信源的实际熵  "}, {"type": "equation_inline", "content": "H_{0}"}, {"type": "text", "content": "  。越小，说明信源符号之间依赖关系越强。在信息传输之前，这些多余的成分完全可以压缩掉，然后再传输。反之，剩余度越小，则表明信源符号之间依赖关系越弱，即符号之间的记忆长度越短。当剩余度等于零时，信源的信息熵就等于极大值  "}, {"type": "equation_inline", "content": "H_{0}"}, {"type": "text", "content": " ，这表明信源符号之间不但统计独立无记忆，而且各符号还是等概率分布。显然，这里定义的剩余度  "}, {"type": "equation_inline", "content": "\\gamma"}, {"type": "text", "content": "  可用来衡量信源输出的符号序列中各符号之间的依赖程度。"}]}, {"type": "text", "index": 10, "bbox": [0.108, 0.91, 0.932, 0.929], "content": [{"type": "text", "content": "例 4.16 有一个一阶平稳马尔可夫链 X, X 取值于集合 "}, {"type": "equation_inline", "content": "A = \\left\\{  {{a}_{1},{a}_{2},{a}_{3}}\\right\\}"}, {"type": "text", "content": " ,已知起始"}]}]}, {"page_idx": 187, "blocks": [{"type": "header", "index": 0, "bbox": [0.394, 0.061, 0.575, 0.076], "content": [{"type": "text", "content": "第4章 信息论基础"}]}, {"type": "page_number", "index": 1, "bbox": [0.848, 0.062, 0.884, 0.075], "content": [{"type": "text", "content": "175"}]}, {"type": "text", "index": 2, "bbox": [0.051, 0.095, 0.699, 0.115], "content": [{"type": "text", "content": "概率 "}, {"type": "equation_inline", "content": "P(X)"}, {"type": "text", "content": " 为 "}, {"type": "equation_inline", "content": "p_1 = 1 / 2, p_2 = p_3 = 1 / 4"}, {"type": "text", "content": " ，具体转移概率见图4.7。"}]}, {"type": "image", "index": 3, "bbox": [0.328, 0.134, 0.643, 0.315], "content": [{"type": "image_body", "index": 3, "bbox": [0.328, 0.134, 0.643, 0.315], "content": ""}, {"type": "image_caption", "index": 4, "bbox": [0.333, 0.339, 0.636, 0.355], "content": [{"type": "text", "content": "图 4.7 例 4.16 马尔可夫链状态图"}]}]}, {"type": "text", "index": 5, "bbox": [0.095, 0.372, 0.248, 0.39], "content": [{"type": "text", "content": "求信源剩余度。"}]}, {"type": "text", "index": 6, "bbox": [0.094, 0.399, 0.804, 0.418], "content": [{"type": "text", "content": "解 设 "}, {"type": "equation_inline", "content": "a_1, a_2, a_3"}, {"type": "text", "content": " 稳定后的概率分布分别为 "}, {"type": "equation_inline", "content": "W_1, W_2, W_3"}, {"type": "text", "content": ", 转移概率矩阵为"}]}, {"type": "equation", "index": 7, "bbox": [0.387, 0.433, 0.579, 0.556], "content": "\\boldsymbol {P} = \\left[ \\begin{array}{c c c} \\frac {1}{2} & \\frac {1}{4} & \\frac {1}{4} \\\\ \\frac {2}{3} & 0 & \\frac {1}{3} \\\\ \\frac {2}{3} & \\frac {1}{3} & 0 \\end{array} \\right]"}, {"type": "text", "index": 8, "bbox": [0.099, 0.564, 0.303, 0.618], "content": [{"type": "text", "content": "由 "}, {"type": "equation_inline", "content": "\\left\\{ \\begin{array}{l}WP = W\\\\ \\sum W_{i} = 1 \\end{array} \\right."}, {"type": "text", "content": " 得到"}]}, {"type": "equation", "index": 9, "bbox": [0.348, 0.625, 0.629, 0.733], "content": "\\left\\{ \\begin{array}{l} \\frac {1}{2} W _ {1} + \\frac {2}{3} W _ {2} + \\frac {2}{3} W _ {3} = 1 \\\\ \\frac {1}{4} W _ {1} + \\frac {1}{3} W _ {3} = W _ {2} \\\\ W _ {1} + W _ {2} + W _ {3} = 1 \\end{array} \\right."}, {"type": "text", "index": 10, "bbox": [0.056, 0.728, 0.153, 0.747], "content": [{"type": "text", "content": "计算得到"}]}, {"type": "equation", "index": 11, "bbox": [0.436, 0.757, 0.544, 0.879], "content": "\\left\\{ \\begin{array}{l} W _ {1} = \\frac {4}{7} \\\\ W _ {2} = \\frac {3}{1 4} \\\\ W _ {3} = \\frac {3}{1 4} \\end{array} \\right."}, {"type": "text", "index": 12, "bbox": [0.056, 0.887, 0.085, 0.905], "content": [{"type": "text", "content": "故"}]}]}, {"page_idx": 188, "blocks": [{"type": "page_number", "index": 0, "bbox": [0.092, 0.057, 0.129, 0.07], "content": [{"type": "text", "content": "176"}]}, {"type": "header", "index": 1, "bbox": [0.413, 0.056, 0.574, 0.071], "content": [{"type": "text", "content": "信息安全数学基础"}]}, {"type": "equation", "index": 2, "bbox": [0.117, 0.089, 0.87, 0.127], "content": "H _ {\\infty} = \\sum_ {i = 1} ^ {3} W _ {i} H (X \\mid E _ {i}) = \\frac {4}{7} H \\left(\\frac {1}{2}, \\frac {1}{4}, \\frac {1}{4}\\right) + 2 \\times \\frac {3}{1 4} H \\left(\\frac {2}{3}, \\frac {1}{3}, 0\\right) = 1. 2 5 \\text {bit}"}, {"type": "text", "index": 3, "bbox": [0.058, 0.136, 0.749, 0.168], "content": [{"type": "text", "content": "注意到  "}, {"type": "equation_inline", "content": "H_{0}=\\log3=1.58"}, {"type": "text", "content": "  bit，所以  "}, {"type": "equation_inline", "content": "\\gamma_{0}=1-\\eta_{0}=1-\\frac{1.25}{1.58}=0.21"}, {"type": "text", "content": " 。"}]}, {"type": "paragraph_title", "index": 4, "bbox": [0.059, 0.203, 0.469, 0.226], "content": [{"type": "text", "content": "4.6 信息论在密码学中的应用"}], "level": 2}, {"type": "text", "index": 5, "bbox": [0.059, 0.26, 0.927, 0.306], "content": [{"type": "text", "content": "1948年,香农用概率统计的观点对信息源、密钥源、接收和截获的密文进行数学描述和定量分析,提出了如图4.8所示的通用密码系统模型。"}]}, {"type": "text", "index": 6, "bbox": [0.058, 0.315, 0.929, 0.388], "content": [{"type": "text", "content": "令 "}, {"type": "equation_inline", "content": "M"}, {"type": "text", "content": " 是信源的明文空间, "}, {"type": "equation_inline", "content": "C"}, {"type": "text", "content": " 为密文空间, "}, {"type": "equation_inline", "content": "K"}, {"type": "text", "content": " 为密码系统的密钥空间。对于给定的密钥 "}, {"type": "equation_inline", "content": "k \\in K"}, {"type": "text", "content": ", 加密编码 "}, {"type": "equation_inline", "content": "E_{k}"}, {"type": "text", "content": " 是一个从 "}, {"type": "equation_inline", "content": "M"}, {"type": "text", "content": " 到 "}, {"type": "equation_inline", "content": "C"}, {"type": "text", "content": " 的一一对应变换, 而解密译码 "}, {"type": "equation_inline", "content": "D_{k}"}, {"type": "text", "content": " 是 "}, {"type": "equation_inline", "content": "E_{k}"}, {"type": "text", "content": " 的逆变换, 于是一个密码系统就由 "}, {"type": "equation_inline", "content": "(M, C, K, E_{k}, D_{k})"}, {"type": "text", "content": " 来描述。"}]}, {"type": "text", "index": 7, "bbox": [0.059, 0.396, 0.93, 0.524], "content": [{"type": "text", "content": "密码系统的主要目的在于为传送的信息进行保密。它通过对明文的变换,使得除密钥拥有者之外,其他人都不能从密文中获得明文或密钥。密码系统有两种安全性标准,①理论安全性;②实用安全性。前者指破译者具有无限时间和无限计算资源下的抗破译能力;后者指在仅有一定计算资源及其他实际限制下的抗破译能力。信息论是研究密码系统理论安全性的基础。"}]}, {"type": "image", "index": 8, "bbox": [0.193, 0.541, 0.793, 0.703], "content": [{"type": "image_body", "index": 8, "bbox": [0.193, 0.541, 0.793, 0.703], "content": ""}, {"type": "image_caption", "index": 9, "bbox": [0.369, 0.716, 0.623, 0.732], "content": [{"type": "text", "content": "图 4.8 通过密码系统模型图"}]}]}, {"type": "text", "index": 10, "bbox": [0.062, 0.752, 0.93, 0.831], "content": [{"type": "text", "content": "令明文空间 "}, {"type": "equation_inline", "content": "M = \\{m_{1}, m_{2}, \\cdots, m_{n}\\}"}, {"type": "text", "content": ", 密文空间 "}, {"type": "equation_inline", "content": "C = \\{c_{1}, c_{2}, \\cdots, c_{n}\\}"}, {"type": "text", "content": ", 明文 "}, {"type": "equation_inline", "content": "m_{i}"}, {"type": "text", "content": " 出现的概率为 "}, {"type": "equation_inline", "content": "p(m_{i})"}, {"type": "text", "content": ", 密钥 "}, {"type": "equation_inline", "content": "k \\in K"}, {"type": "text", "content": " 出现的概率为 "}, {"type": "equation_inline", "content": "p(k)"}, {"type": "text", "content": ", 密文 "}, {"type": "equation_inline", "content": "c_{j}"}, {"type": "text", "content": " 出现的概率为 "}, {"type": "equation_inline", "content": "p(c_{j})"}, {"type": "text", "content": "。所使用的密钥是独立于明文随机选取的。在收到密文 "}, {"type": "equation_inline", "content": "c_{j}"}, {"type": "text", "content": " 的条件下, 明文为 "}, {"type": "equation_inline", "content": "m_{i}"}, {"type": "text", "content": " 的条件概率为 "}, {"type": "equation_inline", "content": "p(m_{i} \\mid c_{j})"}, {"type": "text", "content": "。"}]}, {"type": "text", "index": 11, "bbox": [0.063, 0.85, 0.929, 0.897], "content": [{"type": "text", "content": "定义 4.18 一个密码系统 "}, {"type": "equation_inline", "content": "(M,C,K,E_{k},D_{k})"}, {"type": "text", "content": " 称为完全保密系统, 指对任意 "}, {"type": "equation_inline", "content": "m_{i}\\in M,c_{j}"}, {"type": "text", "content": " "}, {"type": "equation_inline", "content": "\\in C,p(c_{j})>0"}, {"type": "text", "content": " 有"}]}, {"type": "equation", "index": 12, "bbox": [0.396, 0.909, 0.926, 0.927], "content": "p (m _ {i} \\mid c _ {j}) = p (m _ {i})\\tag{4.16}"}]}, {"page_idx": 189, "blocks": [{"type": "header", "index": 0, "bbox": [0.393, 0.061, 0.575, 0.077], "content": [{"type": "text", "content": "第4章 信息论基础"}]}, {"type": "page_number", "index": 1, "bbox": [0.846, 0.062, 0.884, 0.075], "content": [{"type": "text", "content": "177"}]}, {"type": "text", "index": 2, "bbox": [0.051, 0.095, 0.919, 0.142], "content": [{"type": "text", "content": "由式(4.16)可得 "}, {"type": "equation_inline", "content": "H(M \\mid C) = H(M)"}, {"type": "text", "content": ", 即密文没有提供关于明文的先验信息, 因此敌手截获一个密文不能得到任何关于明文的信息。"}]}, {"type": "text", "index": 3, "bbox": [0.093, 0.158, 0.89, 0.177], "content": [{"type": "text", "content": "定理 4.9 一个密码系统是完全保密的充分必要条件为对任意 "}, {"type": "equation_inline", "content": "{m}_{i} \\in  M,{c}_{j} \\in  C"}, {"type": "text", "content": " 有"}]}, {"type": "equation", "index": 4, "bbox": [0.382, 0.186, 0.58, 0.205], "content": "p (c _ {j} \\mid m _ {i}) = p (c _ {j})"}, {"type": "text", "index": 5, "bbox": [0.094, 0.22, 0.33, 0.239], "content": [{"type": "text", "content": "证明 由贝叶斯公式有"}]}, {"type": "equation", "index": 6, "bbox": [0.224, 0.247, 0.742, 0.305], "content": "p (c _ {j} \\mid m _ {i}) = \\frac {p (m _ {i} \\mid c _ {j}) p (c _ {j})}{\\sum_ {j = 1} ^ {N} p (m _ {i} \\mid c _ {j}) p (c _ {j})} = \\frac {p (m _ {i} \\mid c _ {j}) p (c _ {j})}{p (m _ {i})}"}, {"type": "text", "index": 7, "bbox": [0.051, 0.309, 0.52, 0.328], "content": [{"type": "text", "content": "所以 "}, {"type": "equation_inline", "content": "p(c_{j} \\mid m_{i}) = p(c_{j}) \\Leftrightarrow p(m_{i} \\mid c_{j}) = p(m_{i})"}, {"type": "text", "content": "。"}]}, {"type": "text", "index": 8, "bbox": [0.051, 0.337, 0.918, 0.384], "content": [{"type": "text", "content": "上述定理也表明对每个密文 "}, {"type": "equation_inline", "content": "c_{j}"}, {"type": "text", "content": " 和每个明文 "}, {"type": "equation_inline", "content": "m_{i}"}, {"type": "text", "content": ", 只要 "}, {"type": "equation_inline", "content": "p(c_{j}) > 0"}, {"type": "text", "content": ", 总存在密钥 "}, {"type": "equation_inline", "content": "k"}, {"type": "text", "content": ", 使得 "}, {"type": "equation_inline", "content": "E_{k}(m_{i}) = c_{j}"}, {"type": "text", "content": " 。"}]}, {"type": "text", "index": 9, "bbox": [0.095, 0.4, 0.896, 0.419], "content": [{"type": "text", "content": "定理 4.10 一个密码系统是完全保密的, 当且仅当对任意 "}, {"type": "equation_inline", "content": "m_0, m_1 \\in M, c \\in C"}, {"type": "text", "content": ", 有"}]}, {"type": "equation", "index": 10, "bbox": [0.365, 0.428, 0.598, 0.447], "content": "p (c \\mid m _ {1}) = p (c \\mid m _ {0})"}, {"type": "text", "index": 11, "bbox": [0.095, 0.463, 0.634, 0.481], "content": [{"type": "text", "content": "证明 假设此加密方案是完全保密的,由上述定理可得"}]}, {"type": "equation", "index": 12, "bbox": [0.329, 0.49, 0.641, 0.509], "content": "p (c \\mid m _ {1}) = p (c) = p (c \\mid m _ {0})"}, {"type": "text", "index": 13, "bbox": [0.053, 0.518, 0.34, 0.536], "content": [{"type": "text", "content": "由此完成了必要条件的证明。"}]}, {"type": "text", "index": 14, "bbox": [0.096, 0.546, 0.728, 0.564], "content": [{"type": "text", "content": "下面证明充分性。假设对于任意 "}, {"type": "equation_inline", "content": "m_0, m_1 \\in M"}, {"type": "text", "content": " 和每个 "}, {"type": "equation_inline", "content": "c \\in C"}, {"type": "text", "content": " 满足"}]}, {"type": "equation", "index": 15, "bbox": [0.369, 0.573, 0.602, 0.592], "content": "p (c \\mid m _ {1}) = p (c \\mid m _ {0})"}, {"type": "text", "index": 16, "bbox": [0.051, 0.601, 0.786, 0.619], "content": [{"type": "text", "content": "不妨记 "}, {"type": "equation_inline", "content": "p = p(c \\mid m_0)"}, {"type": "text", "content": "，从而对于任意的 "}, {"type": "equation_inline", "content": "m \\in M"}, {"type": "text", "content": "，有 "}, {"type": "equation_inline", "content": "p(c \\mid m) = p"}, {"type": "text", "content": "。于是有"}]}, {"type": "equation", "index": 17, "bbox": [0.295, 0.629, 0.676, 0.745], "content": "\\begin{array}{r l} p (c) & = \\sum_ {m \\in M} p (c \\mid m) \\cdot p (m) \\\\ & = \\sum_ {m \\in M} p \\cdot p (m) \\\\ & = p \\cdot \\sum_ {m \\in M} p (m) = p = p (c \\mid m _ {0}) \\end{array}"}, {"type": "text", "index": 18, "bbox": [0.053, 0.75, 0.626, 0.769], "content": [{"type": "text", "content": "因为 "}, {"type": "equation_inline", "content": "m_0"}, {"type": "text", "content": " 是任意选择的，所以对所有 "}, {"type": "equation_inline", "content": "c \\in C"}, {"type": "text", "content": " 和 "}, {"type": "equation_inline", "content": "m \\in M"}, {"type": "text", "content": " ，都有"}]}, {"type": "equation", "index": 19, "bbox": [0.4, 0.778, 0.574, 0.796], "content": "p (c) = p (c \\mid m)"}, {"type": "text", "index": 20, "bbox": [0.054, 0.805, 0.573, 0.823], "content": [{"type": "text", "content": "由上面定理 4.9, 可以得出此加密方案是完全保密的。"}]}, {"type": "text", "index": 21, "bbox": [0.053, 0.831, 0.923, 0.878], "content": [{"type": "text", "content": "1917年，Vernam创造了一种完全保密的加密方法，现在被称为“一次一密”，然而在当时并没有证明其是完全保密的，之后香农证明了“一次一密”的完全保密性。"}]}, {"type": "text", "index": 22, "bbox": [0.097, 0.887, 0.433, 0.905], "content": [{"type": "text", "content": "“一次一密”的加密方案定义如下:"}]}, {"type": "text", "index": 23, "bbox": [0.098, 0.914, 0.924, 0.933], "content": [{"type": "text", "content": "(1) 令整数 "}, {"type": "equation_inline", "content": "l > 0"}, {"type": "text", "content": ", 设明文空间 "}, {"type": "equation_inline", "content": "M"}, {"type": "text", "content": "、密钥空间 "}, {"type": "equation_inline", "content": "K"}, {"type": "text", "content": " 和密文空间 "}, {"type": "equation_inline", "content": "C"}, {"type": "text", "content": " 都等于 "}, {"type": "equation_inline", "content": "\\{0,1\\}^l"}, {"type": "text", "content": " (也就是说"}]}]}, {"page_idx": 190, "blocks": [{"type": "page_number", "index": 0, "bbox": [0.091, 0.057, 0.129, 0.07], "content": [{"type": "text", "content": "178"}]}, {"type": "header", "index": 1, "bbox": [0.411, 0.055, 0.574, 0.071], "content": [{"type": "text", "content": "信息安全数学基础"}]}, {"type": "text", "index": 2, "bbox": [0.057, 0.09, 0.399, 0.109], "content": [{"type": "text", "content": "长度为 l 的二进制比特串的集合）。"}]}, {"type": "text", "index": 3, "bbox": [0.101, 0.117, 0.825, 0.136], "content": [{"type": "text", "content": "(2) 密钥产生算法 Gen 从 "}, {"type": "equation_inline", "content": "\\{0,1\\}^t"}, {"type": "text", "content": " 中依据均匀分布选择一个二进制比特串。"}]}, {"type": "text", "index": 4, "bbox": [0.056, 0.145, 0.925, 0.191], "content": [{"type": "text", "content": "(3) 加密算法 Enc: 给定一个密钥 "}, {"type": "equation_inline", "content": "k \\in \\{0,1\\}^{l}"}, {"type": "text", "content": " 和一个明文 "}, {"type": "equation_inline", "content": "m \\in \\{0,1\\}^{l}"}, {"type": "text", "content": ", 输出 "}, {"type": "equation_inline", "content": "c := k \\oplus m"}, {"type": "text", "content": "。"}]}, {"type": "text", "index": 5, "bbox": [0.056, 0.199, 0.925, 0.246], "content": [{"type": "text", "content": "(4) 解密算法 Dec: 给定一个密钥 "}, {"type": "equation_inline", "content": "k \\in \\{0,1\\}^l"}, {"type": "text", "content": " 和一个明文 "}, {"type": "equation_inline", "content": "c \\in \\{0,1\\}^l"}, {"type": "text", "content": ", 输出 "}, {"type": "equation_inline", "content": "m := k \\oplus c"}, {"type": "text", "content": "。"}]}, {"type": "text", "index": 6, "bbox": [0.102, 0.261, 0.533, 0.28], "content": [{"type": "text", "content": "定理 4.11 “一次一密”是完全保密的加密。"}]}, {"type": "text", "index": 7, "bbox": [0.102, 0.297, 0.71, 0.315], "content": [{"type": "text", "content": "证明 选定明文空间 "}, {"type": "equation_inline", "content": "M"}, {"type": "text", "content": " 的分布，以及任意 "}, {"type": "equation_inline", "content": "m \\in M, c \\in C"}, {"type": "text", "content": " ，有"}]}, {"type": "equation", "index": 8, "bbox": [0.134, 0.325, 0.849, 0.356], "content": "p (c \\mid m) = p (m \\oplus k = c \\mid m) = p (m \\oplus k = c) = p (k = c \\oplus m) = \\frac {1}{2 ^ {l}}"}, {"type": "text", "index": 9, "bbox": [0.059, 0.369, 0.72, 0.387], "content": [{"type": "text", "content": "由于这对所有分布和 "}, {"type": "equation_inline", "content": "m"}, {"type": "text", "content": " 都成立，所以对任意 "}, {"type": "equation_inline", "content": "m_0, m_1 \\in M, c \\in C"}, {"type": "text", "content": " ，有"}]}, {"type": "equation", "index": 10, "bbox": [0.349, 0.397, 0.638, 0.429], "content": "p (c \\mid m _ {1}) = \\frac {1}{2 ^ {l}} = p (c \\mid m _ {0})"}, {"type": "text", "index": 11, "bbox": [0.059, 0.44, 0.438, 0.458], "content": [{"type": "text", "content": "这说明“一次一密”是完全保密的加密。"}]}, {"type": "text", "index": 12, "bbox": [0.104, 0.475, 0.88, 0.493], "content": [{"type": "text", "content": "定理 4.12 在一个完全保密的密码系统中, 不同密钥数至少与明文的数目相等。"}]}, {"type": "text", "index": 13, "bbox": [0.059, 0.509, 0.929, 0.611], "content": [{"type": "text", "content": "证明 对于任意加密变换 "}, {"type": "equation_inline", "content": "E_{k}"}, {"type": "text", "content": ", 以及明文 "}, {"type": "equation_inline", "content": "m_{i}, m_{j} \\in M, m_{i} \\neq m_{j}"}, {"type": "text", "content": ", 有 "}, {"type": "equation_inline", "content": "E_{k}(m_{i}) \\neq E_{k}(m_{j})"}, {"type": "text", "content": ", 故密文数目不少于明文数目。由定理4.9可知, 至少有一个密钥 "}, {"type": "equation_inline", "content": "k"}, {"type": "text", "content": ", 它对应的加密变换把给定的明文 "}, {"type": "equation_inline", "content": "m"}, {"type": "text", "content": " 加密成 "}, {"type": "equation_inline", "content": "C"}, {"type": "text", "content": " 中任一选定的密文。由于同一变换不能把同一明文 "}, {"type": "equation_inline", "content": "m"}, {"type": "text", "content": " 加密成不同密文, 所以加密变换数目不少于密文数目。从而定理得以证明。 "}, {"type": "equation_inline", "content": "\\square"}]}, {"type": "text", "index": 14, "bbox": [0.062, 0.625, 0.928, 0.672], "content": [{"type": "text", "content": "定理 4.13 设一个密码系统的明文数目、密文数目和密钥数目相等, 即 "}, {"type": "equation_inline", "content": "|M| = |C| = |K| = n"}, {"type": "text", "content": ", 则该密码为完全保密的充分必要条件是:"}]}, {"type": "text", "index": 15, "bbox": [0.105, 0.68, 0.705, 0.699], "content": [{"type": "text", "content": "(1) 有且仅有一个密钥将每个给定明文加密为每个给定密文。"}]}, {"type": "text", "index": 16, "bbox": [0.107, 0.708, 0.436, 0.726], "content": [{"type": "text", "content": "(2) 所有密钥的选取是等概率的。"}]}, {"type": "text", "index": 17, "bbox": [0.062, 0.742, 0.929, 0.789], "content": [{"type": "text", "content": "证明 若该密码是完全保密的,由定理 4.9 可知至少有一个加密变换将任意给定的明文 "}, {"type": "equation_inline", "content": "m"}, {"type": "text", "content": " 加密为任意给定的密文 "}, {"type": "equation_inline", "content": "c"}, {"type": "text", "content": " 。当 "}, {"type": "equation_inline", "content": "\\left| M \\right| = \\left| C \\right| = \\left| K \\right|"}, {"type": "text", "content": " 时,则条件(1)成立。又有"}]}, {"type": "equation", "index": 18, "bbox": [0.156, 0.797, 0.926, 0.815], "content": "p (c _ {j} \\mid m _ {1}) = p (c _ {j} \\mid m _ {2}) = \\dots p (c _ {j} \\mid m _ {i}) = \\dots = p (c _ {j} \\mid m _ {n}) = p (c _ {j})\\tag{4.17}"}, {"type": "text", "index": 19, "bbox": [0.06, 0.824, 0.761, 0.843], "content": [{"type": "text", "content": "其中， "}, {"type": "equation_inline", "content": "p(c_{j}\\mid m_{i})"}, {"type": "text", "content": " 表示将明文 "}, {"type": "equation_inline", "content": "m_{i}"}, {"type": "text", "content": " 加密成密文 "}, {"type": "equation_inline", "content": "c_{j}"}, {"type": "text", "content": " 的所有密钥的概率和，即"}]}, {"type": "equation", "index": 20, "bbox": [0.235, 0.851, 0.926, 0.871], "content": "p (c _ {j} \\mid m _ {i}) = p (c _ {j} \\mid m _ {2}) = \\dots = p (c _ {j} \\mid m _ {n}) = p (c _ {j})\\tag{4.18}"}, {"type": "text", "index": 21, "bbox": [0.062, 0.879, 0.484, 0.897], "content": [{"type": "text", "content": "由于满足 "}, {"type": "equation_inline", "content": "E_{k}(m_{i}) = c_{j}"}, {"type": "text", "content": " 的 "}, {"type": "equation_inline", "content": "k"}, {"type": "text", "content": " 只有一个，所以"}]}, {"type": "equation", "index": 22, "bbox": [0.371, 0.907, 0.623, 0.927], "content": "p _ {k} = p (c _ {j} \\mid m _ {i}) = p (c _ {j})"}]}, {"page_idx": 191, "blocks": [{"type": "header", "index": 0, "bbox": [0.382, 0.063, 0.563, 0.078], "content": [{"type": "text", "content": "第4章 信息论基础"}]}, {"type": "page_number", "index": 1, "bbox": [0.835, 0.064, 0.872, 0.077], "content": [{"type": "text", "content": "179"}]}, {"type": "text", "index": 2, "bbox": [0.042, 0.097, 0.685, 0.115], "content": [{"type": "text", "content": "当 "}, {"type": "equation_inline", "content": "m_{i}"}, {"type": "text", "content": " 跑遍明文空间时，"}, {"type": "equation_inline", "content": "k"}, {"type": "text", "content": " 跑遍密钥空间，所以密钥选取是等概率的。"}]}, {"type": "text", "index": 3, "bbox": [0.083, 0.125, 0.812, 0.156], "content": [{"type": "text", "content": "反过来若条件(1)和条件(2)成立，则对一切 "}, {"type": "equation_inline", "content": "m_{i}"}, {"type": "text", "content": " 和 "}, {"type": "equation_inline", "content": "c_{j}"}, {"type": "text", "content": "，有 "}, {"type": "equation_inline", "content": "p(c_{j} \\mid m_{i}) = \\frac{1}{n}"}, {"type": "text", "content": "，则"}]}, {"type": "equation", "index": 4, "bbox": [0.231, 0.165, 0.711, 0.203], "content": "p (c _ {j}) = \\sum_ {i = 1} ^ {n} p (m _ {i}) p (c _ {j} \\mid m _ {i}) = \\frac {1}{n} = p (c _ {j} \\mid m _ {i})"}, {"type": "text", "index": 5, "bbox": [0.04, 0.211, 0.394, 0.229], "content": [{"type": "text", "content": "由定理 4.9 知该密码系统完全保密。"}]}, {"type": "text", "index": 6, "bbox": [0.037, 0.238, 0.907, 0.339], "content": [{"type": "text", "content": "定理 4.13 又被称为香农定理, 它从本质上给出了完全保密的完整特征。另外, 由于条件(1)和条件(2)与明文空间 M 上的概率分布没有任何关系, 这就意味着: 如果存在一个加密方案对明文空间 M 上的特定分布是完全保密的加密, 则此加密方案在一般情况下也是完全保密的加密。"}]}, {"type": "text", "index": 7, "bbox": [0.082, 0.353, 0.649, 0.371], "content": [{"type": "text", "content": "定理 4.14 对密码系统  "}, {"type": "equation_inline", "content": "(M, C, K, E_{k}, D_{k})"}, {"type": "text", "content": " ，明文熵定义为"}]}, {"type": "equation", "index": 8, "bbox": [0.324, 0.381, 0.619, 0.413], "content": "H (M) = - \\sum_ {m \\in M} p (m) \\log p (m)"}, {"type": "text", "index": 9, "bbox": [0.04, 0.416, 0.184, 0.434], "content": [{"type": "text", "content": "密钥熵定义为"}]}, {"type": "equation", "index": 10, "bbox": [0.331, 0.443, 0.612, 0.475], "content": "H (K) = - \\sum_ {k \\in K} p (k) \\log p (k)"}, {"type": "text", "index": 11, "bbox": [0.038, 0.479, 0.906, 0.525], "content": [{"type": "text", "content": "令 "}, {"type": "equation_inline", "content": "X^{t}"}, {"type": "text", "content": " 表示 "}, {"type": "equation_inline", "content": "M"}, {"type": "text", "content": " 中所有长度为 "}, {"type": "equation_inline", "content": "t"}, {"type": "text", "content": " 的明文构成的集合, "}, {"type": "equation_inline", "content": "Y^{n}"}, {"type": "text", "content": " 表示 "}, {"type": "equation_inline", "content": "C"}, {"type": "text", "content": " 中所有长度为 "}, {"type": "equation_inline", "content": "n"}, {"type": "text", "content": " 的密文构成的集合, 则在已知密文下对明文和对密钥的疑义度为"}]}, {"type": "equation", "index": 12, "bbox": [0.247, 0.533, 0.698, 0.609], "content": "\\begin{array}{l} H (X ^ {t} \\mid Y ^ {n}) = - \\sum_ {m \\in X ^ {t}, c \\in Y ^ {n}} p (c, m) \\log p (m \\mid c) \\\\ H (K \\mid Y ^ {n}) = - \\sum_ {k \\in K, c \\in Y ^ {n}} p (c, k) \\log p (k \\mid c) \\end{array}"}, {"type": "text", "index": 13, "bbox": [0.039, 0.612, 0.907, 0.657], "content": [{"type": "text", "content": "所以 "}, {"type": "equation_inline", "content": "H(X^{t} \\mid Y^{n})"}, {"type": "text", "content": " 和 "}, {"type": "equation_inline", "content": "H(K \\mid Y^{n})"}, {"type": "text", "content": " 分别给出了截获到长度为 "}, {"type": "equation_inline", "content": "n"}, {"type": "text", "content": " 的密文后, 关于长度为 "}, {"type": "equation_inline", "content": "t"}, {"type": "text", "content": " 的明文和密钥的不确定程度。显然, 若 "}, {"type": "equation_inline", "content": "N \\geqslant n"}, {"type": "text", "content": " 有"}]}, {"type": "equation", "index": 14, "bbox": [0.337, 0.665, 0.611, 0.711], "content": "\\begin{array}{c} H (X ^ {t} \\mid Y ^ {n}) \\geqslant H (X ^ {t} \\mid Y ^ {N}) \\\\ H (K \\mid Y ^ {n}) \\geqslant H (K \\mid Y ^ {N}) \\end{array}"}, {"type": "text", "index": 15, "bbox": [0.04, 0.72, 0.909, 0.793], "content": [{"type": "text", "content": "于是随着截获密文的增加,获得关于明文或密钥的信息量就会增加。若 n 充分大,使  "}, {"type": "equation_inline", "content": "H(K \\mid Y^{n}) = 0"}, {"type": "text", "content": " , 则此时可唯一确定密钥。因而使  "}, {"type": "equation_inline", "content": "H(K \\mid Y^{n}) = 0"}, {"type": "text", "content": "  的最小 n 在密码学中有重要意义。"}]}, {"type": "text", "index": 16, "bbox": [0.04, 0.808, 0.907, 0.853], "content": [{"type": "text", "content": "定义 4.19 一个密码系统的唯一解距离 "}, {"type": "equation_inline", "content": "N_{0}"}, {"type": "text", "content": " 定义为使 "}, {"type": "equation_inline", "content": "H(K \\mid Y^{n}) = 0"}, {"type": "text", "content": " 的最小正整数 "}, {"type": "equation_inline", "content": "n"}, {"type": "text", "content": "。"}]}, {"type": "text", "index": 17, "bbox": [0.041, 0.862, 0.908, 0.908], "content": [{"type": "text", "content": "对于大多数密码,推导唯一解距离 "}, {"type": "equation_inline", "content": "N_{0}"}, {"type": "text", "content": " 是很复杂的,香农提出利用随机密码模型来给出 "}, {"type": "equation_inline", "content": "H(K \\mid Y^{n})"}, {"type": "text", "content": " 的近似估计。采用随机密码方法,对 "}, {"type": "equation_inline", "content": "(M,C,K,E_{k},D_{k})"}, {"type": "text", "content": " 做如下假设:"}]}, {"type": "text", "index": 18, "bbox": [0.084, 0.917, 0.909, 0.936], "content": [{"type": "text", "content": "(1) 明文字符表和密文字符表相同为 "}, {"type": "equation_inline", "content": "A 、长度为 n"}, {"type": "text", "content": " 的明文集合 "}, {"type": "equation_inline", "content": "A^{n}"}, {"type": "text", "content": " 可划分成两个集合"}]}]}, {"page_idx": 192, "blocks": [{"type": "page_number", "index": 0, "bbox": [0.099, 0.058, 0.136, 0.07], "content": [{"type": "text", "content": "180"}]}, {"type": "header", "index": 1, "bbox": [0.419, 0.056, 0.581, 0.071], "content": [{"type": "text", "content": "信息安全数学基础"}]}, {"type": "text", "index": 2, "bbox": [0.064, 0.09, 0.932, 0.137], "content": [{"type": "equation_inline", "content": "B_{n}"}, {"type": "text", "content": "  和  "}, {"type": "equation_inline", "content": "\\overline{B}_{n}=A^{n}-B_{n}, B_{n}"}, {"type": "text", "content": "  中明文是有意义的， "}, {"type": "equation_inline", "content": "\\overline{B}_{n}"}, {"type": "text", "content": "  中明文无意义。当  "}, {"type": "equation_inline", "content": "n\\to\\infty"}, {"type": "text", "content": "  时， "}, {"type": "equation_inline", "content": "\\overline{B}_{n}"}, {"type": "text", "content": "  中明文出现的概率可忽略不计。记  "}, {"type": "equation_inline", "content": "R_{0}=\\log|A|"}, {"type": "text", "content": " ，称为信源的绝对信息率。"}]}, {"type": "text", "index": 3, "bbox": [0.108, 0.145, 0.87, 0.164], "content": [{"type": "equation_inline", "content": "R_{n} = \\log |B_{n}| / n"}, {"type": "text", "content": " 为信源的近似信息率， "}, {"type": "equation_inline", "content": "d_{n} = R_{0} - R_{n}"}, {"type": "text", "content": " 为信源的近似剩余度。"}]}, {"type": "text", "index": 4, "bbox": [0.11, 0.173, 0.605, 0.191], "content": [{"type": "text", "content": "(2) 密钥为等概分布, 即  "}, {"type": "equation_inline", "content": "p(k)=|K|^{-1}=2^{-H(K)}"}, {"type": "text", "content": " 。"}]}, {"type": "text", "index": 5, "bbox": [0.11, 0.2, 0.865, 0.219], "content": [{"type": "text", "content": "(3) 对 "}, {"type": "equation_inline", "content": "k \\in K"}, {"type": "text", "content": " 的加密变换 "}, {"type": "equation_inline", "content": "f_{k}"}, {"type": "text", "content": " 为 "}, {"type": "equation_inline", "content": "A^{n} \\to A^{n}"}, {"type": "text", "content": " 的一一映射，解密变换为 "}, {"type": "equation_inline", "content": "\\varphi_{k} = f_{k}^{-1}"}, {"type": "text", "content": "。"}]}, {"type": "text", "index": 6, "bbox": [0.111, 0.227, 0.419, 0.245], "content": [{"type": "text", "content": "(4) "}, {"type": "equation_inline", "content": "B_{n}"}, {"type": "text", "content": " 中每个明文等概率出