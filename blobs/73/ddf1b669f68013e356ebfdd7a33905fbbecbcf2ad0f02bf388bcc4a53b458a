content": [{"type": "text", "content": "(其中 "}, {"type": "equation_inline", "content": "a_{i} \\in R, n"}, {"type": "text", "content": " 是非负整数)称为环 "}, {"type": "equation_inline", "content": "R"}, {"type": "text", "content": " 上的一个多项式。通常用符号 "}, {"type": "equation_inline", "content": "f(x), g(x), \\cdots"}, {"type": "text", "content": " 表示多项式，用 "}, {"type": "equation_inline", "content": "R[x]"}, {"type": "text", "content": " 表示 "}, {"type": "equation_inline", "content": "R"}, {"type": "text", "content": " 上的全体多项式的集合。"}]}, {"type": "text", "index": 7, "bbox": [0.061, 0.34, 0.931, 0.456], "content": [{"type": "text", "content": "在多项式 "}, {"type": "equation_inline", "content": "f(x)=\\sum_{i=0}^{n}a_{i}x^{i}"}, {"type": "text", "content": " 中，"}, {"type": "equation_inline", "content": "a_{i}"}, {"type": "text", "content": " 称为 "}, {"type": "equation_inline", "content": "x^{i}"}, {"type": "text", "content": " 的系数，当 "}, {"type": "equation_inline", "content": "a_{i}=0"}, {"type": "text", "content": " 时，"}, {"type": "equation_inline", "content": "a_{i}x^{i}"}, {"type": "text", "content": " 在 "}, {"type": "equation_inline", "content": "f(x)"}, {"type": "text", "content": " 的表达式中可以不写。若 "}, {"type": "equation_inline", "content": "a_{n}\\neq0"}, {"type": "text", "content": "，则称 "}, {"type": "equation_inline", "content": "f(x)"}, {"type": "text", "content": " 为 n 次多项式，记做 "}, {"type": "equation_inline", "content": "\\deg(f(x))=n"}, {"type": "text", "content": "，此时 "}, {"type": "equation_inline", "content": "a_{n}"}, {"type": "text", "content": " 称为 "}, {"type": "equation_inline", "content": "f(x)"}, {"type": "text", "content": " 的首项系数。零多项式是唯一不定义次数的多项式，零次多项式就是 R 中非零元。"}]}, {"type": "text", "index": 8, "bbox": [0.063, 0.466, 0.929, 0.527], "content": [{"type": "text", "content": "设 "}, {"type": "equation_inline", "content": "f(x) = \\sum_{i=0}^{n} a_i x^i"}, {"type": "text", "content": ", "}, {"type": "equation_inline", "content": "g(x) = \\sum_{i=0}^{m} b_i x^i"}, {"type": "text", "content": ", 如果 "}, {"type": "equation_inline", "content": "m = n"}, {"type": "text", "content": ", 并且 "}, {"type": "equation_inline", "content": "a_i = b_i (0 \\leqslant i \\leqslant n)"}, {"type": "text", "content": ", 则称 "}, {"type": "equation_inline", "content": "f(x)"}, {"type": "text", "content": " 与 "}, {"type": "equation_inline", "content": "g(x)"}, {"type": "text", "content": " 相等, 记为 "}, {"type": "equation_inline", "content": "f(x) = g(x)"}, {"type": "text", "content": "。"}]}, {"type": "text", "index": 9, "bbox": [0.062, 0.537, 0.93, 0.598], "content": [{"type": "text", "content": "对环 "}, {"type": "equation_inline", "content": "R"}, {"type": "text", "content": " 上两个多项式 "}, {"type": "equation_inline", "content": "f(x) = \\sum_{i=0}^{n} a_i x^i"}, {"type": "text", "content": " 和 "}, {"type": "equation_inline", "content": "g(x) = \\sum_{i=0}^{m} b_i x^i, n \\geqslant m"}, {"type": "text", "content": ", 定义加法和乘法如下, 即"}]}, {"type": "equation", "index": 10, "bbox": [0.226, 0.608, 0.765, 0.69], "content": "\\begin{array}{c} f (x) + g (x) = \\sum_ {i = 0} ^ {n} (a _ {i} + b _ {i}) x ^ {i} \\quad b _ {i} = 0 \\quad (i > m) \\\\ f (x) g (x) = \\sum_ {k = 0} ^ {m + n} c _ {k} x ^ {k} \\quad c _ {k} = \\sum_ {i + j = k} a _ {i} b _ {j} \\end{array}"}, {"type": "text", "index": 11, "bbox": [0.063, 0.693, 0.727, 0.712], "content": [{"type": "text", "content": "则 "}, {"type": "equation_inline", "content": "R[x]"}, {"type": "text", "content": " 关于以上多项式的加法和乘法构成一个环(读者自己证明)。"}]}, {"type": "text", "index": 12, "bbox": [0.062, 0.72, 0.931, 0.794], "content": [{"type": "text", "content": "特别地, 如果 "}, {"type": "equation_inline", "content": "R"}, {"type": "text", "content": " 为整环, 则 "}, {"type": "equation_inline", "content": "R[x]"}, {"type": "text", "content": " 也是整环。事实上当 "}, {"type": "equation_inline", "content": "R"}, {"type": "text", "content": " 为交换环时, 根据多项式乘法的定义, 易知 "}, {"type": "equation_inline", "content": "R[x]"}, {"type": "text", "content": " 也是交换环。其次由于 "}, {"type": "equation_inline", "content": "R"}, {"type": "text", "content": " 为无零因子, 故当 "}, {"type": "equation_inline", "content": "a_{n} \\neq 0"}, {"type": "text", "content": ", "}, {"type": "equation_inline", "content": "b_{m} \\neq 0"}, {"type": "text", "content": " 时, "}, {"type": "equation_inline", "content": "a_{n} b_{m} \\neq 0"}, {"type": "text", "content": " 。如果 "}, {"type": "equation_inline", "content": "f(x), g(x)"}, {"type": "text", "content": " 均为非零多项式, 则有"}]}, {"type": "equation", "index": 13, "bbox": [0.233, 0.804, 0.759, 0.842], "content": "f (x) = \\sum_ {i = 0} ^ {n} a _ {i} x ^ {i} \\quad g (x) = \\sum_ {i = 0} ^ {m} b _ {i} x ^ {i} \\quad (a _ {n}, b _ {m} \\neq 0)"}, {"type": "text", "index": 14, "bbox": [0.064, 0.848, 0.908, 0.886], "content": [{"type": "text", "content": "从而 "}, {"type": "equation_inline", "content": "f(x)g(x) = \\sum_{i=0}^{m+n} c_i x^i"}, {"type": "text", "content": "，其中首项系数 "}, {"type": "equation_inline", "content": "c_{n+m} = a_n b_m \\neq 0"}, {"type": "text", "content": "，故 "}, {"type": "equation_inline", "content": "f(x)g(x) \\neq 0"}, {"type": "text", "content": "，这表明"}]}, {"type": "equation", "index": 15, "bbox": [0.297, 0.891, 0.697, 0.908], "content": "\\deg (f (x) g (x)) = \\deg f (x) + \\deg g (x) 。"}, {"type": "text", "index": 16, "bbox": [0.107, 0.917, 0.933, 0.935], "content": [{"type": "text", "content": "在工程实际中用得较多的是域上的多项式环 "}, {"type": "equation_inline", "content": "F[x]"}, {"type": "text", "content": ", 这里 "}, {"type": "equation_inline", "content": "F"}, {"type": "text", "content": " 为域。域上多项式环的性"}]}]}], "is_full_document": false, "schema": "docvortex.middle", "schema_version": "2.0"}