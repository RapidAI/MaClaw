: "equation_inline", "content": "p_s"}, {"type": "text", "content": " 均为奇数，故"}]}, {"type": "equation", "index": 5, "bbox": [0.366, 0.261, 0.673, 0.279], "content": "(m _ {s - 1} - 1) (p _ {s} - 1) \\equiv 0 \\bmod 4"}, {"type": "text", "index": 6, "bbox": [0.084, 0.288, 0.115, 0.306], "content": [{"type": "text", "content": "即"}]}, {"type": "equation", "index": 7, "bbox": [0.326, 0.316, 0.708, 0.335], "content": "m _ {s - 1} p _ {s} - 1 \\equiv m _ {s - 1} - 1 + p _ {s} - 1 \\bmod 4"}, {"type": "text", "index": 8, "bbox": [0.084, 0.343, 0.249, 0.361], "content": [{"type": "text", "content": "由归纳假设可得"}]}, {"type": "equation", "index": 9, "bbox": [0.17, 0.37, 0.868, 0.409], "content": "\\frac {m - 1}{2} \\equiv \\frac {m _ {s - 1} - 1}{2} + \\frac {p _ {s} - 1}{2} \\equiv \\sum_ {i = 1} ^ {s - 1} \\frac {p _ {i} - 1}{2} + \\frac {p _ {s} - 1}{2} \\equiv \\sum_ {i = 1} ^ {s} \\frac {p _ {i} - 1}{2} \\bmod 2"}, {"type": "text", "index": 10, "bbox": [0.085, 0.419, 0.323, 0.452], "content": [{"type": "text", "content": "从而 "}, {"type": "equation_inline", "content": "\\left(\\frac{-1}{m}\\right) = (-1)^{\\frac{m - 1}{2}}"}, {"type": "text", "content": "。"}]}, {"type": "text", "index": 11, "bbox": [0.13, 0.462, 0.521, 0.481], "content": [{"type": "text", "content": "(2)仍令 "}, {"type": "equation_inline", "content": "m = p_{1}p_{2}\\dots p_{s},p_{i}"}, {"type": "text", "content": " 为奇素数，则"}]}, {"type": "equation", "index": 12, "bbox": [0.274, 0.491, 0.763, 0.537], "content": "\\left(\\frac {2}{m}\\right) = \\prod_ {i = 1} ^ {s} \\left(\\frac {2}{p _ {i}}\\right) = \\prod_ {i = 1} ^ {s} (- 1) ^ {\\frac {1}{8} (p _ {i} ^ {2} - 1)} = (- 1) ^ {\\sum_ {i = 1} ^ {s} \\frac {p _ {i} ^ {2} - 1}{8}}"}, {"type": "text", "index": 13, "bbox": [0.085, 0.543, 0.183, 0.562], "content": [{"type": "text", "content": "下面证明"}]}, {"type": "equation", "index": 14, "bbox": [0.38, 0.57, 0.662, 0.607], "content": "\\sum_ {i = 1} ^ {s} \\frac {p _ {i} ^ {2} - 1}{8} \\equiv \\frac {m ^ {2} - 1}{8} \\b