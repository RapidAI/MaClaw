c{m^{2}-1}{8}}"}, {"type": "text", "content": " 。"}]}, {"type": "text", "index": 22, "bbox": [0.129, 0.915, 0.552, 0.933], "content": [{"type": "text", "content": "Jacobi 符号同样有类似二次互反律的性质。"}]}]}, {"page_idx": 42, "blocks": [{"type": "page_number", "index": 0, "bbox": [0.08, 0.056, 0.108, 0.069], "content": [{"type": "text", "content": "30"}]}, {"type": "header", "index": 1, "bbox": [0.401, 0.055, 0.562, 0.07], "content": [{"type": "text", "content": "信息安全数学基础"}]}, {"type": "text", "index": 2, "bbox": [0.091, 0.09, 0.589, 0.107], "content": [{"type": "text", "content": "定理1.27 设 "}, {"type": "equation_inline", "content": "m, n > 1"}, {"type": "text", "content": " 为奇数，且 "}, {"type": "equation_inline", "content": "(m, n) = 1"}, {"type": "text", "content": " ，则"}]}, {"type": "equation", "index": 3, "bbox": [0.358, 0.121, 0.597, 0.152], "content": "\\left(\\frac {n}{m}\\right) \\left(\\frac {m}{n}\\right) = (- 1) ^ {\\frac {m - 1}{2} \\frac {n - 1}{2}}"}, {"type": "text", "index": 4, "bbox": [0.091, 0.172, 0.455, 0.211], "content": [{"type": "text", "content": "证明 令 "}, {"type": "equation_inline", "content": "m = \\prod_{i=1}^{s} p_i"}, {"type": "text", "content": ", "}, {"type": "equation_inline", "content": "n = \\prod_{j=1}^{t} q_j"}, {"type": "text", "content": ", 则"}]}, {"type": "equation", "index": 5, "bbox": [0.099, 0.217, 0.753, 0.31], "content": "\\begin{array}{r l} \\left(\\frac {n}{m}\\right) \\left(\\frac {m}{n}\\right) & = \\left[ \\prod_ {j = 1} ^ {t} \\prod_ {i = 1} ^ {s} \\left(\\frac {q _ {j}}{p _ {i}}\\right) \\right] \\left[ \\prod_ {i = 1} ^ {s} \\prod_ {j = 1} ^ {t} \\left(\\frac {p _ {i}}{q _ {j}}\\right) \\right] = \\prod_ {j = 1} ^ {t} \\prod_ {i = 1} ^ {s} \\left(\\frac {q _ {j}}{p _ {i}}\\right) \\left(\\frac {p _ {i}}{q _ {j}}\\right) \\\\ & = \\prod_ {j = 1} ^ {t} \\prod_ {i = 1} ^ {s} (- 1) ^ {\\frac {p _ {i} - 1}{2} \\frac {q _ {j} - 1}{2}} = (- 1) ^ {\\sum_ {i = 1} ^ {s} \\frac {p _ {i} - 1}{2} \\sum_ {j = 1} ^ {t} \\frac {q _ {j} - 1}{2}} = (- 1) ^ {\\frac {m - 1}{2} \\frac {n - 1}{2}} \\end{array}"}, {"type": "text", "index": 6, "bbox": [0.047, 0.316, 0.913, 0.354], "content": [{"type": "text", "content": "其中最后一个等式用到如下性质: "}, {"type": "equation_inline", "content": "\\frac{m-1}{2}\\equiv\\sum_{i=1}^{s}\\frac{p_{i}-1}{2}\\bmod2,\\frac{n-1}{2}\\equiv\\sum_{i=1}^{t}\\frac{q_{j}-1}{2}\\bmod2"}, {"type": "text", "content": " 。"}]}, {"type": "text", "index": 7, "bbox": [0.047, 0.396, 0.917, 0.591], "content": [{"type": "text", "content": "Legendre 符号 "}, {"type": "equation_inline", "content": "\\left(\\frac{a}{p}\\right)"}, {"type": "text", "content": " 可以用来判断同余式 "}, {"type": "equation_inline", "content": "x^{2} \\equiv a \\bmod p"}, {"type": "text", "content": " 是否有解。当 "}, {"type": "equation_inline", "content": "\\left(\\frac{a}{p}\\right) = 1"}, {"type": "text", "content": " 时，"}, {"type": "equation_inline", "content": "x^{2} \\equiv a \\bmod p"}, {"type": "text", "content": " 恰有两个解。当 "}, {"type": "equation_inline", "content": "\\left(\\frac{a}{p}\\right) = -1"}, {"type": "text", "content": " 时，"}, {"type": "equation_inline", "content": "x^{2} \\equiv a \\bmod p"}, {"type": "text", "content": " 无解。然而 Jacobi 符号 "}, {"type": "equation_inline", "content": "\\left(\\frac{a}{m}\\right)"}, {"type": "text", "content": " 却只能用来否定 "}, {"type": "equation_inline", "content": "x^{2} \\equiv a \\bmod m"}, {"type": "text", "content": " 是否有解，即当 "}, {"type": "equation_inline", "content": "\\left(\\frac{a}{m}\\right) = -1"}, {"type": "text", "content": " 时，"}, {"type": "equation_inline", "content": "x^{2} \\equiv a \\bmod m"}, {"type": "text", "content": " 一定无解，但当 "}, {"type": "equation_inline", "content": "\\left(\\frac{a}{m}\\right) = 1"}, {"type": "text", "content": " 时，"}, {"type": "equation_inline", "content": "x^{2} \\equiv a \\bmod m"}, {"type": "text", "content": " 可能无解也可能有解。例如，Jacobi 符号 "}, {"type": "equation_inline", "content": "\\left(\\frac{-1}{9}\\right) = (-1)^{\\frac{9-1}{2}} = 1"}, {"type": "text", "content": "，但 "}, {"type": "equation_inline", "content": "x^{2} \\equiv -1 \\bmod 9"}, {"type": "text", "content": " 是一定无解的。"}]}, {"type": "paragraph_title", "index": 8, "bbox": [0.051, 0.625, 0.459, 0.647], "content": [{"type": "text", "content": "1.6 数论在信息安全中的应用"}], "level": 2}, {"type": "text", "index": 9, "bbox": [0.048, 0.681, 0.92, 0.84], "content": [{"type": "text", "content": "随着信息技术的不断发展和应用,信息安全的内涵也在不断的延伸,从最初的信息保密性发展到信息的完整性、可用性、可控性和不可否认性,进而发展到“攻(攻击)、防(防范)、测(检测)、控(控制)、管(管理)、评(评估)”等多方面的基础理论与技术。密码技术是信息安全的核心技术,涉及密码体制的设计与分析、身份认证、数字签名、密钥管理等多种安全范畴。本节主要介绍数论在密码体制设计与分析中的应用实例,包括代换密码、RSA算法、EIGamal算法的加解密原理及它们所用到的数论知识。"}]}, {"type": "paragraph_title", "index": 10, "bbox": [0.097, 0.855, 0.357, 0.873], "content": [{"type": "text", "content": "1. 代换密码及其数论基础"}], "level": 2}, {"type": "text", "index": 11, "bbox": [0.05, 0.882, 0.918, 0.929], "content": [{"type": "text", "content": "代换密码是一类重要的古典密码体制,包括移位密码和仿射密码等特殊形式,同时也包括维吉尼亚密码和希尔密码等扩展形式。"}]}]}, {"page_idx": 43, "blocks": [{"type": "header", "index": 0, "bbox": [0.428, 0.059, 0.592, 0.075], "content": [{"type": "text", "content": "第1章 数论基础"}]}, {"type": "page_number", "index": 1, "bbox": [0.882, 0.061, 0.909, 0.073], "content": [{"type": "text", "content": "31"}]}, {"type": "text", "index": 2, "bbox": [0.076, 0.094, 0.945, 0.224], "content": [{"type": "text", "content": "代换密码的数学模型如下:设明文空间 P 和密文空间 C 均为  "}, {"type": "equation_inline", "content": "Z_{26}=\\{0,1,2,\\cdots,25\\}"}, {"type": "text", "content": " ，即模 26 的非负最小完全剩余系的集合，密钥空间 K 是集合  "}, {"type": "equation_inline", "content": "Z_{26}=\\{0,1,2,\\cdots,25\\}"}, {"type": "text", "content": "  上全体置换构成的集合。对任意密钥  "}, {"type": "equation_inline", "content": "\\pi\\in K"}, {"type": "text", "content": " ，加密变换定义为: "}, {"type": "equation_inline", "content": "y=E_{\\pi}(x)=\\pi(x)"}, {"type": "text", "content": " ，解密变换定义为: "}, {"type": "equation_inline", "content": "x=D_{\\pi}(y)=\\pi^{-1}(y)"}, {"type": "text", "content": " ，这里  "}, {"type": "equation_inline", "content": "x\\in P"}, {"type": "text", "content": "  称为明文， "}, {"type": "equation_inline", "content": "y\\in C"}, {"type": "text", "content": "  称为密文， "}, {"type": "equation_inline", "content": "E_{\\pi}"}, {"type": "text", "content": "  称为密钥  "}, {"type": "equation_inline", "content": "\\pi"}, {"type": "text", "content": "  控制下的加密算法， "}, {"type": "equation_inline", "content": "D_{\\pi}"}, {"type": "text", "content": "  称为密钥  "}, {"type": "equation_inline", "content": "\\pi"}, {"type": "text", "content": "  控制下的解密算法， "}, {"type": "equation_inline", "content": "\\pi^{-1}"}, {"type": "text", "content": "  是  "}, {"type": "equation_inline", "content": "\\pi"}, {"type": "text", "content": "  的逆置换。"}]}, {"type": "text", "index": 3, "bbox": [0.077, 0.231, 0.946, 0.305], "content": [{"type": "text", "content": "代换密码的一个密钥刚好对应于26个数字的一个置换,所有可能的置换有26!种,这个数值超过了 "}, {"type": "equation_inline", "content": "4.0 \\times 10^{26}"}, {"type": "text", "content": " ,是一个很大的数字,因此采用穷尽密钥搜索的方法来获得密钥是比较困难的。"}]}, {"type": "text", "index": 4, "bbox": [0.078, 0.313, 0.946, 0.387], "content": [{"type": "text", "content": "代换密码的一个特殊形式是移位密码。移位密码的密钥就是集合  "}, {"type": "equation_inline", "content": "Z_{26}=\\{0,1,2,\\cdots,25\\}"}, {"type": "text", "content": "  上的一个平移，平移当然是一个置换。设平移量为  "}, {"type": "equation_inline", "content": "k\\in Z_{26}"}, {"type": "text", "content": " ，则移位密码的加、解密变换就可以定义为如下形式。"}]}, {"type": "text", "index": 5, "bbox": [0.122, 0.395, 0.91, 0.413], "content": [{"type": "text", "content": "加密变换: "}, {"type": "equation_inline", "content": "y = E_{k}(x) = x + k \\mod 26"}, {"type": "text", "content": "，解密变换: "}, {"type": "equation_inline", "content": "x = D_{k}(y) = y - k \\mod 26"}, {"type": "text", "content": "。"}]}, {"type": "text", "index": 6, "bbox": [0.078, 0.423, 0.947, 0.496], "content": [{"type": "text", "content": "特别的,当 "}, {"type": "equation_inline", "content": "k = 3"}, {"type": "text", "content": " 时,该移位密码通常叫做凯撒密码,它是两千多年前凯撒大帝所发明的密码,就是把字母表中的字母用排在它后面3位的字母来替换。使用移位密码来加密普通英文句子时,首先需要建立英文字母和模26的非负完全剩余系之间的一一对应关系,即"}]}, {"type": "equation", "index": 7, "bbox": [0.37, 0.504, 0.656, 0.521], "content": "A \\leftrightarrow 0, B \\leftrightarrow 1, C \\leftrightarrow 2, \\dots , Z \\leftrightarrow 2 5"}, {"type": "text", "index": 8, "bbox": [0.079, 0.532, 0.383, 0.55], "content": [{"type": "text", "content": "两者之间的对应关系见表1.1。"}]}, {"type": "table", "index": 10, "bbox": [0.082, 0.58, 0.944, 0.673], "content": [{"type": "table_caption", "index": 9, "bbox": [0.234, 0.561, 0.792, 0.577], "content": [{"type": "text", "content": "表 1.1 26 个英文字母和模 26 的非负完全剩余系之间的对应关系"}]}, {"type": "table_body", "index": 10, "bbox": [0.082, 0.58, 0.944, 0.673], "content": "<table><tr><td>A</td><td>B</td><td>C</td><td>D</td><td>E</td><td>F</td><td>G</td><td>H</td><td>I</td><td>J</td><td>K</td><td>L</td><td>M</td></tr><tr><td>0</td><td>1</td><td>2</td><td>3</td><td>4</td><td>5</td><td>6</td><td>7</td><td>8</td><td>9</td><td>10</td><td>11</td><td>12</td></tr><tr><td>N</td><td>O</td><td>P</td><td>Q</td><td>R</td><td>S</td><td>T</td><td>U</td><td>V</td><td>W</td><td>X</td><td>Y</td><td>Z</td></tr><tr><td>13</td><td>14</td><td>15</td><td>16</td><td>17</td><td>18</td><td>19</td><td>20</td><td>21</td><td>22</td><td>23</td><td>24</td><td>25</td></tr></table>"}, {"type": "table_caption", "index": 11, "bbox": [0.123, 0.689, 0.812, 0.734], "content": [{"type": "text", "content": "例 1.20 假设移位密码的密钥为 k = 11，试用移位密码加密如下明文\nWewillmeetatmidnight"}]}, {"type": "table_caption", "index": 12, "bbox": [0.082, 0.744, 0.3, 0.761], "content": [{"type": "text", "content": "然后用解密变换验证。"}]}, {"type": "table_caption", "index": 13, "bbox": [0.124, 0.778, 0.884, 0.797], "content": [{"type": "text", "content": "解 首先将明文中的字母根据表 1.1 对应于相应的整数,得到如下明文数字串"}]}]}, {"type": "equation", "index": 14, "bbox": [0.124, 0.805, 0.901, 0.823], "content": "2 2 \\quad 4 \\quad 2 2 \\quad 8 \\quad 1 1 \\quad 1 1 \\quad 1 2 \\quad 4 \\quad 4 \\quad 1 9 \\quad 0 \\quad 1 9 \\quad 1 2 \\quad 8 \\quad 3 \\quad 1 3 \\quad 8 \\quad 6 \\quad 7 \\quad 1 9"}, {"type": "text", "index": 15, "bbox": [0.081, 0.833, 0.949, 0.878], "content": [{"type": "text", "content": "然后将明文数字串中每一个数字都与11相加,再对其和数取模26运算,得到如下密文数字串"}]}, {"type": "table", "index": 16, "bbox": [0.101, 0.887, 0.931, 0.905], "content": [{"type": "table_body", "index": 16, "bbox": [0.101, 0.887, 0.931, 0.905], "content": "<table><tr><td>7</td><td>15</td><td>7</td><td>19</td><td>22</td><td>22</td><td>23</td><td>15</td><td>15</td><td>4</td><td>11</td><td>4</td><td>23</td><td>19</td><td>14</td><td>24</td><td>19</td><td>17</td><td>18</td><td>4</td></tr></table>"}]}, {"type": "text", "index": 17, "bbox": [0.081, 0.914, 0.819, 0.933], "content": [{"type": "text", "content": "最后将密文数字串中的每一个数字根据表 1.1 转化为相应的字母, 得到密文"}]}]}, {"page_idx": 44, "blocks": [{"type": "page_number", "index": 0, "bbox": [0.079, 0.055, 0.107, 0.069], "content": [{"type": "text", "content": "32"}]}, {"type": "header", "index": 1, "bbox": [0.399, 0.053, 0.56, 0.069], "content": [{"type": "text", "content": "信息安全数学基础"}]}, {"type": "paragraph_title", "index": 2, "bbox": [0.314, 0.088, 0.648, 0.105], "content": [{"type": "text", "content": "HPHTWWXPPELEXTOYTRSE"}], "level": 2}, {"type": "text", "index": 3, "bbox": [0.045, 0.115, 0.912, 0.161], "content": [{"type": "text", "content": "将上面的过程逆回去, 只需要将密码数字串中每一个数字都减去 11 后取模 26 运算, 就可以将密文恢复成明文。"}]}, {"type": "text", "index": 4, "bbox": [0.091, 0.171, 0.568, 0.189], "content": [{"type": "text", "content": "如果代换密码中的加、解密变换定义为如下形式。"}]}, {"type": "text", "index": 5, "bbox": [0.091, 0.199, 0.498, 0.216], "content": [{"type": "text", "content": "加密变换: "}, {"type": "equation_inline", "content": "y = E_{k}(x) = ax + b \\mod 26"}, {"type": "text", "content": ";"}]}, {"type": "text", "index": 6, "bbox": [0.091, 0.227, 0.539, 0.245], "content": [{"type": "text", "content": "解密变换: "}, {"type": "equation_inline", "content": "x = D_{k}(y) = a^{-1}(y - b)\\bmod 26"}]}, {"type": "text", "index": 7, "bbox": [0.046, 0.256, 0.914, 0.304], "content": [{"type": "text", "content": "这里 "}, {"type": "equation_inline", "content": "(a, b) \\in \\mathbb{Z}_{26}^{*} \\times \\mathbb{Z}_{26}"}, {"type": "text", "content": ", 其中 "}, {"type": "equation_inline", "content": "\\mathbb{Z}_{26}^{*} = \\{a \\mid a \\in \\mathbb{Z}_{26}, (a, 26) = 1\\}"}, {"type": "text", "content": ", "}, {"type": "equation_inline", "content": "a^{-1}"}, {"type": "text", "content": " 是 "}, {"type": "equation_inline", "content": "a"}, {"type": "text", "content": " 模 26 的乘法逆元, 即 "}, {"type": "equation_inline", "content": "a^{-1} \\in \\mathbb{Z}_{26}^{*}"}, {"type": "text", "content": " 满足 "}, {"type": "equation_inline", "content": "aa^{-1} \\equiv 1 \\bmod 26"}, {"type": "text", "content": ", 那么该代换密码称为仿射密码。"}]}, {"type": "paragraph_title", "index": 8, "bbox": [0.091, 0.32, 0.855, 0.339], "content": [{"type": "text", "content": "例 1.21 假设仿射密码的密钥为 "}, {"type": "equation_inline", "content": "\\left( {a,b}\\right)  = \\left( {7,3}\\right)"}, {"type": "text", "content": " ,试用仿射密码加密如下明文"}], "level": 2}, {"type": "paragraph_title", "index": 9, "bbox": [0.366, 0.348, 0.594, 0.367], "content": [{"type": "text", "content": "Wewillmeetatmidnight"}], "level": 2}, {"type": "text", "index": 10, "bbox": [0.092, 0.383, 0.416, 0.401], "content": [{"type": "text", "content": "解 由例1.20知，明文数字串为"}]}, {"type": "equation", "index": 11, "bbox": [0.094, 0.411, 0.867, 0.429], "content": "2 2 \\quad 4 \\quad 2 2 \\quad 8 \\quad 1 1 \\quad 1 1 \\quad 1 2 \\quad 4 \\quad 4 \\quad 1 9 \\quad 0 \\quad 1 9 \\quad 1 2 \\quad 8 \\quad 3 \\quad 1 3 \\quad 8 \\quad 6 \\quad 7 \\quad 1 9"}, {"type": "text", "index": 12, "bbox": [0.048, 0.438, 0.914, 0.485], "content": [{"type": "text", "content": "对明文数字串的每一位数字执行加密变换  "}, {"type": "equation_inline", "content": "y = E_{(7,3)}(x) = 7x + 3 \\mod 26"}, {"type": "text", "content": "  就可以得到密文数字串"}]}, {"type": "equation", "index": 13, "bbox": [0.135, 0.493, 0.83, 0.512], "content": "1 \\quad 5 \\quad 1 \\quad 7 \\quad 2 \\quad 2 \\quad 9 \\quad 5 \\quad 5 \\quad 6 \\quad 3 \\quad 6 \\quad 9 \\quad 7 \\quad 2 4 \\quad 1 6 \\quad 7 \\quad 1 9 \\quad 0 \\quad 6"}, {"type": "text", "index": 14, "bbox": [0.048, 0.521, 0.538, 0.539], "content": [{"type": "text", "content": "从而得到密文为 BFBHCCJFFGDGJHYQHTAG。"}]}, {"type": "text", "index": 15, "bbox": [0.048, 0.548, 0.917, 0.679], "content": [{"type": "text", "content": "注意到 "}, {"type": "equation_inline", "content": "\\left| {\\mathbb{Z}}_{26}\\right|  = {26},\\left| {\\mathbb{Z}}_{26}^{ * }\\right|  = \\varphi \\left( {26}\\right)  = {12}"}, {"type": "text", "content": " ,这表明移位密码的密钥量只有 26,仿射密 码的密钥量为 "}, {"type": "equation_inline", "content": "{12} \\times  {26} = {312}"}, {"type": "text", "content": " ,采用穷尽密钥搜索的方法就很容易攻破这两个密码体制。 尽管代换密码的密钥量为 26!, 是一个很大的数字, 但注意到英文单个字母或者多个字母 在英文句子中出现的频率具有明显特征,在收集大量密文的情况下,根据字母的频率分布 特征可以破译普通的代换密码。"}]}, {"type": "text", "index": 16, "bbox": [0.049, 0.687, 0.918, 0.789], "content": [{"type": "text", "content": "在上面介绍的移位密码和仿射密码中,一旦密钥确定,则每个字母对应的数字都被加密变换成对应的唯一数字,这种密码体制被称为单表代换密码。单表代换密码的缺陷是不能隐藏英文字母的频率分布规律。维吉尼亚密码和希尔密码是代换密码的扩展形式,通过多表代换的形式,克服单表代换密码的频率缺陷。"}]}, {"type": "text", "index": 17, "bbox": [0.049, 0.797, 0.917, 0.843], "content": [{"type": "text", "content": "维吉尼亚密码的数学模型是: 设 m 是一个正整数, 定义明文空间、密文空间和密钥空间如下"}]}, {"type": "equation", "index": 18, "bbox": [0.143, 0.852, 0.825, 0.87], "content": "P = C = K = (\\mathbb {Z} _ {2 6}) ^ {m} = \\{(x _ {1}, x _ {2}, \\dots , x _ {m}) | x _ {i} \\in \\mathbb {Z} _ {2 6}, i = 1, 2, \\dots , m \\}"}, {"type": "text", "index": 19, "bbox": [0.05, 0.88, 0.735, 0.898], "content": [{"type": "text", "content": "对任意密钥  "}, {"type": "equation_inline", "content": "k=(k_{1},k_{2},\\cdots,k_{m})\\in K"}, {"type": "text", "content": " ，加密变换和解密变换定义如下:"}]}, {"type": "text", "index": 20, "bbox": [0.094, 0.908, 0.911, 0.927], "content": [{"type": "text", "content": "加密变换: "}, {"type": "equation_inline", "content": "(y_{1},y_{2},\\cdots,y_{m})=E_{k}(x_{1},x_{2},\\cdots,x_{m})=(x_{1}+k_{1},x_{2}+k_{2},\\cdots,x_{m}+k_{m})\\bmod26;"}]}]}, {"page_idx": 45, "blocks": [{"type": "header", "index": 0, "bbox": [0.414, 0.061, 0.576, 0.076], "content": [{"type": "text", "content": "第1章 数论基础"}]}, {"type": "page_number", "index": 1, "bbox": [0.868, 0.063, 0.895, 0.075], "content": [{"type": "text", "content": "33"}]}, {"type": "text", "index": 2, "bbox": [0.106, 0.096, 0.921, 0.115], "content": [{"type": "text", "content": "解密变换: "}, {"type": "equation_inline", "content": "(x_{1},x_{2},\\cdots,x_{m})=D_{k}(y_{1},y_{2},\\cdots,y_{m})=(y_{1}-k_{1},y_{2}-k_{2},\\cdots,y_{m}-k_{m})\\bmod26"}, {"type": "text", "content": " 。"}]}, {"type": "text", "index": 3, "bbox": [0.062, 0.123, 0.93, 0.198], "content": [{"type": "text", "content": "同样根据对应关系  "}, {"type": "equation_inline", "content": "A \\leftrightarrow 0, B \\leftrightarrow 1, C \\leftrightarrow 2, \\cdots, Z \\leftrightarrow 25"}, {"type": "text", "content": " ，将英文字母和模 26 的非负最小完全剩余系对应，则每个密钥  "}, {"type": "equation_inline", "content": "k = (k_{1}, k_{2}, \\cdots, k_{m})"}, {"type": "text", "content": "  相当一个长度为 m 的字母串，该字母串称为密钥字。与单表代换密码不同，维吉尼亚密码一次加密 m 个明文字母。"}]}, {"type": "text", "index": 4, "bbox": [0.107, 0.213, 0.836, 0.26], "content": [{"type": "text", "content": "例 1.22 假设 m = 6，密钥字为“cipher”，试用维吉尼亚密码加密如下明文 thiscryptosystemisnotsecure"}]}, {"type": "text", "index": 5, "bbox": [0.063, 0.276, 0.931, 0.349], "content": [{"type": "text", "content": "解 根据英文字母和数字的对应规则,密钥字“cipher”对应的密钥为  "}, {"type": "equation_inline", "content": "k=(2,8,15,7,4,17)"}, {"type": "text", "content": " 。将明文串转化为对应的数字串,每6个为一组,使用密钥  "}, {"type": "equation_inline", "content": "k=(2,8,15,7,4,17)"}, {"type": "text", "content": "  进行模26下的加法运算,如下所示:"}]}, {"type": "table", "index": 6, "bbox": [0.067, 0.352, 0.921, 0.507], "content": [{"type": "table_body", "index": 6, "bbox": [0.067, 0.352, 0.921, 0.507], "content": "<table><tr><td>19</td><td>7</td><td>8</td><td>18</td><td>2</td><td>17</td><td>24</td><td>15</td><td>19</td><td>14</td><td>18</td><td>24</td><td>18</td><td>19</td><td>4</td><td>12</td><td>8</td><td>1