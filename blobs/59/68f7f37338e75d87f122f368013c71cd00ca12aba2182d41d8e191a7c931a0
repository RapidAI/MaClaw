ext", "content": " ，这里 "}, {"type": "equation_inline", "content": "0\\leqslant r_1,r_2 <   b"}, {"type": "text", "content": " ，则"}]}, {"type": "equation", "index": 12, "bbox": [0.415, 0.408, 0.618, 0.426], "content": "(q _ {1} - q _ {2}) b = r _ {2} - r _ {1}"}, {"type": "text", "index": 13, "bbox": [0.083, 0.434, 0.949, 0.48], "content": [{"type": "text", "content": "若 "}, {"type": "equation_inline", "content": "q_{1} \\neq q_{2}"}, {"type": "text", "content": ", 则 "}, {"type": "equation_inline", "content": "|r_{2} - r_{1}| \\geqslant b"}, {"type": "text", "content": ", 这与 "}, {"type": "equation_inline", "content": "0 \\leqslant r_{1}, r_{2} < b"}, {"type": "text", "content": " 矛盾! 故 "}, {"type": "equation_inline", "content": "q_{1} = q_{2}"}, {"type": "text", "content": ", 从而 "}, {"type": "equation_inline", "content": "r_{1} = r_{2}"}, {"type": "text", "content": ", 唯一性得以证明。"}]}, {"type": "text", "index": 14, "bbox": [0.083, 0.489, 0.95, 0.535], "content": [{"type": "text", "content": "定义 1.2 设 "}, {"type": "equation_inline", "content": "a, b \\in \\mathbb{Z}, b \\neq 0"}, {"type": "text", "content": ", 如果 "}, {"type": "equation_inline", "content": "a = bq + r"}, {"type": "text", "content": ", 这里 "}, {"type": "equation_inline", "content": "0 \\leqslant r < |b|"}, {"type": "text", "content": ", 则称 "}, {"type": "equation_inline", "content": "q"}, {"type": "text", "content": " 为 "}, {"type": "equation_inline", "content": "b"}, {"type": "text", "content": " 除 "}, {"type": "equation_inline", "content": "a"}, {"type": "text", "content": " 所得商, "}, {"type": "equation_inline", "content": "r"}, {"type": "text", "content": " 为 "}, {"type": "equation_inline", "content": "b"}, {"type": "text", "content": " 除 "}, {"type": "equation_inline", "content": "a"}, {"type": "text", "content": " 所得的余数。"}]}, {"type": "text", "index": 15, "bbox": [0.127, 0.551, 0.69, 0.569], "content": [{"type": "text", "content": "利用带余除法容易判定两个整数的整除关系,即定理 1.2。"}]}, {"type": "text", "index": 16, "bbox": [