, 0.074], "content": [{"type": "text", "content": "100"}]}, {"type": "header", "index": 1, "bbox": [0.419, 0.06, 0.581, 0.075], "content": [{"type": "text", "content": "信息安全数学基础"}]}, {"type": "text", "index": 2, "bbox": [0.063, 0.094, 0.935, 0.169], "content": [{"type": "text", "content": "一个元素,也可以用 n 种方法选取排列的第二个元素,……,同样可以用 n 种方法选取排列的第 r 个元素,并且选取不同元素的方法互不相关,由乘法法则可知,可重 r 个元素的排列的个数为  "}, {"type": "equation_inline", "content": "n^{r}"}, {"type": "text", "content": " 。"}], "continues_prev": true}, {"type": "text", "index": 3, "bbox": [0.063, 0.178, 0.935, 0.281], "content": [{"type": "text", "content": "(2) 由于排列与组合的个数与元素的具体形式没有关系, 不妨设 "}, {"type": "equation_inline", "content": "n"}, {"type": "text", "content": " 个元素分别为 "}, {"type": "equation_inline", "content": "1, 2, \\cdots, n"}, {"type": "text", "content": "。如果 "}, {"type": "equation_inline", "content": "\\{a_{1}, a_{2}, \\cdots, a_{r}\\}"}, {"type": "text", "content": " 是 "}, {"type": "equation_inline", "content": "n"}, {"type": "text", "content": " 元集合 "}, {"type": "equation_inline", "content": "\\{1, 2, \\cdots, n\\}"}, {"type": "text", "content": " 上的一个可重 "}, {"type": "equation_inline", "content": "r"}, {"type": "text", "content": " 个元素的组合, 不妨设 "}, {"type": "equation_inline", "content": "a_{1} \\leqslant a_{2} \\leqslant \\cdots \\leqslant a_{r}"}, {"type": "text", "content": "。从这个 "}, {"type": "equation_inline", "content": "r"}, {"type": "text", "content": " 组合可以构造 "}, {"type": "equation_inline", "content": "n + r - 1"}, {"type": "text", "content": " 元集合 "}, {"type": "equation_inline", "content": "\\{1, 2, \\cdots, n + r - 1\\}"}, {"type": "text", "content": " 上的不可重 "}, {"type": "equation_inline", "content": "r"}, {"type": "text", "content": " 个元素的组合"}]}, {"type": "equation", "index": 4, "bbox": [0.274, 0.29, 0.726, 0.308], "content": "\\{b _ {1}, b _ {2}, \\dots , b _ {r} \\} = \\{a _ {1}, a _ {2} + 1, \\dots , a _ {r} + (r - 1) \\}"}, {"type": "text", "index": 5, "bbox": [0.065, 0.319, 0.935, 0.395], "content": [{"type": "text", "content": "反之,给定集合 "}, {"type": "equation_inline", "content": "\\{1,2,\\cdots,n+r-1\\}"}, {"type": "text", "content": " 上一个不可重 "}, {"type": "equation_inline", "content": "r"}, {"type": "text", "content": " 个元素的组合 "}, {"type": "equation_inline", "content": "\\{b_{1},b_{2},\\cdots,b_{r}\\}"}, {"type": "text", "content": ", 这里 "}, {"type": "equation_inline", "content": "1 \\leqslant b_{1} < b_{2} < \\cdots < b_{r} \\leqslant n+r-1"}, {"type": "text", "content": ", 按如下方式可以得到集合 "}, {"type": "equation_inline", "content": "\\{1,2,\\cdots,n\\}"}, {"type": "text", "content": " 上的一个可重 "}, {"type": "equation_inline", "content": "r"}, {"type": "text", "content": " 个元素的组合"}]}, {"type": "equation", "index": 6, "bbox": [0.275, 0.403, 0.727, 0.422], "content": "\\{a _ {1}, a _ {2}, \\dots , a _ {r} \\} = \\{b _ {1}, b _ {2} - 1, \\dots , b _ {r} - (r - 1) \\}"}, {"type": "text", "index": 7, "bbox": [0.066, 0.431, 0.934, 0.478], "content": [{"type": "text", "content": "这表明 "}, {"type": "equation_inline", "content": "n"}, {"type": "text", "content": " 个元素的可重 "}, {"type": "equation_inline", "content": "r"}, {"type": "text", "content": " 个元素的组合与 "}, {"type": "equation_inline", "content": "n + r - 1"}, {"type": "text", "content": " 个元素的不可重 "}, {"type": "equation_inline", "content": "r"}, {"type": "text", "content": " 个元素的组合之间有一一对应的关系, 从而 "}, {"type": "equation_inline", "content": "n"}, {"type": "text", "content": " 个元素的可重 "}, {"type": "equation_inline", "content": "r"}, {"type": "text", "content": " 个元素的组合的个数为 "}, {"type": "equation_inline", "content": "C(n + r - 1, r)"}, {"type": "text", "content": " 。"}]}, {"type": "text", "index": 8, "bbox": [0.065, 0.514, 0.938, 0.644], "content": [{"type": "text", "content": "可重 r 个元素的排列(简称 r 排列)和可重 r 个元素的组合(简称 r 组合)中 r 值可以是任意自然数,也就是 r 的取值可以比 n 的取值大。n 个元素的可重 r 排列的典型问题是将 r 个不同的球放到 n 个有区别的盒子,而求每个盒子的球不加限制的方案数。n 个元素的可重 r 组合的典型问题是将 r 个相同的球,放到 n 个有区别的盒子中,而求每个盒子的球不加限制的方案数。"}]}, {"type": "text", "index": 9, "bbox": [0.068, 0.659, 0.936, 0.706], "content": [{"type": "text", "content": "例 3.8 一家面包房生产 8 种炸面饼圈。如果一盒内装有一打炸面饼圈, 那么能够买多少种不同的盒装炸面饼圈?"}]}, {"type": "text", "index": 10, "bbox": [0.067, 0.722, 0.938, 0.797], "content": [{"type": "text", "content": "解 由于盒中的炸面饼圈顺序与购买者无关,所以这是一个组合问题,相当于从8种不同的炸面饼圈中,取出12个做可重组合,共有 "}, {"type": "equation_inline", "content": "C(8+12-1,12)=C(19,12)=50\\ 388"}, {"type": "text", "content": " 种不同的盒装炸面饼圈。"}]}, {"type": "paragraph_title", "index": 11, "bbox": [0.068, 0.83, 0.422, 0.852], "content": [{"type": "text", "content": "3.2 容斥原理与鸽笼原理"}], "level": 2}, {"type": "text", "index": 12, "bbox": [0.068, 0.886, 0.939, 0.934], "content": [{"type": "text", "content": "在使用加法法则时,要求事件A和事件B是两类不同的事件,也就是事件A和事件B没有相同的产生方式。如果事件A与事件B有相同的产生方式,就需使用容斥原理来解"}]}]}, {"page_idx": 113, "blocks": [{"type": "header", "index": 0, "bbox": [0.411, 0.06, 0.573, 0.075], "content": [{"type": "text", "content": "第3章 组合数学"}]}, {"type": "page_number", "index": 1, "bbox": [0.855, 0.061, 0.892, 0.074], "content": [{"type": "text", "content": "101"}]}, {"type": "text", "index": 2, "bbox": [0.059, 0.095, 0.188, 0.113], "content": [{"type": "text", "content": "决计数问题。"}]}, {"type": "text", "index": 3, "bbox": [0.103, 0.122, 0.66, 0.14], "content": [{"type": "text", "content": "容斥原理的数学原理如下: 设 A, B 是两个有限集合, 则有"}]}, {"type": "equation", "index": 4, "bbox": [0.318, 0.147, 0.666, 0.167], "content": "\\left| A \\cup B \\right| = \\left| A \\right| + \\left| B \\right| - \\left| A \\cap B \\right|"}, {"type": "text", "index": 5, "bbox": [0.062, 0.176, 0.929, 0.251], "content": [{"type": "text", "content": "这是因为集合 A, B 之间可能有公共元素, 其个数为  "}, {"type": "equation_inline", "content": "\\left|A \\cap B\\right|"}, {"type": "text", "content": " , 这些元素在计算  "}, {"type": "equation_inline", "content": "\\left|A \\cup B\\right|"}, {"type": "text", "content": "  时只计数了一次, 但在计算  "}, {"type": "equation_inline", "content": "\\left|A\\right| + \\left|B\\right|"}, {"type": "text", "content": "  时, 却被计算了两次, 故应从  "}, {"type": "equation_inline"