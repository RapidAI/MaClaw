\\cup A _ {n - 1} \\right| + \\left| A _ {n} \\right| - \\left| (A _ {1} \\cup A _ {2} \\cup \\dots \\cup A _ {n - 1}) \\cap A _ {n} \\right| \\\\ \\quad = \\sum_ {i = 1} ^ {n - 1} \\left| A _ {i} \\right| - \\sum_ {1 \\leqslant i <   j \\leqslant n - 1} \\left| A _ {i} \\cap A _ {j} \\right| + \\sum_ {1 \\leqslant i <   j <   k \\leqslant n - 1} \\left| A _ {i} \\cap A _ {j} \\cap A _ {k} \\right| - \\dots - \\\\ \\quad (- 1) ^ {n - 2} \\left| A _ {1} \\cap A _ {2} \\cap \\dots \\cap A _ {n - 2} \\right| + \\left| A _ {n} \\right| - \\left| (A _ {1} \\cap A _ {n}) \\cup (A _ {2} \\cap A _ {n}) \\cup \\dots \\cup (A _ {n - 1} \\cap A _ {n}) \\right| \\\\ \\quad = \\sum_ {i = 1} ^ {n - 1} \\left| A _ {i} \\right| - \\sum_ {1 \\leqslant i <   j \\leqslant n - 1} \\left| A _ {i} \\cap A _ {j} \\right| + \\sum_ {1 \\leqslant i <   j <   k \\leqslant n - 1} \\left| A _ {i} \\cap A _ {j} \\cap A _ {k} \\right| - \\dots - \\end{array}"}]}, {"page_idx": 114, "blocks": [{"type": "page_number", "index": 0, "bbox": [0.093, 0.057, 0.131, 0.07], "content": [{"type": "text", "content": "102"}]}, {"type": "header", "index": 1, "bbox": [0.414, 0.055, 0.575, 0.071], "content": [{"type": "text", "content": "信息安全数学基础"}]}, {"type": "equation", "index": 2, "bbox": [0.161, 0.087, 0.826, 0.25], "content": "\\begin{array}{l} (- 1) ^ {n - 2} \\left| A _ {1} \\cap A _ {2} \\cap \\dots \\cap A _ {n - 1} \\right| + \\left| A _ {n} \\right| - \\left[ \\sum_ {i = 1} ^ {n - 1} \\left| A _ {i} \\cap A _ {n} \\right| - \\right. \\\\ \\left. \\sum_ {1 \\leqslant i <   j \\leqslant n - 1} \\left| A _ {i} \\cap A _ {j} \\cap A _ {n} \\right| + \\dots + (- 1) ^ {n - 2} \\left| A _ {1} \\cap A _ {2} \\cap \\dots \\cap A _ {n} \\right| \\right] \\\\ = \\sum_ {i = 1} ^ {n} \\left| A _ {i} \\right| - \\sum_ {1 \\leqslant i <   j \\leqslant n} \\left| A _ {i} \\cap A _ {j} \\right| + \\sum_ {1 \\leqslant i <   j <   k \\leqslant n} \\left| A _ {i} \\cap A _ {j} \\cap A _ {k} \\right| - \\dots + \\\\ (- 1) ^