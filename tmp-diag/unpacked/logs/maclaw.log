2026/11/26 15:13:36 workflow_v2_integration.go:4464: [workflow-v2-template] Coding Agent Event: {"version":1,"agent":"coding","event":"tool_started","phase":"running","task_id":"T1","title":"继续","ts":"2026-11-26T07:13:36.3147585Z","detail":"ssh","command":"cd /root/qm26work/qmobjdetv26 \u0026\u0026 cat \u003e benchmarks/t18/concurrency.sh \u003c\u003c'EOF'\n#!/usr/bin/env bash\n# T18 - concurrency regression check for the stride-2 fusion.\n#\n# The fusion changes the graph, so the cells that matter for a *deployment* are\n# not only the single-process ones: this engine is used one process per frame, and\n# the shipped concurrency recommendation is c8t1 (8 processes, 1 thread each) or\n# c1t7 for latency. If fusing eight intermediates made the fused build more\n# memory-hungry or worse at scaling, that would show up here and nowhere else.\n#\n# Each cell is run for both arms, alternating inside every rep so a slow window\n# hits both, and the aggregate fps is what is compared - not a single launch.\n#\n#   arm  a1   QM26_FUSE_S2=0 (pre-T18 graph)\n#   arm  t18  default       (fused graph)\n#\n# usage: benchmarks/t18/concurrency.sh [reps] [cells...]\nset -u\nROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/../..\" \u0026\u0026 pwd)\"\nREPS=\"${1:-3}\"; shift 2\u003e/dev/null || true\nCELLS=\"${*:-c1t1 c1t7 c2t4 c4t2 c8t1}\"\nDEMO=\"$ROOT/build/qm26_demo\"\nPARM=\"$ROOT/models/qm-yolo-fastest-opt.parm\"\nBIN=\"$ROOT/models/qm-yolo-fastest-opt.bin\"\nOUT=\"$ROOT/benchmarks/t18\"\nTSV=\"$OUT/concurrency.tsv\"\nRUNS=\"${RUNS:-10}\"\nGATE_A1=\"abs_sum=1.688995566e+07\"\nGATE_T18=\"abs_sum=1.379354999e+07\"\n\nprintf 'cell\\tarm\\trep\\tconc\\tthreads\\tms_mean\\tfps_mean\\tagg_fps\\tchecksum\\n' \u003e \"$TSV\"\necho \"# concurrency A/B  $(date -u +%Y-%m-%dT%H:%M:%SZ)  reps=$REPS runs=$RUNS loadavg $(cat /proc/loadavg)\"\n\nrun_cell() { # $1=cell $2=arm $3=rep\n  local cell=\"$1\" arm=\"$2\" rep=\"$3\"\n  local conc=\"${cell#c}\"; conc=\"${conc%%t*}\"\n  local th=\"${cell##*t}\"\n  local env_prefix=\"\"\n  [ \"$arm\" = \"a1\" ] \u0026\u0026 env_prefix=\"QM26_FUSE_S2=0\"\n  local pids=() tmp ms fps ck\n  tmp=\"$OUT/raw_${cell}_${arm}_${rep}.txt\"\n  : \u003e \"$tmp\"\n  local k\n  for k in $(seq 1 \"$conc\"); do\n    ( env $env_prefix \"$DEMO\" \"$PARM\" \"$BIN\" \"$RUNS\" \"$th\" \u003e \"$OUT/raw_${cell}_${arm}_${rep}_p$k.txt\" 2\u003e\u00261 ) \u0026\n    pids+=($!)\n  done\n  for p in \"${pids[@]}\"; do wait \"$p\"; done\n  ms=\"$(cat \"$OUT\"/raw_${cell}_${arm}_${rep}_p*.txt | sed -n 's/^timing *: *\\([0-9.]*\\) ms.*/\\1/p' | awk '{s+=$1;n++} END{if(n)printf \"%.3f\",s/n; else printf \"NA\"}')\"\n  fps=\"$(cat \"$OUT\"/raw_${cell}_${arm}_${rep}_p*.txt | sed -n 's/^timing *: *\\([0-9.]*\\) ms, *\\([0-9.]*\\) fps.*/\\2/p' | awk '{s+=$1;n++} END{if(n)printf \"%.2f\",s/n; else printf \"NA\"}')\"\n  agg=\"$(cat \"$OUT\"/raw_${cell}_${arm}_${rep}_p*.txt | sed -n 's/^timing *: *[0-9.]* ms, *\\([0-9.]*\\) fps.*/\\1/p' | awk '{s+=$1;n++} END{if(n)printf \"%.2f\",s; else printf \"NA\"}')\"\n  ck=\"$(cat \"$OUT\"/raw_${cell}_${arm}_${rep}_p*.txt | sed -n 's/^checksum *: *\\(abs_sum=[0-9.e+]*\\).*/\\1/p' | sort -u | tr '\\n' ' ' | sed 's/ $//')\"\n  printf '%s\\t%s\\t%s\\t%s\\t%s\\t%s\\t%s\\t%s\\t%s\\n' \"$cell\" \"$arm\" \"$rep\" \"$conc\" \"$th\" \"$ms\" \"$fps\" \"$agg\" \"$ck\" \u003e\u003e \"$TSV\"\n  rm -f \"$OUT\"/raw_${cell}_${arm}_${rep}_p*.txt\n}\n\nfor rep in $(seq 1 \"$REPS\"); do\n  for cell in $CELLS; do\n    if [ $((rep % 2)) -eq 1 ]; then arms=\"a1 t18\"; else arms=\"t18 a1\"; fi\n    for arm in $arms; do run_cell \"$cell\" \"$arm\" \"$rep\"; done\n  done\n  echo \"# rep $rep/$REPS done  loadavg=$(cut -d' ' -f1-3 /proc/loadavg)\"\ndone\n\nbad=$(awk -F'\\t' 'NR\u003e1 { want=($2==\"a1\")?v_a1:v_t18; if ($9!=want) n++ }\n                 BEGIN{}' v_a1=\"$GATE_A1\" v_t18=\"$GATE_T18\" \"$TSV\")\nbad=$(awk -F'\\t' -v ga=\"$GATE_A1\" -v gt=\"$GATE_T18\" \\\n      'NR\u003e1 { want=($2==\"a1\")?ga:gt; if ($9!=want) n++ } END{print n+0}' \"$TSV\")\nif [ \"$bad\" -gt 0 ]; then echo \"FAIL: $bad group(s) with a drifted checksum\" \u003e\u00262; exit 2; fi\necho \"# gate ok: every group checksummed the value that belongs to its arm\"\n\npython3 - \"$TSV\" \u003c\u003c'PY'\nimport statistics, sys\nrows = {}\nwith open(sys.argv[1]) as f:\n    f.readline()\n    for line in f:\n        p = line.rstrip(\"\\n\").split(\"\\t\")\n        if len(p) != 9 or p[7] == \"NA\":\n            continue\n        rows.setdefault((p[0], p[1]), []).append(float(p[7]))\ncells = []\nfor (c, a) in rows:\n    if c not in cells: cells.append(c)\norder = [\"c1t1\", \"c1t7\", \"c2t4\", \"c4t2\", \"c8t1\"]\ncells.sort(key=lambda c: order.index(c) if c in order else 99)\nprint(\"\")\nprint(\"cell   agg_fps a1     agg_fps t18    delta      n\")\nprint(\"-\" * 52)\nfor c in cells:\n    a = rows.get((c, \"a1\"), []); b = rows.get((c, \"t18\"), [])\n    if not a or not b: continue\n    ma, mb = statistics.median(a), statistics.median(b)\n    print(\"%-6s %10.2f   %10.2f   %+7.1f%%   %d/%d\"\n          % (c, ma, mb, 100.0 * (mb / ma - 1.0), len(a), len(b)))\nPY\nEOF\nchmod +x benchmarks/t18/concurrency.sh \u0026\u0026 bash -n benchmarks/t18/concurrency.sh \u0026\u0026 echo \"syntax OK\""}
