ies are the ones taken before the first edit of their round and have never\n# been rewritten since, so restoring from them is a byte-level statement.\n#\n#   t18       A1 dispatch + stride-2 fusion on by default (current shipping)\n#   a1        A1 dispatch + fusion off (the T17 shipping state)\n#   baseline  neither change (the delivered tree)\ncase \"$TARGET\" in\n  t18)\n    FROM_D=\"$BK8/kernels_dispatch.cpp.a1\"; WANT_D=\"$MD5_A1_SRC\"\n    FROM_M=\"$BK8/model.cpp.t18\";           WANT_M=\"$MD5_T18_MODEL\"\n    WANT_BIN=\"$MD5_T18_BIN\"; GATE=\"$GATE_T18\" ;;\n  a1)\n    FROM_D=\"$BK8/kernels_dispatch.cpp.a1\"; WANT_D=\"$MD5_A1_SRC\"\n    FROM_M=\"$BK8/model.cpp.a1\";            WANT_M=\"$MD5_PRE_MODEL\"\n    WANT_BIN=\"$MD5_A1_BIN\"; GATE=\"$GATE_PRE\" ;;\n  baseline)\n    FROM_D=\"$BK/kernels_dispatch.cpp.orig\"; WANT_D=\"$MD5_BASE_SRC\"\n    FROM_M=\"$BK/model.cpp.orig\";            WANT_M=\"$MD5_PRE_MODEL\"\n    WANT_BIN=\"$MD5_BASE_BIN\"; GATE=\"$GATE_PRE\" ;;\nesac\n\nfor f in \"$FROM_D\" \"$FROM_M\" \"$SRC\" \"$SRC_M\"; do\n  [ -e \"$f\" ] || { echo \"missing: $f\" \u003e\u00262; exit 1; }\ndone\ngot_d=\"$(md5f \"$FROM_D\")\"; got_m=\"$(md5f \"$FROM_M\")\"\nif [ \"$got_d\" != \"$WANT_D\" ]; then\n  echo \"dispatch source to restore has md5 $got_d, pinned $WANT_D - refusing\" \u003e\u00262\n  echo \"the backup itself changed; find out why before restoring from it\" \u003e\u00262\n  exit 1\nfi\nif [ \"$got_m\" != \"$WANT_M\" ]; then\n  echo \"model source to restore has md5 $got_m, pinned $WANT_M - refusing\" \u003e\u00262\n  echo \"the backup itself changed; find out why before restoring from it\" \u003e\u00262\n  exit 1\nfi\n\necho \"# rollback_final  $(date -u +%Y-%m-%dT%H:%M:%SZ)\"\necho \"# now      $(state_of \"$src_now\" \"$model_now\")  (dispatch $src_now, model $model_now, binary $bin_now)\"\necho \"# target   $TARGET   gate $GATE\"\necho \"# from     $FROM_D  md5 $got_d\"\necho \"# from     $FROM_M  md5 $got_m\"\n'''\nassert s.count(old)==1\ns=s.