2026/11/26 15:05:52 workflow_v2_integration.go:4464: [workflow-v2-template] Coding Agent Event: {"version":1,"agent":"coding","event":"tool_started","phase":"running","task_id":"T1","title":"继续","ts":"2026-11-26T07:05:52.2449846Z","detail":"ssh","command":"cd /root/qm26work/qmobjdetv26 \u0026\u0026 python3 - \u003c\u003c'PY'\nimport io\np='sources/model.cpp'\ns=io.open(p,encoding='utf-8').read()\nold='''// Whether the stride-2 inverted-residual triples may be fused too.\n//\n// Off by default: fusing them deletes the expand and depthwise blobs of twelve\n// layers from the tensor set, so the 110-line blob dump the regression gate is\n// pinned to changes. The knob exists so the timing claim can be measured on one\n// source tree; shipping it is a gate decision, not a kernel decision.\nstatic bool fuse_s2_enabled()\n{\n    static const bool on = []() {\n        const char* e = getenv(\"QM26_FUSE_S2\");\n        return e \u0026\u0026 *e \u0026\u0026 atoi(e) != 0;\n    }();\n    return on;\n}'''\nnew='''// Whether the stride-2 inverted-residual triples are fused too.\n//\n// On by default since T18. T16 measured the win (-8.06%) and verified the\n// numbers but left the switch off, because fusing deletes the expand and\n// depthwise blobs of twelve layers from the tensor set and the regression gate\n// was pinned to the 110-line dump that contains them. T18 re-baselined the gate\n// fixture (102 lines, benchmarks/baseline/expected_blobs_msa.txt) so the win can\n// ship: the eight removed lines are the four downsampling triples' expand and\n// depthwise blobs, the 102 surviving blobs are byte-identical, the detection\n// fingerprint is unchanged (533 boxes, identical top-10 at t=1/2/4/7) and a\n// paired 20-pair A/B on the shipped binary measured -6.90% frame time\n// (CI95 [-9.03, -4.60], 19/20 pairs same sign, p=0.0000).\n//\n// QM26_FUSE_S2=0 restores the pre-T18 graph byte-for-byte, which is what the\n// rollback path and the pre-T18 gate fixture use. Any other value (or unset)\n// means fused.\nstatic bool fuse_s2_enabled()\n{\n    static const bool on = []() {\n        const char* e = getenv(\"QM26_FUSE_S2\");\n        return !(e \u0026\u0026 e[0] == '0' \u0026\u0026 e[1] == 0);\n    }();\n    return on;\n}'''\nassert s.count(old)==1, s.count(old)\nio.open(p,'w',encoding='utf-8',newline='').write(s.replace(old,new))\nprint('patched')\nPY\nmd5sum sources/model.cpp; grep -n \"QM26_FUSE_S2\" sources/model.cpp | head"}
