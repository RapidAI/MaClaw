SRC\") echo baseline ;;\n    \"\")              echo missing ;;\n    *)               echo unknown ;;\n  esac\n}\n'''\nnew='''md5f() { [ -f \"$1\" ] \u0026\u0026 md5sum \"$1\" | cut -d' ' -f1; }\nSRC_M=\"$ROOT/sources/model.cpp\"\nsrc_now=\"$(md5f \"$SRC\")\"\nmodel_now=\"$(md5f \"$SRC_M\")\"\nbin_now=\"$(md5f \"$DEMO\")\"\n\n# state_of \u003cdispatch-md5\u003e \u003cmodel-md5\u003e -\u003e t18 | a1 | baseline | unknown\nstate_of() {\n  case \"${1:-}/${2:-}\" in\n    \"$MD5_A1_SRC/$MD5_T18_MODEL\")    echo t18 ;;\n    \"$MD5_A1_SRC/$MD5_PRE_MODEL\")    echo a1 ;;\n    \"$MD5_BASE_SRC/$MD5_PRE_MODEL\")  echo baseline ;;\n    \"/\")                             echo missing ;;\n    *)                               echo unknown ;;\n  esac\n}\n'''\nassert s.count(old)==1\ns=s.replace(old,new)\n\nold='''  echo \"# source   kernels_dispatch.cpp  $( [ -n \"$src_now\" ] \u0026\u0026 echo \"$src_now\" || echo MISSING )  -\u003e $(state_of \"$src_now\")\"\n  echo \"# binary   build/qm26_demo       $( [ -n \"$bin_now\" ] \u0026\u0026 echo \"$bin_now\" || echo MISSING )\"\n  case \"$bin_now\" in\n    \"$MD5_A1_BIN\")   echo \"# binary is the a1 build\" ;;\n    \"$MD5_BASE_BIN\") echo \"# binary is the baseline build\" ;;\n    *)               echo \"# binary md5 matches neither pin (rebuild it)\" ;;\n  esac\n  [ -f \"$CACHE\" ] \u0026\u0026 echo \"# cache    present ($(stat -c %s \"$CACHE\") B)\" || echo \"# cache    absent\"\n  [ \"$(state_of \"$src_now\")\" = \"unknown\" ] \u0026\u0026 exit 1\n  exit 0'''\nnew='''  echo \"# source   kernels_dispatch.cpp  $( [ -n \"$src_now\" ] \u0026\u0026 echo \"$src_now\" || echo MISSING )\"\n  echo \"# source   model.cpp            $( [ -n \"$model_now\" ] \u0026\u0026 echo \"$model_now\" || echo MISSING )\"\n  echo \"# state    $(state_of \"$src_now\" \"$model_now\")\"\n  echo \"# binary   build/qm26_demo       $( [ -n \"$bin_now\" ] \u0026\u0026 echo \"$bin_now\" || echo MISSING )\"\n  case \"$bin_now\" in\n    \"$MD5_T18_BIN\")  echo \"# binary is the t18 build (fused graph, gate $GATE_T18)\" ;;\n    \"$MD5_A1_BIN\")   echo \"# binary is the a1 build (pre-T18 graph, gate $GATE_PRE)\" ;;\n    \"$MD5_BASE_BIN\") echo \"# binary is the baseline build (gate $GATE_PRE)\" ;;\n    *)               echo \"# binary md5 matches no pin (rebuild it)\" ;;\n  esac\n  [ -f \"$CACHE\" ] \u0026\u0026 echo \"# cache    present ($(stat -c %s \"$CACHE\") B)\" || echo \"# cache    absent\"\n  [ \"$(state_of \"$src_now\" \"$model_now\")\" = \"unknown\" ] \u0026\u0026 exit 1\n  exit 0'''\nassert s.count(old)==1\ns=s.replace(old,new)\nio.open(p,'w',encoding='utf-8',newline='').write(s)\nprint('patched part 1')\nPY\nbash -n benchmarks/t17/step8/rollback_final.sh \u0026\u0026 echo \"syntax OK\""}
