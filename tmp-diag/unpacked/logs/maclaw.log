2026/11/26 15:11:34 workflow_v2_integration.go:4464: [workflow-v2-template] Coding Agent Event: {"version":1,"agent":"coding","event":"tool_started","phase":"running","task_id":"T1","title":"继续","ts":"2026-11-26T07:11:34.0468138Z","detail":"ssh","command":"cd /root/qm26work/qmobjdetv26 \u0026\u0026 mkdir -p benchmarks/t18 \u0026\u0026 cat \u003e benchmarks/t18/stability.sh \u003c\u003c'EOF'\n#!/usr/bin/env bash\n# T18 - stability of the stride-2 fusion over time, on the two *shipped* binaries.\n#\n# T17 step 7 answered this question for A1 (the calibration cache). T18 asks the\n# same question for the one change it ships (QM26_FUSE_S2 on by default), and it\n# asks it in the way that survives this host's noise: alternate the two arms\n# inside every round and swap which arm goes first, so a slow window hits both.\n#\n#   a1   benchmarks/t17/step8_backup/qm26_demo.a1   pre-T18 graph, gate ...566e+07\n#   t18  build/qm26_demo                            fused graph,  gate ...999e+07\n#\n# The two arms have *different* gate values by construction - the fusion removes\n# eight intermediates - so the check is per arm, not one global constant. A single\n# constant here would either fail every t18 launch or, worse, be relaxed until it\n# checked nothing.\n#\n# usage: benchmarks/t18/stability.sh [rounds]\nset -u\nROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/../..\" \u0026\u0026 pwd)\"\nROUNDS=\"${1:-12}\"\nOUT=\"$ROOT/benchmarks/t18\"\nWRAP=\"$ROOT/benchmarks/t17/t17_run\"\nPARM=\"$ROOT/models/qm-yolo-fastest-opt.parm\"\nBIN=\"$ROOT/models/qm-yolo-fastest-opt.bin\"\nA1=\"$ROOT/benchmarks/t17/step8_backup/qm26_demo.a1\"\nT18=\"$ROOT/build/qm26_demo\"\nTSV=\"$OUT/stability.tsv\"\n\nGATE_A1=\"abs_sum=1.688995566e+07\"\nGATE_T18=\"abs_sum=1.379354999e+07\"\n\nleak=\"$(env | grep -E '^QM26_' || true)\"\n[ -n \"$leak\" ] \u0026\u0026 { echo \"refusing: QM26_* set: $leak\" \u003e\u00262; exit 3; }\nfor f in \"$A1\" \"$T18\" \"$WRAP\" \"$PARM\" \"$BIN\"; do\n  [ -e \"$f\" ] || { echo \"missing: $f\" \u003e\u00262; exit 2; }\ndone\n\nprintf 'round\\tarm\\twall_ms\\tframe_ms\\tchecksum\\n' \u003e \"$TSV\"\necho \"# t18 stability  $(date -u +%Y-%m-%dT%H:%M:%SZ)  rounds=$ROUNDS  loadavg $(cat /proc/loadavg)\"\necho \"# a1  demo md5 $(md5sum \"$A1\"  | cut -d' ' -f1)  gate $GATE_A1\"\necho \"# t18 demo md5 $(md5sum \"$T18\" | cut -d' ' -f1)  gate $GATE_T18\"\n\nfor r in $(seq 1 \"$ROUNDS\"); do\n  if [ $((r % 2)) -eq 1 ]; then arms=\"a1 t18\"; else arms=\"t18 a1\"; fi\n  for arm in $arms; do\n    if [ \"$arm\" = \"a1\" ]; then demo=\"$A1\"; else demo=\"$T18\"; fi\n    t0=$(date +%s%N)\n    o=\"$(\"$WRAP\" \"$demo\" \"$PARM\" \"$BIN\" 10 7 2\u003e\u00261)\"\n    t1=$(date +%s%N)\n    w=$(( (t1 - t0) / 1000000 ))\n    f=\"$(printf '%s\\n' \"$o\" | sed -n 's/^timing *: *\\([0-9.]*\\) ms.*/\\1/p')\"\n    c=\"$(printf '%s\\n' \"$o\" | sed -n 's/^checksum *: *\\(abs_sum=[0-9.e+]*\\).*/\\1/p')\"\n    printf '%s\\t%s\\t%s\\t%s\\t%s\\n' \"$r\" \"$arm\" \"$w\" \"${f:-NA}\" \"${c:-NA}\" \u003e\u003e \"$TSV\"\n  done\ndone\n\necho \"# rows: $TSV\"\nbad=$(awk -F'\\t' 'NR\u003e1 { want=($2==\"a1\")?\"abs_sum=1.688995566e+07\":\"abs_sum=1.379354999e+07\";\n                        if ($5!=want) n++ } END{print n+0}' \"$TSV\")\nif [ \"$bad\" -gt 0 ]; then echo \"FAIL: $bad launch(es) with a drifted checksum\" \u003e\u00262; exit 2; fi\necho \"# gate ok: every launch checksummed the value that belongs to its arm\"\n\npython3 - \"$TSV\" \u003c\u003c'PY'\nimport statistics, sys\nrows = []\nwith open(sys.argv[1]) as f:\n    f.readline()\n    for line in f:\n        p = line.rstrip(\"\\n\").split(\"\\t\")\n        if len(p) != 5 or p[2] == \"NA\":\n            continue\n        rows.append({\"round\": p[0], \"arm\": p[1], \"wall\": float(p[2]),\n                     \"frame\": float(p[3]) if p[3] != \"NA\" else None})\nprint(\"\")\nprint(\"arm   n   wall_med  wall_min  wall_max   frame_med  frame_min  frame_max\")\nprint(\"-\" * 74)\nfor arm in (\"a1\", \"t18\"):\n    a = [r for r in rows if r[\"arm\"] == arm]\n    w = [r[\"wall\"] for r in a]\n    fr = [r[\"frame\"] for r in a if r[\"frame\"]]\n    print(\"%-5s %2d  %8.0f  %8.0f  %8.0f   %9.3f  %9.3f  %9.3f\"\n          % (arm, len(a), statistics.median(w), min(w), max(w),\n             statistics.median(fr), min(fr), max(fr)))\npairs = {}\nfor r in rows:\n    pairs.setdefault(r[\"round\"], {})[r[\"arm\"]] = r\nrat = [v[\"t18\"][\"wall\"] / v[\"a1\"][\"wall\"] for v in pairs.values()\n       if \"t18\" in v and \"a1\" in v and v[\"a1\"][\"wall\"] \u003e 0]\nfrat = [v[\"t18\"][\"frame\"] / v[\"a1\"][\"frame\"] for v in pairs.values()\n        if \"t18\" in v and \"a1\" in v and v[\"a1\"][\"frame\"] and v[\"t18\"][\"frame\"]]\nprint(\"\")\nprint(\"pairs %d   wall ratio (t18/a1) med %+.1f%%  min %+.1f%%  max %+.1f%%  \"\n      \"t18 faster in %d/%d rounds\"\n      % (len(rat), 100 * (statistics.median(rat) - 1), 100 * (min(rat) - 1),\n         100 * (max(rat) - 1), sum(1 for x in rat if x \u003c 1.0), len(rat)))\nif frat:\n    print(\"          frame ratio (t18/a1) med %+.1f%%  min %+.1f%%  max %+.1f%%  \"\n          \"t18 faster in %d/%d rounds\"\n          % (100 * (statistics.median(frat) - 1), 100 * (min(frat) - 1),\n             100 * (max(frat) - 1), sum(1 for x in frat if x \u003c 1.0), len(frat)))\nPY\nEOF\nchmod +x benchmarks/t18/stability.sh \u0026\u0026 bash -n benchmarks/t18/stability.sh \u0026\u0026 echo \"syntax OK\""}
