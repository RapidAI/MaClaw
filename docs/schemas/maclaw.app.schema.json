{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maclaw.local/schemas/maclaw.app.schema.json",
  "title": "MaClaw app manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "privateMarker", "installUnit", "app"],
  "allOf": [
    {
      "if": {
        "properties": {
          "app": {
            "properties": {
              "kind": { "const": "tool_app" }
            }
          }
        },
        "required": ["installUnit", "app"]
      },
      "then": {
        "properties": {
          "installUnit": { "const": "skill" },
          "app": {
            "required": ["binding"],
            "properties": {
              "launchMode": { "const": "fixed_skill_ui" },
              "binding": {
                "required": ["skill"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "app": {
            "properties": {
              "kind": { "const": "enterprise_app" }
            }
          }
        },
        "required": ["app"]
      },
      "then": {
        "properties": {
          "app": {
            "required": ["binding"],
            "properties": {
              "launchMode": { "const": "agent_dynamic_ui" },
              "binding": {
                "required": ["datasrv"]
              }
            }
          }
        },
        "not": {
          "properties": {
            "installUnit": { "const": "skill" }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "app": {
            "properties": {
              "kind": { "const": "automation_app" }
            }
          }
        },
        "required": ["app"]
      },
      "then": {
        "properties": {
          "app": {
            "properties": {
              "launchMode": { "const": "automation_console" }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "maclaw.app.v1"
    },
    "privateMarker": {
      "description": "Private MaClaw marker for app-panel install manifests.",
      "type": "string",
      "const": "x_maclaw_apps"
    },
    "installUnit": {
      "type": "string",
      "enum": ["enterprise_app_pack", "skill", "mcp", "builtin"]
    },
    "app": {
      "$ref": "#/$defs/app"
    }
  },
  "$defs": {
    "app": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "kind", "launchMode"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "version": {
          "description": "Monotonic app definition version used for review, publish, and upgrade decisions.",
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "category": {
          "type": "string",
          "maxLength": 40
        },
        "kind": {
          "type": "string",
          "enum": ["enterprise_app", "tool_app", "automation_app"]
        },
        "icon": {
          "type": "string",
          "enum": ["receipt", "wallet", "invoice", "warehouse", "inventory", "customer", "users", "contract", "pdf", "shield", "sheet", "chart", "dashboard", "database", "eraser", "truck", "calendar", "web", "sync", "bot"]
        },
        "source": {
          "type": "string",
          "enum": ["builtin", "skill", "datasrv", "market", "local"]
        },
        "launchMode": {
          "type": "string",
          "enum": ["agent_dynamic_ui", "fixed_skill_ui", "automation_console"]
        },
        "binding": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "datasrv": {
              "$ref": "#/$defs/datasrvBinding"
            },
            "skill": {
              "$ref": "#/$defs/skillBinding"
            }
          }
        },
        "panel": {
          "$ref": "#/$defs/panel"
        },
        "governance": {
          "$ref": "#/$defs/governance"
        }
      }
    },
    "datasrvBinding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["domain"],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "preferredAction": {
          "type": "string"
        },
        "preferredView": {
          "type": "string"
        },
        "preferredReport": {
          "type": "string"
        },
        "preferredDashboard": {
          "type": "string"
        }
      }
    },
    "skillBinding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "appDefinitionFile", "inputMode"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "appDefinitionFile": {
          "type": "string",
          "const": "maclaw.apps.json"
        },
        "inputMode": {
          "type": "string",
          "enum": ["file", "form", "mixed"]
        },
        "multipleFiles": {
          "type": "boolean",
          "default": false
        },
        "outputModes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["docx", "xlsx", "pdf", "json", "txt"]
          },
          "uniqueItems": true
        },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["text", "select", "boolean"],
          "default": "text"
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "type": ["string", "boolean"]
        },
        "options": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "pinned": {
          "type": "boolean"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["draft", "local_tested", "submitted", "review_failed", "approved", "published", "deprecated", "revoked"]
        },
        "reviewRequired": {
          "type": "boolean"
        },
        "riskLevel": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "requiredScopes": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "testEvidence": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "runId": { "type": "string" },
            "dryRunId": { "type": "string" },
            "artifactHash": { "type": "string" },
            "verifiedAt": { "type": "string" }
          }
        },
        "submission": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "id": { "type": "string" },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "status": {
              "type": "string",
              "enum": ["submitted", "review_failed", "approved", "published", "deprecated", "revoked"]
            },
            "channel": {
              "type": "string",
              "enum": ["local", "hub"]
            },
            "submittedAt": { "type": "string" },
            "modifiedAt": { "type": "string" }
          }
        }
      }
    }
  }
}
