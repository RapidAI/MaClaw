{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maclaw.local/schemas/maclaw.apps.schema.json",
  "title": "MaClaw app extension manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["x_maclaw_apps", "apps"],
  "properties": {
    "x_maclaw_apps": {
      "description": "Private MaClaw marker. Skills without this marker are ignored by the app panel.",
      "type": "string",
      "const": "v1"
    },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/app" }
    }
  },
  "$defs": {
    "app": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "category": {
          "type": "string",
          "maxLength": 40,
          "default": "Skill"
        },
        "icon": {
          "description": "One of MaClaw's built-in app icon names.",
          "type": "string",
          "enum": ["receipt", "wallet", "invoice", "warehouse", "inventory", "customer", "users", "contract", "pdf", "shield", "sheet", "chart", "dashboard", "database", "eraser", "truck", "calendar", "web", "sync", "bot"]
        },
        "input_mode": {
          "type": "string",
          "enum": ["file", "form", "mixed"],
          "default": "file"
        },
        "multiple_files": {
          "type": "boolean",
          "default": false
        },
        "output_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["docx", "xlsx", "pdf", "json", "txt"]
          },
          "uniqueItems": true
        },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "governance": {
          "$ref": "#/$defs/governance"
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["text", "select", "boolean"],
          "default": "text"
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "type": ["string", "boolean"]
        },
        "options": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["draft", "local_tested", "submitted", "review_failed", "approved", "published", "deprecated", "revoked"]
        },
        "riskLevel": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "testEvidence": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "runId": { "type": "string" },
            "artifactHash": { "type": "string" },
            "verifiedAt": { "type": "string" }
          }
        }
      }
    }
  }
}
