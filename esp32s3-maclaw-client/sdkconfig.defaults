CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_ESP_TLS_USE_DS_PERIPHERAL=n
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_MN_CN_MULTINET7_QUANT=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# Public Hub TLS setup can legitimately occupy CPU1 for slightly over five
# seconds on this S3. Keep the watchdog enabled on both idle tasks, but give a
# bounded 10-second window so a successful certificate handshake does not emit
# a false watchdog alarm during normal boot/pairing.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
# Power management (optional): CONFIG_MACLAW_POWER_SAVE in menuconfig only
# switches the firmware code paths (esp_pm_configure + PM locks). To actually
# enable DFS 80-240 MHz and tickless idle, also set CONFIG_PM_ENABLE=y and
# CONFIG_FREERTOS_USE_TICKLESS_IDLE=y here or via idf.py menuconfig. They are
# left unset so the default build behaviour is unchanged, and the combination
# still needs on-device validation of audio/LCD timing.
